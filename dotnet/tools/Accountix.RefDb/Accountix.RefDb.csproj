<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Accountix.RefDb</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <!-- After the fixture loads, this build's migrations run on it (nothing to do while the fixture is at head). -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Accountix.Migrations\Accountix.Migrations.csproj" />
  </ItemGroup>

</Project>
