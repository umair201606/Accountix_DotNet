@{
    var access = Context.Access();
}
<!DOCTYPE html>
<html lang="en" data-ui="v2">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(ViewData["Title"] ?? "Accountix")</title>
    <partial name="_Antiforgery" />
    <script>(function(){try{var t=localStorage.getItem("ax-theme");if(t==="dark"||t==="light")document.documentElement.setAttribute("data-theme",t);}catch(e){}})();</script>
    <link rel="stylesheet" href="/static/css/app.css">
    <link rel="stylesheet" href="/static/css/ui.css">
    <style>
        .net-page { max-width: 960px; margin: 0 auto; padding: 24px 16px 48px; }
        .net-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 20px; }
        .net-top a { color: var(--link); text-decoration: none; font-weight: 600; }
        .net-card { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 16px; margin-bottom: 16px; }
        .net-card h2 { font-size: 15px; margin: 0 0 12px; }
        .net-kv { display: grid; grid-template-columns: max-content 1fr; gap: 6px 16px; font-size: 13.5px; }
        .net-kv dt { color: var(--muted); }
        .net-kv dd { margin: 0; overflow-wrap: anywhere; }
        .net-table-wrap { overflow-x: auto; }
        .net-table { width: 100%; border-collapse: collapse; font-size: 13px; }
        .net-table th, .net-table td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--line); white-space: nowrap; }
        .net-yes { color: var(--success, #15803d); font-weight: 600; }
        .net-no { color: var(--muted); }
        @@media (max-width: 480px) { .net-kv { grid-template-columns: 1fr; } .net-kv dt { margin-top: 6px; } }
    </style>
</head>
<body>
    <div class="net-page">
        <div class="net-top">
            <strong>@(access?.Company?.Name ?? "Accountix")</strong>
            <span>
                @if (access is not null) { <span>@access.User.DisplayName</span> <text>·</text> <a href="/portal/">My companies</a> }
            </span>
        </div>
        @RenderBody()
    </div>
</body>
</html>
