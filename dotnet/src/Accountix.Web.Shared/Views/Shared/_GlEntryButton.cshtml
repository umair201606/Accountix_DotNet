@model Accountix.Web.Infrastructure.GlEntryButton
@*
  Floating "Accounting entry" button + panel (templates/partials/gl_entry.html)
  for any document that posts to the general ledger; /static/js/gl_entry.js
  reads the journals from /accounting/gl-entry.
*@
<button type="button" class="gle-fab no-print" id="gleFab" data-type="@Model.Type" data-id="@(Model.Id?.ToString() ?? "")"
        @if (Model.IdFrom is not null) { <text>data-id-from="@Model.IdFrom"</text> } @if (Model.Also.Count > 0) { <text>data-also="@string.Join(",", Model.Also)"</text> } aria-haspopup="dialog" aria-controls="glePanel"
        title="See which ledgers this document debits and credits">
  <span class="gle-fab-ico" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16M4 12h16M4 19h16"/><path d="M12 5v14"/></svg>
  </span>
  <span class="gle-fab-txt">Accounting entry</span>
  <span class="gle-dot" aria-hidden="true"></span>
</button>
<div class="gle-overlay no-print" id="gleOverlay" hidden></div>
<aside class="gle-panel no-print" id="glePanel" role="dialog" aria-modal="true" aria-labelledby="gleTitle" hidden>
  <header class="gle-head">
    <div>
      <h2 class="gle-title" id="gleTitle">Accounting entry</h2>
      <p class="gle-sub" id="gleSub">Loading…</p>
    </div>
    <button type="button" class="gle-x" id="gleClose" aria-label="Close">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </header>
  <div class="gle-body" id="gleBody" aria-live="polite"></div>
</aside>
<link rel="stylesheet" href="/static/css/gl_entry.css">
<script src="/static/js/gl_entry.js" defer></script>
