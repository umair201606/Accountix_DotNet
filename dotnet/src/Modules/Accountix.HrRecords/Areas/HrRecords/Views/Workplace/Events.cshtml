@model WorkplaceController.EventsModel
@{
    ViewData["Title"] = "Events - Accountix ERP";
}
<div class="page-header">
    <h1>Team Calendar</h1>
    @if (Model.CanPost) {<button class="btn btn-primary" id="show-event-form">+ New Event</button>}
</div>
@if (Model.CanPost)
{
<div id="event-form" class="card hidden mb-20" style="max-width:500px;">
    <form method="POST" action="/workplace/events/create">
        <div class="form-group"><label>Title</label><input type="text" name="title" class="form-control" required></div>
        <div class="form-row">
            <div class="form-group"><label>Date</label><input type="date" name="event_date" class="form-control" required></div>
            <div class="form-group"><label>Type</label>
                <select name="event_type" class="form-control">
                    <option value="meeting">Meeting</option>
                    <option value="workshop">Workshop</option>
                    <option value="social">Social</option>
                    <option value="other">Other</option>
                </select>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group"><label>Start Time</label><input type="time" name="start_time" class="form-control"></div>
            <div class="form-group"><label>End Time</label><input type="time" name="end_time" class="form-control"></div>
        </div>
        <div class="form-group"><label>Location</label><input type="text" name="location" class="form-control"></div>
        <button type="submit" class="btn btn-primary">Create Event</button>
    </form>
</div>
}
<div class="card">
    <div class="table-wrap">
        <table>
            <thead><tr><th>Date</th><th>Title</th><th>Type</th><th>Time</th><th>Location</th><th>Created By</th></tr></thead>
            <tbody>
                @foreach (var e in Model.Events)
                {
                <tr>
                    <td>@Py.Date(e.EventDate)</td>
                    <td>@e.Title</td>
                    <td><span class="badge badge-info">@(e.EventType ?? "None")</span></td>
                    <td>@(e.StartTime is TimeOnly s ? Py.Hm(s) : "")@(e.EndTime is TimeOnly en ? " - " + Py.Hm(en) : "")</td>
                    <td>@(string.IsNullOrEmpty(e.Location) ? "-" : e.Location)</td>
                    <td>@e.Creator</td>
                </tr>
                }
                @if (Model.Events.Count == 0)
                {
                <tr><td colspan="6" class="text-center" style="color:var(--muted);">No events</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
@section Scripts {
<script>
document.getElementById('show-event-form')?.addEventListener('click', () => {
    document.getElementById('event-form').classList.toggle('hidden');
});
</script>
}
