@model IReadOnlyList<CommunicationsController.MyRow>
@{
    ViewData["Title"] = "Notifications - Accountix ERP";
}
<div class="page-header">
    <h1>My Notifications</h1>
</div>
<div class="card">
    <div class="card-header">Recent Notifications</div>
    @foreach (var r in Model)
    {
    <div class="notif-row" style="padding:10px;border-bottom:1px solid var(--border-soft);@(r.IsRead ? "" : "background:var(--accent-light);")">
        <div style="font-weight:600;">@r.Title</div>
        <div style="font-size:13px;color:var(--ink);">@r.Message</div>
        <div style="font-size:11px;color:var(--muted);">@Py.DMonYHm(r.CreatedAt)</div>
    </div>
    }
    @if (Model.Count == 0)
    {
    <p style="padding:20px;color:var(--muted);text-align:center;">No notifications</p>
    }
</div>
