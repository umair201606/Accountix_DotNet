@model PfEmployeeModel
@{
    ViewData["Title"] = "My Provident Fund - Accountix ERP";
    var config = Model.Config;
    string fmt = Context.Access()?.NumberFormat ?? "en";
    string Cut(string? s, int n) => s is null ? "" : s.Length > n ? s[..n] : s;
    var inv = CultureInfo.InvariantCulture;
}
<div class="page-header">
    <div>
        <h1>My Provident Fund</h1>
        <p class="subtitle">
            Current Balance: <strong style="color:var(--green);font-size:20px;">Rs. @Py.Amount(Model.Balance, 0, fmt)</strong>
        </p>
    </div>
</div>

@if (config is not null)
{
<div class="stats-grid mb-20">
    <div class="stat-card"><div class="stat-label">Employee Contribution</div><div class="stat-value">@(config.EmployeeContributionPct is null ? "None" : Py.Repr(Py.F(config.EmployeeContributionPct)))%</div></div>
    <div class="stat-card"><div class="stat-label">Employer Contribution</div><div class="stat-value">@(config.EmployerContributionPct is null ? "None" : Py.Repr(Py.F(config.EmployerContributionPct)))%</div></div>
</div>
}

<div class="card mb-20">
    <div class="card-header">Contribution History</div>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Period</th><th>Employee Amt</th><th>Employer Amt</th><th>Total</th></tr></thead>
            <tbody>
                @foreach (var c in Model.Contributions)
                {
                <tr>
                    <td>@c.Month/@c.Year</td>
                    <td>Rs. @Html.Amount(c.EmployeeAmount, 0)</td>
                    <td>Rs. @Html.Amount(c.EmployerAmount, 0)</td>
                    <td><strong>Rs. @Html.Amount(c.TotalAmount, 0)</strong></td>
                </tr>
                }
                @if (Model.Contributions.Count == 0)
                {
                <tr><td colspan="4" class="text-center" style="color:var(--muted);">No contributions yet</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card mb-20">
    <div class="card-header">Ledger Transactions</div>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Date</th><th>Type</th><th>Description</th><th>Credit</th><th>Debit</th></tr></thead>
            <tbody>
                @foreach (var e in Model.Ledger)
                {
                <tr>
                    <td>@e.TransactionDate.ToString("yyyy-MM-dd", inv)</td>
                    <td>@e.TransactionType</td>
                    <td>@(string.IsNullOrEmpty(Cut(e.Description, 40)) ? "-" : Cut(e.Description, 40))</td>
                    <td style="color:var(--green);">@if ((e.Credit ?? 0) > 0) {<text>Rs. @Html.Amount(e.Credit, 0)</text>}</td>
                    <td style="color:var(--red);">@if ((e.Debit ?? 0) > 0) {<text>Rs. @Html.Amount(e.Debit, 0)</text>}</td>
                </tr>
                }
                @if (Model.Ledger.Count == 0)
                {
                <tr><td colspan="5" class="text-center" style="color:var(--muted);">No transactions</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card mb-20">
    <div class="card-header">Request Withdrawal</div>
    <form method="POST" action="/pf/request-withdrawal" style="display:flex;gap:8px;flex-wrap:wrap;padding:12px;">
        <input type="number" name="amount" class="form-control" style="width:150px;" placeholder="Amount" required step="1000">
        <input type="text" name="reason" class="form-control" style="width:250px;" placeholder="Reason" required>
        <button type="submit" class="btn btn-primary">Submit</button>
    </form>
    <div class="table-wrap"><table>
        <thead><tr><th>Amount</th><th>Reason</th><th>Status</th><th>Date</th></tr></thead>
        <tbody>
            @foreach (var w in Model.Withdrawals)
            {
            <tr>
                <td>Rs. @Html.Amount(w.Amount, 0)</td>
                <td>@Cut(w.Reason, 40)</td>
                <td><span class="badge badge-@(w.Status == "approved" ? "success" : "warning")">@w.Status</span></td>
                <td>@w.CreatedAt?.ToString("dd-MMM-yyyy", inv)</td>
            </tr>
            }
        </tbody>
    </table></div>
</div>

<div class="card">
    <div class="card-header">Request Loan</div>
    <form method="POST" action="/pf/request-loan" style="display:flex;gap:8px;flex-wrap:wrap;padding:12px;">
        <input type="number" name="amount" class="form-control" style="width:150px;" placeholder="Amount" required step="1000">
        <input type="number" name="installments" class="form-control" style="width:100px;" placeholder="Months" value="12">
        <input type="text" name="purpose" class="form-control" style="width:250px;" placeholder="Purpose" required>
        <button type="submit" class="btn btn-accent">Submit Loan Request</button>
    </form>
    <div class="table-wrap"><table>
        <thead><tr><th>Amount</th><th>Installments</th><th>Monthly</th><th>Purpose</th><th>Status</th><th>Date</th></tr></thead>
        <tbody>
            @foreach (var l in Model.Loans)
            {
            <tr>
                <td>Rs. @Html.Amount(l.Amount, 0)</td>
                <td>@(l.InstallmentMonths?.ToString() ?? "None")</td>
                <td>Rs. @Html.Amount(l.MonthlyInstallment, 0)</td>
                <td>@Cut(l.Purpose, 30)</td>
                <td><span class="badge badge-@(l.Status == "approved" ? "success" : "warning")">@l.Status</span></td>
                <td>@l.CreatedAt?.ToString("dd-MMM-yyyy", inv)</td>
            </tr>
            }
        </tbody>
    </table></div>
</div>
