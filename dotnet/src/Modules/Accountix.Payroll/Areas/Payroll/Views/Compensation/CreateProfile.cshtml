@model CreateProfileModel
@{
    ViewData["Title"] = "Create Payroll Profile - Accountix ERP";
}
<div class="page-header">
    <h1>Create Payroll Profile</h1>
</div>
<form method="POST">
    <div class="card mb-20">
        <div class="card-header">Employee & Basic Salary</div>
        <div class="form-row" style="padding:12px;">
            <div class="form-group">
                <label>Employee</label>
                <select name="user_id" class="form-control" required>
                    <option value="">Select Employee</option>
                    @foreach (var e in Model.Employees)
                    {
                    <option value="@e.Id">@e.FullName (@e.Email)</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Basic Salary (Rs.)</label>
                <input type="number" name="basic_salary" class="form-control" required min="1" step="1">
            </div>
            <div class="form-group">
                <label>Effective From</label>
                <input type="date" name="effective_from" class="form-control" required>
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Create Profile</button>
    <a href="/compensation/" class="btn btn-secondary">Cancel</a>
</form>
