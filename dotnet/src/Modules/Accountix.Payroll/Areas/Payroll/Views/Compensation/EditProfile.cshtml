@model EditProfileModel
@{
    ViewData["Title"] = "Edit Salary Package - Accountix ERP";
    var profile = Model.Profile;
}
<div class="page-header">
    <h1>Salary Package: @Model.Employee.FullName</h1>
</div>
<form method="POST" id="salary-form">
    <div class="card mb-20">
        <div class="card-header">Basic Information</div>
        <div class="form-row" style="padding:12px;">
            <div class="form-group"><label>Basic Salary (Rs.)</label><input type="number" name="basic_salary" class="form-control" required min="1" step="1" value="@(profile is null ? "" : Py.Repr(Py.F(profile.BasicSalary)))"></div>
            <div class="form-group"><label>Effective From</label><input type="date" name="effective_from" class="form-control" required value="@(profile?.EffectiveFrom.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "")"></div>
        </div>
    </div>
    <div class="card mb-20">
        <div class="card-header flex-between">
            <span>Components</span>
            <button type="button" class="btn btn-sm btn-primary" id="add-component">+ Add</button>
        </div>
        <div class="table-wrap">
            <table id="components-table">
                <thead><tr><th>Name</th><th>Type</th><th>Basis</th><th>Amount</th><th>Taxable</th><th></th></tr></thead>
                <tbody id="components-body">
                    @foreach (var c in Model.Components)
                    {
                    string method = string.IsNullOrEmpty(c.CalculationMethod) ? "fixed" : c.CalculationMethod;
                    <tr>
                        <td><input name="comp_name" class="form-control" value="@c.Name" style="width:150px;"></td>
                        <td>
                            <select name="comp_type" class="form-control" style="width:120px;">
                                <option value="allowance" selected="@(c.Type == "allowance")">Allowance</option>
                                <option value="deduction" selected="@(c.Type == "deduction")">Deduction</option>
                            </select>
                        </td>
                        <td>
                            <select name="comp_method" class="form-control" style="width:130px;">
                                <option value="fixed" selected="@(method == "fixed")">Fixed (Rs.)</option>
                                <option value="percent_of_basic" selected="@(c.CalculationMethod is "percent_of_basic" or "percentage")">% of basic</option>
                            </select>
                        </td>
                        <td><input name="comp_value" type="number" step="0.01" min="0" class="form-control" value="@(c.Value is null ? "None" : Py.Repr(Py.F(c.Value)))" style="width:120px;"></td>
                        <td><input name="comp_taxable" type="checkbox" value="1" checked="@(c.IsTaxable == true)"></td>
                        <td><button type="button" class="btn btn-sm btn-danger" onclick="this.closest('tr').remove()">X</button></td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <p class="text-muted" style="font-size:.85rem;">Gross pay is basic + allowances. Untick "Taxable" for an exempt allowance (e.g. medical within the exemption). A percentage follows basic when it is revised. Deductions are fixed monthly amounts (EOBI, welfare fund); income tax, PF and loan instalments are added by the run.</p>
    <input type="hidden" name="components_json" id="components-json">
    <button type="submit" class="btn btn-primary">Save Package</button>
    <a href="/compensation/" class="btn btn-secondary">Cancel</a>
</form>
@section Scripts {
<script>
document.getElementById('add-component')?.addEventListener('click', () => {
    const tbody = document.getElementById('components-body');
    const tr = document.createElement('tr');
    tr.innerHTML = `
        <td><input name="comp_name" class="form-control" style="width:150px;"></td>
        <td><select name="comp_type" class="form-control" style="width:120px;"><option value="allowance">Allowance</option><option value="deduction">Deduction</option></select></td>
        <td><select name="comp_method" class="form-control" style="width:130px;"><option value="fixed">Fixed (Rs.)</option><option value="percent_of_basic">% of basic</option></select></td>
        <td><input name="comp_value" type="number" step="0.01" min="0" class="form-control" style="width:120px;"></td>
        <td><input name="comp_taxable" type="checkbox" value="1" checked></td>
        <td><button type="button" class="btn btn-sm btn-danger" onclick="this.closest('tr').remove()">X</button></td>`;
    tbody.appendChild(tr);
});
document.getElementById('salary-form')?.addEventListener('submit', () => {
    const rows = [...document.querySelectorAll('#components-body tr')];
    const comps = rows.map(r => ({
        name: r.querySelector('[name="comp_name"]').value,
        type: r.querySelector('[name="comp_type"]').value,
        method: r.querySelector('[name="comp_method"]').value,
        value: parseFloat(r.querySelector('[name="comp_value"]').value) || 0,
        is_taxable: r.querySelector('[name="comp_taxable"]').checked,
    })).filter(c => c.name);
    document.getElementById('components-json').value = JSON.stringify(comps);
});
</script>
}
