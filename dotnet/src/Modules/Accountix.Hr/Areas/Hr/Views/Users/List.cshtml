@model Accountix.Hr.Controllers.UsersController.ListModel
@{
    ViewData["Title"] = "User Management - Accountix ERP";
    var access = Context.Access()!;
    string Js(string s) => System.Text.Json.JsonSerializer.Serialize(s);
}
<div class="page-header">
    <h1>User Management</h1>
    <a href="/auth/members/assign" class="btn btn-primary">Assign Member</a>
</div>
<div class="card">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Department</th>
                    <th>Status</th>
                    <th style="width:200px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Users)
                {
                    var u = row.User;
                    bool active = u.IsActive == true;
                    bool uAdmin = u.IsSuperAdmin == true || row.RoleName == Role.Admin;
                    bool uManager = u.IsSuperAdmin == true || row.RoleName == Role.Manager;
                    bool shared = Model.SharedLogins.Contains(u.Id);
                <tr class="@(active ? "" : "inactive-row")">
                    <td>@u.EmployeeCode</td>
                    <td><strong>@u.FullName</strong></td>
                    <td>@u.Email</td>
                    <td><span class="badge badge-@(uAdmin ? "danger" : uManager ? "warning" : "info")">@Py.Title(row.RoleName)</span></td>
                    <td>@(Py.Text(row.Membership.Department) is { Length: > 0 } dep ? dep : "-")</td>
                    <td>
                        @if (active)
                        {
                        <span class="badge badge-success">Active</span>
                        }
                        else
                        {
                        <span class="badge badge-default">Inactive</span>
                        }
                        @if (shared)
                        {
                        <div style="font-size:11px;color:var(--muted);margin-top:2px;" title="This login is also used elsewhere, so only its owner can change its password or turn it off.">Own login</div>
                        }
                    </td>
                    <td>
                        <div style="display:flex;gap:4px;flex-wrap:wrap;">
                            <a href="/auth/users/@u.Id/edit" class="btn btn-sm btn-outline">Edit</a>
                            <a href="/auth/users/@u.Id/hr-rights" class="btn btn-sm btn-outline">HR Rights</a>
                            @if (access.IsAdmin && !shared)
                            {
                            <button class="btn btn-sm btn-outline" onclick="resetPw(@u.Id, @Js(u.FullName))">Reset PW</button>
                            }
                            @if (active && !uAdmin && u.Id != access.User.Id && !shared)
                            {
                            <form method="POST" action="/auth/users/@u.Id/delete" style="display:inline;" onsubmit="return confirm('Deactivate ' + @Js(u.FullName) + '?')">
                                <button class="btn btn-sm btn-danger">Deactivate</button>
                            </form>
                            }
                        </div>
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal-overlay hidden" id="pw-modal">
    <div class="modal-content" style="max-width:380px;">
        <div class="modal-header">
            <h3>Reset Password</h3>
            <button class="modal-close" onclick="document.getElementById('pw-modal').classList.add('hidden')">&times;</button>
        </div>
        <form method="POST" id="pw-form">
            <p style="font-size:13px;color:var(--muted);margin-bottom:12px;">New password for <strong id="pw-user-name"></strong></p>
            <div class="form-group">
                <input type="password" name="new_password" class="form-control" placeholder="New password" required minlength="8">
            </div>
            <button type="submit" class="btn btn-primary btn-block">Set Password</button>
        </form>
    </div>
</div>
@section Scripts {
<script>
function resetPw(uid, name) {
    document.getElementById('pw-user-name').textContent = name;
    document.getElementById('pw-form').action = '/auth/users/' + uid + '/reset-password';
    document.getElementById('pw-modal').classList.remove('hidden');
}
document.getElementById('pw-modal')?.addEventListener('click', function(e) {
    if (e.target === this) this.classList.add('hidden');
});
</script>
}
