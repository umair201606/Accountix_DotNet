@model Accountix.Hr.Controllers.AccountController.ProfileModel
@{
    ViewData["Title"] = "Profile - Accountix ERP";
    var user = Model.User;
    string des = Py.Text(Model.Designation), dep = Py.Text(Model.Department);
    bool both = des.Length > 0 && dep.Length > 0;
}
<div class="page-header">
    <h1>My Profile</h1>
</div>
<div class="card" style="max-width:700px;">
    <div style="display:flex;align-items:center;gap:20px;margin-bottom:20px;">
        <div class="profile-pic-preview" style="width:100px;height:100px;">
            @if (!string.IsNullOrEmpty(user.ProfileImage))
            {
            <img src="/ess/avatar/@Uri.EscapeDataString(user.ProfileImage)" alt="@user.FullName">
            }
            else
            {
            <div class="profile-pic-initial" style="font-size:36px;">@Py.Cut(user.FullName, 1)</div>
            }
        </div>
        <div>
            <h2 style="font-size:20px;font-weight:700;">@user.FullName</h2>
            <p style="color:var(--muted);">@des@if (both) {<text> &middot; </text>}@dep</p>
        </div>
    </div>
    @* A long email cannot break: the table scrolls in its own box on a 320px phone instead of the page. *@
    <div class="table-wrap" style="overflow-x:auto;">
    <table>
        <tr><td style="font-weight:600;width:150px;">Employee Code</td><td>@user.EmployeeCode</td></tr>
        <tr><td style="font-weight:600;">User ID</td><td>@(string.IsNullOrEmpty(user.LoginId) ? user.Email : user.LoginId)</td></tr>
        <tr><td style="font-weight:600;">Email</td><td>@user.Email</td></tr>
        <tr><td style="font-weight:600;">Phone</td><td>@(Py.Text(user.Phone) is { Length: > 0 } ph ? ph : "-")</td></tr>
        <tr><td style="font-weight:600;">CNIC</td><td>@(string.IsNullOrEmpty(user.Cnic) ? "-" : user.Cnic)</td></tr>
        <tr><td style="font-weight:600;">Date of Joining</td><td>@Py.Date(user.DateOfJoining)</td></tr>
        <tr><td style="font-weight:600;">Bank Name</td><td>@(string.IsNullOrEmpty(user.BankName) ? "-" : user.BankName)</td></tr>
        <tr><td style="font-weight:600;">Account Title</td><td>@(string.IsNullOrEmpty(user.BankAccountTitle) ? "-" : user.BankAccountTitle)</td></tr>
        <tr><td style="font-weight:600;">Account Number</td><td>@(string.IsNullOrEmpty(user.BankAccountNumber) ? "-" : user.BankAccountNumber)</td></tr>
    </table>
    </div>
    <a href="/ess/" class="btn btn-primary mt-10">Edit Profile</a>
</div>

<div class="card" style="max-width:700px;margin-top:20px;">
    <h3 style="font-size:15px;font-weight:700;margin-bottom:4px;">Account Settings</h3>
    <p style="color:var(--muted);font-size:12.5px;margin-bottom:16px;">
        Your <strong>User ID</strong> is what you type to sign in — it is separate from your email,
        but you may set both to the same value.
    </p>
    <form method="post" action="/auth/account-settings">
        <div class="form-row" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
            <div class="form-group">
                <label style="font-weight:600;font-size:13px;">User ID</label>
                <input type="text" name="login_id" class="form-control" required value="@(string.IsNullOrEmpty(user.LoginId) ? user.Email : user.LoginId)">
            </div>
            <div class="form-group">
                <label style="font-weight:600;font-size:13px;">Email</label>
                <input type="email" name="email" class="form-control" required value="@user.Email">
            </div>
        </div>
        <div class="form-group" style="margin-top:12px;max-width:360px;">
            <label style="font-weight:600;font-size:13px;">Current password <span style="font-weight:400;color:var(--muted);">(needed to change your User ID or email)</span></label>
            <input type="password" name="current_password" class="form-control" autocomplete="current-password">
        </div>
        <div style="display:flex;gap:10px;align-items:center;margin-top:14px;">
            <button type="submit" class="btn btn-primary">Save Account Settings</button>
            <a href="/auth/change-password" class="btn btn-outline">Change Password</a>
        </div>
    </form>
</div>
