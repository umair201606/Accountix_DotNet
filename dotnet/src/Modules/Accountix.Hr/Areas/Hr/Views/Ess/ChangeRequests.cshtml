@model List<Accountix.Hr.Controllers.EssController.ChangeRow>
@{
    ViewData["Title"] = "Change Requests - Accountix ERP";
}
<div class="page-header">
    <h1>Pending Change Requests</h1>
</div>
<div class="card">
    <div class="table-wrap">
        <table>
            <thead><tr><th>Employee</th><th>Field</th><th>Old</th><th>New</th><th>Action</th></tr></thead>
            <tbody>
                @foreach (var row in Model)
                {
                var cr = row.Request;
                <tr>
                    <td>@row.Employee</td>
                    <td>@cr.FieldName</td>
                    <td>@(string.IsNullOrEmpty(cr.OldValue) ? "-" : Py.Cut(cr.OldValue, 30))</td>
                    <td>@Py.Cut(cr.NewValue, 30)</td>
                    <td>
                        <form method="POST" action="/ess/review-change/@cr.Id" style="display:flex;gap:4px;flex-wrap:wrap;">
                            <input type="hidden" name="action" value="approve">
                            <button class="btn btn-sm btn-accent">Approve</button>
                        </form>
                        <form method="POST" action="/ess/review-change/@cr.Id" style="display:flex;gap:4px;flex-wrap:wrap;margin-top:4px;">
                            <input type="hidden" name="action" value="reject">
                            <input type="text" name="notes" placeholder="Notes" class="form-control" style="width:100px;font-size:11px;">
                            <button class="btn btn-sm btn-danger">Reject</button>
                        </form>
                    </td>
                </tr>
                }
                @if (Model.Count == 0)
                {
                <tr><td colspan="5" class="text-center" style="color:var(--muted);">No pending requests</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
