@model List<TimePolicy>
@{
    ViewData["Title"] = "Time Policies - Accountix ERP";
}
<div class="page-header">
    <h1>Time Policies</h1>
    <button class="btn btn-primary" id="show-form">+ New Policy</button>
</div>
<div id="policy-form" class="card hidden mb-20" style="max-width:500px;">
    <form method="POST">
        <div class="form-group"><label>Policy Name *</label><input name="name" class="form-control" required></div>
        <div class="form-group"><label>Department</label><input name="department" class="form-control" placeholder="Leave blank for all"></div>
        <div class="form-row">
            <div class="form-group"><label>Shift Start *</label><input type="time" name="shift_start" class="form-control" value="09:00" required></div>
            <div class="form-group"><label>Shift End *</label><input type="time" name="shift_end" class="form-control" value="18:00" required></div>
        </div>
        <div class="form-row">
            <div class="form-group"><label>Grace (min)</label><input type="number" name="grace" class="form-control" value="15"></div>
            <div class="form-group"><label>Max Regular (h)</label><input type="number" name="max_reg" class="form-control" value="8" step="0.5"></div>
        </div>
        <div class="form-row">
            <div class="form-group"><label>Max OT (h)</label><input type="number" name="max_ot" class="form-control" value="4" step="0.5"></div>
            <div class="form-group"><label>Max Days</label><input type="number" name="max_days" class="form-control" value="6"></div>
        </div>
        <div class="form-group"><label><input type="checkbox" name="require_break" checked> Require Break</label></div>
        <div class="form-group"><label>Min Break (min)</label><input type="number" name="min_break" class="form-control" value="30"></div>
        <button type="submit" class="btn btn-primary">Create Policy</button>
    </form>
</div>
<div class="card">
    <div class="card-header">Configured Policies</div>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Name</th><th>Department</th><th>Shift</th><th>Grace</th><th>Max Reg/OT</th><th>Break</th></tr></thead>
            <tbody>
                @foreach (var p in Model)
                {
                <tr>
                    <td>@p.Name</td>
                    <td>@(string.IsNullOrEmpty(p.Department) ? "All" : p.Department)</td>
                    <td>@Py.Hm(p.ShiftStart) - @Py.Hm(p.ShiftEnd)</td>
                    <td>@Py.Str(p.GracePeriodMinutes)min</td>
                    <td>@Py.Float(p.MaxRegularHours)/@(Py.Float(p.MaxOvertimeHours))h</td>
                    <td>@Py.Str(p.MinBreakMinutes)min@(p.RequireBreak == true ? " (req)" : "")</td>
                </tr>
                }
                @if (Model.Count == 0)
                {
                <tr><td colspan="6" class="text-center" style="color:var(--muted);">No policies</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
@section Scripts {
<script>document.getElementById('show-form')?.addEventListener('click',()=>{document.getElementById('policy-form').classList.toggle('hidden');});</script>
}
