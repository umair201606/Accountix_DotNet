@model List<Accountix.Hr.Services.Member>
@{
    ViewData["Title"] = "My Team - Accountix ERP";
}
<div class="page-header">
    <h1>My Team</h1>
</div>
<div class="card">
    <div class="table-wrap">
        <table>
            <thead><tr><th>Name</th><th>Designation</th><th>Department</th><th>Email</th><th>Phone</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var m in Model)
                {
                <tr>
                    <td>@m.FullName</td>
                    <td>@(Py.Text(m.Designation) is { Length: > 0 } des ? des : "-")</td>
                    <td>@(Py.Text(m.Department) is { Length: > 0 } dep ? dep : "-")</td>
                    <td>@m.User.Email</td>
                    <td>@(Py.Text(m.User.Phone) is { Length: > 0 } ph ? ph : "-")</td>
                    <td>
                        <a href="/mss/evaluate/@m.Id" class="btn btn-sm btn-outline">Evaluate</a>
                    </td>
                </tr>
                }
                @if (Model.Count == 0)
                {
                <tr><td colspan="6" class="text-center" style="color:var(--muted);">No team members</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
