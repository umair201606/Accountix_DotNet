@model Accountix.Parties.Controllers.PartyListModel
@{
    var k = Model.Kind;
    ViewData["Title"] = k.TitlePlural;
    string fmt = Context.Access()?.NumberFormat ?? Money.Western;
}
<div class="page-header">
  <div style="display:flex;gap:8px;flex-wrap:wrap;">
    <a href="@k.Prefix/create" class="btn btn-primary">+ New @k.Title</a>
    <a href="@k.Prefix/template" class="btn btn-outline btn-sm">Download Template</a>
    <form method="POST" action="@k.Prefix/upload-excel" enctype="multipart/form-data" style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;max-width:100%;">
      <input type="file" name="file" accept=".xlsx" required class="form-control" style="width:auto;padding:4px 8px;font-size:12px;">
      <button type="submit" class="btn btn-outline btn-sm">Import Excel</button>
    </form>
  </div>
</div>
<div class="card">
  <div class="card-body" style="padding-bottom:8px;">
    <form method="GET" class="search-form">
      <input type="text" name="q" class="form-control focus-ring" placeholder="Search by name or city..." value="@Model.Q">
      <button type="submit" class="btn btn-outline">Search</button>
    </form>
  </div>
  <div class="table-responsive">
    <table class="table">
      @if (k.CreditLimit)
      {
      <thead><tr><th>Name</th><th>Phone</th><th>Email</th><th>City</th><th>Credit Limit</th><th>Orders</th><th>Status</th><th>Actions</th></tr></thead>
      }
      else
      {
      <thead><tr><th>Name</th><th>Contact</th><th>Phone</th><th>Email</th><th>City</th><th>Orders</th><th>Status</th><th>Actions</th></tr></thead>
      }
      <tbody>
        @foreach (var c in Model.Rows)
        {
        <tr class="@(c.IsActive ? "" : "inactive-row")">
          <td><strong>@c.Name</strong></td>
          @if (!k.CreditLimit)
          {
          <td>@(string.IsNullOrEmpty(c.ContactPerson) ? "-" : c.ContactPerson)</td>
          }
          <td>@(string.IsNullOrEmpty(c.Phone) ? "-" : c.Phone)</td>
          <td>@(string.IsNullOrEmpty(c.Email) ? "-" : c.Email)</td>
          <td>@(string.IsNullOrEmpty(c.City) ? "-" : c.City)</td>
          @if (k.CreditLimit)
          {
          <td>@Money.Format(c.CreditLimit, 0, fmt)</td>
          }
          <td>@c.Orders</td>
          <td><span class="badge @(c.IsActive ? "badge-success" : "badge-secondary")">@(c.IsActive ? "Active" : "Inactive")</span></td>
          <td class="actions">
            <a href="@k.Prefix/edit/@c.Id" class="btn btn-sm btn-outline">Edit</a>
            <form method="POST" action="@k.Prefix/delete/@c.Id" style="display:inline" onsubmit="return confirm('Delete?')">
              <button type="submit" class="btn btn-sm btn-danger">Delete</button>
            </form>
          </td>
        </tr>
        }
        @if (Model.Rows.Count == 0)
        {
        <tr><td colspan="8" class="empty">No @k.Plural</td></tr>
        }
      </tbody>
    </table>
  </div>
</div>
