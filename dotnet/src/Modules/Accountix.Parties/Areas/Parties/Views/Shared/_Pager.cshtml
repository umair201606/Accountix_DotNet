@model Accountix.Parties.Controllers.Pager
@* Page links for the Tracking lists (tracking/_pager.html). Every filter in the query string is kept; only ?page=
   changes. Nothing renders for a single page. *@
@if (Model.Pages > 1)
{
    string Link(int page)
    {
        var parts = new List<string>();
        bool placed = false;
        foreach (var kv in Context.Request.Query)
        {
            if (kv.Key == "page")
            {
                parts.Add("page=" + page);
                placed = true;
                continue;
            }
            foreach (var v in kv.Value)
                parts.Add(Accountix.Parties.Controllers.QueryText.Encode(kv.Key) + "=" + Accountix.Parties.Controllers.QueryText.Encode(v ?? ""));
        }
        if (!placed) parts.Add("page=" + page);
        return Context.Request.Path + "?" + string.Join("&", parts);
    }
<nav class="trk-pager" aria-label="Pages">
  <span>@Model.First–@Model.Last of @Model.Total</span>
  <span class="trk-pager-links">
    <a class="trk-rowbtn @(Model.Page <= 1 ? "is-off" : "")" rel="prev"
       href="@Link(Model.Page - 1)">&larr; Previous</a>
    <span style="align-self:center;">Page @Model.Page of @Model.Pages</span>
    <a class="trk-rowbtn @(Model.Page >= Model.Pages ? "is-off" : "")" rel="next"
       href="@Link(Model.Page + 1)">Next &rarr;</a>
  </span>
</nav>
}
