@model Accountix.Parties.Controllers.AssignPageModel
@{
    var m = Model;
    var r = m.Row;
    ViewData["Title"] = "Assign " + r.VoucherNumber;
    ViewData["Heading"] = $"Assign {(r.Flow == "receipt" ? "receipt" : "payment")} · {r.VoucherNumber}";
    string docWord = r.DocType == "SI" ? "sales" : "purchase";
    decimal capacity = r.Amount - r.Forced;
    string F2(decimal v) => v.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
    string partyWord = m.DocMeta.PartyLabel.ToLowerInvariant();
}
@section Head {
<partial name="_TrackingStyle" />
}
<div class="trk @(m.CanAssign && m.Invoices.Count > 0 ? "trk-has-mobile-save" : "")">

  <header class="trk-pagehead">
    <a href="/invoicing/tracking/" class="trk-back">&larr; Payment feed</a>
    <p class="trk-idline">
      <b>@Html.Amount(r.Amount, 2)</b>
      @(r.Flow == "receipt" ? "from" : "to")
      <strong>@r.PartyName</strong>
      <span class="sep">·</span>
      <span class="trk-vtype">@r.VoucherType</span>
      <a href="/accounting/vouchers/@r.VoucherId" class="trk-vno">@r.VoucherNumber</a>
      <span class="sep">·</span> @r.DateStr@if (r.CashAccount.Length > 0) {<text> <span class="sep">·</span> @r.CashAccount</text>}
    </p>
  </header>

  <div class="trk-err" id="trkErr" role="alert" style="margin:0 0 16px;"></div>

  <div class="trk-split">
    <div>
      <section class="trk-card">
        <div class="trk-card-head">
          <div class="trk-card-title"><span class="trk-dot"></span><span>Open @docWord invoices for @r.PartyName</span></div>
          <span class="trk-card-hint">Oldest first &middot; tick an invoice and set how much of this @r.Flow it settles</span>
        </div>
        @if (r.IsLedger)
        {
        <div class="trk-empty">
          <strong>@r.PartyName is a whole ledger, not a @partyWord</strong>
          <p>Money booked straight to this account has no invoices behind it to
            settle. Close it with a reason on the right — an advance, a
            settlement of an opening balance — so it leaves the queue.</p>
        </div>
        }
        else if (m.Invoices.Count > 0)
        {
        <div class="trk-table-wrap">
          <table class="trk-alloc-table" id="allocTable">
            <thead>
              <tr>
                <th style="width:40px;">
                  <input type="checkbox" id="pickAll" aria-label="Select every invoice">
                </th>
                <th>Invoice</th>
                <th>Issued</th>
                <th>Due / age</th>
                <th style="text-align:right;">Total</th>
                <th style="text-align:right;">Outstanding</th>
                <th style="text-align:right;">Assign now</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var inv in m.Invoices)
              {
              decimal here = inv.AssignedHere ?? 0m;
              <tr class="@(here > 0 ? "picked" : "")">
                <td data-label="Pick">
                  <input type="checkbox" class="trk-pick" checked="@(here > 0)"
                         aria-label="Assign to @inv.Number">
                </td>
                <td data-label="Invoice">
                  <a href="/invoicing/tracking/invoice/@inv.DocType/@inv.Id"
                     class="trk-doclink">@inv.Number</a>
                  <div style="color:var(--muted);font-size:11px;margin-top:2px;">
                    settled @Html.Amount(inv.Settled, 2) of @Html.Amount(inv.Total, 2)@if (inv.Credited != 0) {<text> · returned @Html.Amount(inv.Credited, 2)</text>}
                  </div>
                </td>
                <td data-label="Issued" class="trk-nowrap">@(inv.DateStr.Length > 0 ? inv.DateStr : "—")</td>
                <td data-label="Due / age">
                  @if (inv.OverdueDays > 0)
                  {
                  <span class="trk-age @(inv.OverdueDays > 30 ? "hot" : "warm")">@inv.OverdueDays days late</span>
                  }
                  else
                  {
                  <span class="trk-age">@(inv.DueStr.Length > 0 ? inv.DueStr : "Not due")</span>
                  }
                </td>
                <td data-label="Total" style="text-align:right;font-variant-numeric:tabular-nums;">@Html.Amount(inv.Total, 2)</td>
                <td data-label="Outstanding" style="text-align:right;font-variant-numeric:tabular-nums;font-weight:800;">@Html.Amount(inv.Outstanding, 2)</td>
                <td data-label="Assign now">
                  <input type="number" step="0.01" min="0" class="trk-amt" data-doc="@inv.Id"
                         data-max="@F2(inv.Assignable ?? 0m)"
                         value="@(here > 0 ? F2(here) : "")"
                         aria-label="Amount to assign to @inv.Number">
                </td>
              </tr>
              }
            </tbody>
          </table>
        </div>
        }
        else
        {
        <div class="trk-empty">
          <span class="trk-empty-icon">&#128203;</span>
          <strong>No open @docWord invoice for @r.PartyName</strong>
          <p>Every approved invoice for this @partyWord is fully settled, so
            this @r.Flow has nothing to attach to. It stays in the ledger as an
            advance until an invoice exists for it.</p>
          <a href="@(r.DocType == "SI" ? "/inventory/invoices/" : "/inventory/purchase-invoice/")"
             class="btn btn-primary">Create a @docWord invoice</a>
        </div>
        }
      </section>

      @if (m.Splits.Count > 0)
      {
      <section class="trk-card">
        <div class="trk-card-head">
          <div class="trk-card-title"><span class="trk-dot"></span><span>Already assigned from this @r.Flow</span></div>
          <span class="trk-card-hint">@m.Splits.Count @(m.Splits.Count == 1 ? "invoice" : "invoices")</span>
        </div>
        <div class="trk-table-wrap">
          <table class="trk-table">
            <thead><tr><th>Invoice</th><th class="num">Invoice total</th><th class="num">Assigned</th><th>By</th><th>Action</th></tr></thead>
            <tbody>
              @foreach (var sp in m.Splits)
              {
              <tr>
                <td data-label="Invoice">
                  @if (sp.Forced)
                  {
                  <span class="trk-state trk-state-forced">No invoice</span>
                  @if (sp.Note.Length > 0) {<div class="trk-meta">@sp.Note</div>}
                  }
                  else
                  {
                  <a href="/invoicing/tracking/invoice/@sp.DocType/@sp.DocId"
                     class="trk-doclink">@sp.Number</a>
                  }
                </td>
                <td data-label="Invoice total" class="num">@(sp.Forced ? "—" : Html.Amount(sp.Total, 2))</td>
                <td data-label="Assigned" class="num strong">@Html.Amount(sp.Amount, 2)</td>
                <td data-label="By">@(sp.By.Length > 0 ? sp.By : "—")</td>
                <td data-label="Action">
                  @if (m.CanAssign)
                  {
                  <button type="button" class="trk-rowbtn danger trk-unassign" data-id="@sp.Id">Detach</button>
                  }
                </td>
              </tr>
              }
            </tbody>
          </table>
        </div>
      </section>
      }
    </div>

    <aside class="trk-side">
      <div class="trk-card" style="margin:0;">
        <div class="trk-card-head">
          <div class="trk-card-title"><span class="trk-dot"></span><span>This @r.Flow</span></div>
        </div>
        <div class="trk-card-body">
          <div class="trk-sum">
            <div class="trk-sum-row"><span>Amount @(r.Flow == "receipt" ? "received" : "paid")</span><b>@Html.Amount(r.Amount, 2)</b></div>
            <div class="trk-sum-row"><span>On invoices</span><b>@Html.Amount(r.ToInvoices, 2)</b></div>
            @if (r.Forced != 0)
            {
            <div class="trk-sum-row" title="@r.ForcedReason"><span>Closed without an invoice</span><b>@Html.Amount(r.Forced, 2)</b></div>
            }
            <div class="trk-sum-row total"><span>Unassigned</span><b>@Html.Amount(r.Unassigned, 2)</b></div>
          </div>
          @if (m.Invoices.Count > 0)
          {
          <div class="trk-remaining" id="trkRemaining" style="margin-top:14px;">
            <div class="lbl">Left after this split</div>
            <div class="val" id="trkRemainingVal">@F2(capacity)</div>
          </div>
          }
          @if (m.CanAssign && m.Invoices.Count > 0)
          {
          <div class="trk-savebar" style="margin-top:13px;">
            <button type="button" class="btn btn-primary" id="trkSave">Save assignment</button>
          </div>
          <div class="trk-savebar" style="margin-top:8px;">
            <button type="button" class="btn btn-outline" id="trkAuto">Auto-assign oldest first</button>
          </div>
          }
          @if (m.CanAssign && r.Forced != 0)
          {
          <div class="trk-savebar" style="margin-top:8px;">
            <button type="button" class="btn btn-outline" id="trkReopen"
                    title="@r.ForcedReason">Reopen the closed @Html.Amount(r.Forced, 2)</button>
          </div>
          }
          @if (m.CanAssign && r.Unassigned > 0)
          {
          <details class="trk-forcebox" style="margin-top:13px;" open="@(r.IsLedger || m.Invoices.Count == 0)">
            <summary style="cursor:pointer;font-size:12.5px;font-weight:600;">Close without an invoice</summary>
            <div class="trk-field" style="margin-top:10px;">
              <label class="trk-lbl" for="trkForceAmt">Amount</label>
              <input type="number" step="0.01" min="0.01" max="@F2(r.Unassigned)"
                     id="trkForceAmt" class="trk-input" value="@F2(r.Unassigned)">
            </div>
            <div class="trk-field" style="margin-top:8px;">
              <label class="trk-lbl" for="trkForceReason">Reason (required)</label>
              <input type="text" id="trkForceReason" class="trk-input" maxlength="300"
                     placeholder="e.g. advance against future orders">
            </div>
            <div class="trk-savebar" style="margin-top:10px;">
              <button type="button" class="btn btn-outline" id="trkForceSave">Close as not applicable</button>
            </div>
          </details>
          }
          <p style="margin:13px 0 0;color:var(--muted);font-size:11.5px;line-height:1.5;">
            Assigning records which invoices this money settles. It posts no journal
            entry and changes no ledger or chart-of-accounts balance — the voucher
            already did that when it was approved.
          </p>
        </div>
      </div>
    </aside>
  </div>
  @if (m.CanAssign && m.Invoices.Count > 0)
  {
  <div class="trk-mobile-save" id="trkMobileSave">
    <div><div class="lbl">Left after this split</div><div class="val" id="trkMobileLeft">@F2(capacity)</div></div>
    <button type="button" class="btn btn-primary" id="trkMobileSaveBtn">Save assignment</button>
  </div>
  }
</div>

@section Scripts {
<script>
(function () {
  var table = document.getElementById('allocTable');
  var err = document.getElementById('trkErr');
  var remainBox = document.getElementById('trkRemaining');
  var remainVal = document.getElementById('trkRemainingVal');
  var saveBtn = document.getElementById('trkSave');
  var autoBtn = document.getElementById('trkAuto');
  var pickAll = document.getElementById('pickAll');
  var capacity = @F2(r.Amount - r.Forced);   // the money less any part closed without an invoice
  var mobileBar = document.getElementById('trkMobileSave');
  var mobileLeft = document.getElementById('trkMobileLeft');
  var mobileSave = document.getElementById('trkMobileSaveBtn');
  var fmt = window.formatAmount || function (v) { return (+v || 0).toFixed(2); };

  function showError(msg) {
    if (!err) return;
    err.textContent = msg || '';
    err.classList.toggle('show', !!msg);
  }

  function recalc() {
    if (!table) return;
    var used = 0;
    table.querySelectorAll('input.trk-amt').forEach(function (input) {
      var tr = input.closest('tr');
      var on = tr.querySelector('input.trk-pick').checked;
      tr.classList.toggle('picked', on);
      input.disabled = !on;
      if (on) used += parseFloat(input.value) || 0;
    });
    var left = Math.round((capacity - used) * 100) / 100;
    if (remainVal) remainVal.textContent = fmt(left, 2);
    if (remainBox) remainBox.classList.toggle('over', left < -0.001);
    if (mobileLeft) mobileLeft.textContent = fmt(left, 2);
    if (mobileBar) mobileBar.classList.toggle('over', left < -0.001);
    if (mobileSave) mobileSave.disabled = left < -0.001;
    if (saveBtn) {
      saveBtn.disabled = left < -0.001;
      saveBtn.style.opacity = left < -0.001 ? '.6' : '';
    }
  }

  // Ticking an invoice offers what is still loose — never more than the
  // invoice owes or the money has left — instead of its whole balance, which
  // overshot the receipt the moment a second invoice was ticked.
  function fillOnPick(cb) {
    var input = cb.closest('tr').querySelector('input.trk-amt');
    if (!cb.checked) { input.value = ''; return; }
    if (parseFloat(input.value) > 0) return;
    var used = 0;
    table.querySelectorAll('input.trk-amt').forEach(function (other) {
      if (other !== input && other.closest('tr').querySelector('input.trk-pick').checked) {
        used += parseFloat(other.value) || 0;
      }
    });
    var take = Math.max(0, Math.min(capacity - used, parseFloat(input.dataset.max) || 0));
    input.value = (Math.round(take * 100) / 100).toFixed(2);
  }

  if (table) {
    table.addEventListener('input', recalc);
    table.addEventListener('change', function (e) {
      if (e.target.classList.contains('trk-pick')) fillOnPick(e.target);
      recalc();
    });
    recalc();
  }
  if (mobileSave) mobileSave.addEventListener('click', function () { if (saveBtn) saveBtn.click(); });
  if (pickAll) {
    pickAll.addEventListener('change', function () {
      table.querySelectorAll('input.trk-pick').forEach(function (cb) {
        cb.checked = pickAll.checked;
        fillOnPick(cb);
      });
      recalc();
    });
  }
  if (autoBtn) {
    autoBtn.addEventListener('click', function () {
      var left = capacity;
      table.querySelectorAll('input.trk-amt').forEach(function (input) {
        var pick = input.closest('tr').querySelector('input.trk-pick');
        var take = Math.min(left, parseFloat(input.dataset.max) || 0);
        take = Math.round(take * 100) / 100;
        pick.checked = take > 0;
        input.value = take > 0 ? take.toFixed(2) : '0.00';
        left = Math.round((left - take) * 100) / 100;
      });
      recalc();
    });
  }
  if (saveBtn) {
    saveBtn.addEventListener('click', function () {
      var entries = [];
      table.querySelectorAll('input.trk-amt').forEach(function (input) {
        var on = input.closest('tr').querySelector('input.trk-pick').checked;
        entries.push({ doc_id: parseInt(input.dataset.doc, 10),
                       amount: on ? (parseFloat(input.value) || 0) : 0 });
      });
      showError('');
      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving…';
      fetch('/invoicing/tracking/api/assign/@r.LineId', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ entries: entries })
      }).then(function (r) { return r.json(); })
        .then(function (data) {
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save assignment';
          if (!data.ok) { showError(data.error || 'The assignment was refused.'); return; }
          // Fully accounted for: back to the queue for the next one.
          if (data.row && data.row.unassigned <= 0.005) {
            window.location.href = '/invoicing/tracking/';
            return;
          }
          window.location.reload();
        })
        .catch(function () {
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save assignment';
          showError('Could not save. Check your connection and try again.');
        });
    });
  }
  document.querySelectorAll('.trk-unassign').forEach(function (btn) {
    var armed = null;
    btn.addEventListener('click', function () {
      // First press arms it: detaching is undone only by assigning again.
      if (!btn.classList.contains('is-armed')) {
        btn.classList.add('is-armed');
        btn.textContent = 'Press again to detach';
        armed = setTimeout(function () { btn.classList.remove('is-armed'); btn.textContent = 'Detach'; }, 4000);
        return;
      }
      clearTimeout(armed);
      btn.classList.remove('is-armed');
      btn.disabled = true;
      btn.textContent = 'Detaching…';
      fetch('/invoicing/tracking/api/unassign/0'.replace(/0$/, btn.dataset.id),
            { method: 'POST', headers: { 'Content-Type': 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.ok) { window.location.reload(); return; }
          btn.disabled = false;
          btn.textContent = 'Detach';
          showError(data.error || 'Could not detach that entry.');
        })
        .catch(function () {
          btn.disabled = false;
          btn.textContent = 'Detach';
          showError('Could not detach that entry.');
        });
    });
  });

  function postJson(url, payload, onDone, onFail) {
    fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' },
                 body: JSON.stringify(payload || {}) })
      .then(function (r) { return r.json(); })
      .then(function (data) { if (data.ok) onDone(data); else onFail(data.error || 'That was refused.'); })
      .catch(function () { onFail('Could not save. Check your connection and try again.'); });
  }
  var forceSave = document.getElementById('trkForceSave');
  if (forceSave) {
    forceSave.addEventListener('click', function () {
      var reason = document.getElementById('trkForceReason').value.trim();
      if (!reason) { showError('Give a reason for closing this without an invoice.'); return; }
      showError('');
      forceSave.disabled = true;
      postJson('/invoicing/tracking/api/force-close/@r.LineId',
               { amount: parseFloat(document.getElementById('trkForceAmt').value) || 0, reason: reason },
               function () { window.location.reload(); },
               function (msg) { forceSave.disabled = false; showError(msg); });
    });
  }
  var reopen = document.getElementById('trkReopen');
  if (reopen) {
    reopen.addEventListener('click', function () {
      reopen.disabled = true;
      postJson('/invoicing/tracking/api/release-force/@r.LineId', {},
               function () { window.location.reload(); },
               function (msg) { reopen.disabled = false; showError(msg); });
    });
  }
})();
</script>
}
