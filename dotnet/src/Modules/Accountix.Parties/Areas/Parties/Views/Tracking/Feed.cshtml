@model Accountix.Parties.Controllers.FeedPageModel
@using Accountix.Parties.Services
@{
    ViewData["Title"] = "Payment & Receipt Feed";
    var m = Model;
    var s = m.Summary;
    var chips = new (string Key, string Label)[] { ("unassigned", "Unassigned"), ("partial", "Partial"), ("review", "Re-assign"), ("assigned", "Assigned"), ("forced", "No invoice") };
    var stateWord = new Dictionary<string, string> { ["unassigned"] = "Unassigned", ["partial"] = "Partial", ["assigned"] = "Assigned", ["forced"] = "No invoice", ["review"] = "Re-assign" };
    var showCustomers = m.Side != "supplier" ? m.Customers : [];
    var showSuppliers = m.Side != "customer" ? m.Suppliers : [];
    var showLedCust = m.Side != "supplier" ? m.LedgerCustomers : [];
    var showLedSupp = m.Side != "customer" ? m.LedgerSuppliers : [];
    bool hasAny = showCustomers.Count > 0 || showSuppliers.Count > 0 || showLedCust.Count > 0 || showLedSupp.Count > 0;
    string P(int n) => n == 1 ? "" : "s";
    string Search(FeedRow r) => string.Join(" ", new[] { r.VoucherNumber, r.VoucherType, r.PartyName, r.Description, r.Notes, r.LedgerCode, r.LedgerName, r.CashAccount }.Where(x => !string.IsNullOrEmpty(x))).ToLowerInvariant();
}
@section Head {
<partial name="_TrackingStyle" />
<style>
/* Slide-over assignment panel — feed-only, so it lives here rather than in the
   shared sheet every tracking page loads. */
.trk-scrim{position:fixed;inset:0;background:rgba(9,11,13,.46);z-index:400;opacity:0;
  pointer-events:none;transition:opacity .2s ease}
.trk-scrim.show{opacity:1;pointer-events:auto}
.trk-drawer{position:fixed;top:0;right:0;bottom:0;width:min(660px,100%);background:var(--paper);
  z-index:401;display:flex;flex-direction:column;transform:translateX(100%);
  /* Hidden once it has slid out, so its fields cannot be tabbed into while
     closed; visible at once when it opens. */
  visibility:hidden;transition:transform .26s cubic-bezier(.4,0,.2,1),visibility 0s linear .26s;
  box-shadow:-12px 0 40px rgba(15,23,42,.22)}
.trk-drawer.show{transform:translateX(0);visibility:visible;transition-delay:0s}
.trk-drawer-head{display:flex;align-items:flex-start;gap:14px;padding:16px 18px;background:var(--card);
  border-bottom:1px solid var(--trk-line)}
.trk-drawer-head h2{margin:0;font-size:17px;color:var(--ink);letter-spacing:-.01em}
.trk-drawer-head p{margin:4px 0 0;color:var(--muted);font-size:12px}
.trk-drawer-close{margin-left:auto;background:none;border:1px solid var(--line);border-radius:8px;
  width:32px;height:32px;font-size:17px;color:var(--muted);cursor:pointer;flex:none;font-family:inherit}
.trk-drawer-close:hover{border-color:var(--trk-late);color:var(--trk-late)}
.trk-drawer-body{flex:1;overflow-y:auto;padding:16px 18px}
.trk-drawer-foot{padding:14px 18px;background:var(--card);border-top:1px solid var(--trk-line)}
.trk-drawer-block{border:1px solid var(--trk-line);border-radius:12px;background:var(--card);
  box-shadow:var(--trk-shadow);overflow:hidden;margin-bottom:14px}
.trk-drawer-block>h3{margin:0;padding:12px 15px;border-bottom:1px solid var(--trk-line);
  background:var(--surface-low);font-size:12.5px;color:var(--ink)}
.trk-drawer-block .pad{padding:14px 15px}
.trk-loading{padding:32px;text-align:center;color:var(--muted);font-size:13px}
/* The force-close panel asks two short questions, so it does not need the
   full-width sheet the assignment table uses. */
.trk-drawer-sm{width:min(420px,100%)}
@@media(max-width:720px){.trk-drawer-body{padding:14px}.trk-drawer-head{padding:14px}}
</style>
}
<div class="trk">

  @if (m.Stale.Count > 0)
  {
  <section class="trk-attention">
    <div class="trk-attention-head">
      <div>
        <h2>@m.Stale.Count @("assignment" + P(m.Stale.Count)) needs attention</h2>
        <p>These were assigned earlier, but the voucher or invoice behind them
          has since changed, so they no longer count. The invoices involved have
          already dropped back to unpaid or partially paid — nothing was posted
          and no ledger balance moved. Clearing them only removes the broken
          link.</p>
      </div>
      @if (m.CanAssign)
      {
      <button type="button" class="btn btn-sm btn-outline" id="trkClearStale">Clear all</button>
      }
    </div>
    <div class="trk-table-wrap">
      <table class="trk-table">
        <thead>
          <tr><th>Voucher</th><th>Party</th><th>Was assigned to</th>
              <th class="num">Amount</th><th>Why it broke</th></tr>
        </thead>
        <tbody>
          @foreach (var st in m.Stale)
          {
          <tr>
            <td data-label="Voucher">
              <a href="/accounting/vouchers/@st.VoucherId"
                 class="trk-doclink">@st.VoucherNumber</a>
              @if (st.VoucherStatus != "approved")
              {
              <span class="trk-state trk-state-review">@st.VoucherStatus</span>
              }
            </td>
            <td data-label="Party">@st.PartyName</td>
            <td data-label="Was assigned to">@st.DocNumber</td>
            <td data-label="Amount" class="num strong">@Html.Amount(st.Amount, 2)</td>
            <td data-label="Why it broke">@st.Reason</td>
          </tr>
          }
        </tbody>
      </table>
    </div>
  </section>
  }

  <form method="GET" id="feedFilters" class="trk-filterbar @(m.Filtering ? "open" : "")">
    <input type="hidden" name="state" value="">
    <div class="trk-chips">
      @foreach (var (key, label) in chips)
      {
      <label class="trk-chip @(s.Count(key) == 0 ? "is-empty" : "")">
        <input type="checkbox" name="state" value="@key" checked="@m.States.Contains(key)">
        <span>@label
          <b>@s.Count(key)</b></span>
      </label>
      }
      <button type="button" class="btn btn-sm btn-outline trk-filter-toggle"
              aria-expanded="@(m.Filtering ? "true" : "false")"
              onclick="var f=this.form;f.classList.toggle('open');this.setAttribute('aria-expanded',f.classList.contains('open'))">
        Filters</button>
    </div>

    <div class="trk-filterbar-row">
      <select name="flow" class="trk-select" aria-label="Direction">
        <option value="">All directions</option>
        <option value="receipt" selected="@(m.Flow == "receipt")">Receipts in</option>
        <option value="payment" selected="@(m.Flow == "payment")">Payments out</option>
      </select>
      <select name="side" class="trk-select" aria-label="Customers or suppliers">
        <option value="">Customers &amp; suppliers</option>
        <option value="customer" selected="@(m.Side == "customer")">Customers only</option>
        <option value="supplier" selected="@(m.Side == "supplier")">Suppliers only</option>
      </select>
      <select name="party" class="trk-select" aria-label="Customer or supplier"
              disabled="@(!hasAny)">
        @if (!hasAny)
        {
        <option value="">@(m.Side == "customer" ? "No customers yet" : m.Side == "supplier" ? "No suppliers yet" : "No customers or suppliers yet")</option>
        }
        else
        {
        <option value="">@(m.Side == "customer" ? "All customers" : m.Side == "supplier" ? "All suppliers" : "All parties")</option>
        @if (showCustomers.Count > 0)
        {
        <optgroup label="Customers">
          @foreach (var c in showCustomers)
          {
          <option value="customer:@c.Id" selected="@(m.Party == "customer:" + c.Id)">@c.Name</option>
          }
        </optgroup>
        }
        @if (showSuppliers.Count > 0)
        {
        <optgroup label="Suppliers">
          @foreach (var c in showSuppliers)
          {
          <option value="supplier:@c.Id" selected="@(m.Party == "supplier:" + c.Id)">@c.Name</option>
          }
        </optgroup>
        }
        @if (showLedCust.Count > 0)
        {
        <optgroup label="Receivable ledgers">
          @foreach (var l in showLedCust)
          {
          <option value="customer:@l.Id" selected="@(m.Party == "customer:" + l.Id)">@l.Name</option>
          }
        </optgroup>
        }
        @if (showLedSupp.Count > 0)
        {
        <optgroup label="Payable ledgers">
          @foreach (var l in showLedSupp)
          {
          <option value="supplier:@l.Id" selected="@(m.Party == "supplier:" + l.Id)">@l.Name</option>
          }
        </optgroup>
        }
        }
      </select>
      <input type="search" name="q" value="@m.Q" class="trk-input trk-filterbar-search"
             placeholder="Voucher no., narration or ledger" aria-label="Search" autocomplete="off">
      <input type="date" name="from" value="@m.From" class="trk-input" aria-label="From date">
      <input type="date" name="to" value="@m.To" class="trk-input" aria-label="To date">
      <button type="submit" class="btn btn-sm btn-primary">Apply</button>
      @if (m.Filtering)
      {
      <a href="/invoicing/tracking/" class="trk-rowbtn">Reset</a>
      }
    </div>
  </form>

  @if (m.CanAssign && m.Matchable > 0)
  {
  <div class="trk-matchbar" id="trkMatchBar">
    <div>
      <p>For @m.MatchScope:
        @if (m.MatchIn.Count > 0) {<b>@m.MatchIn.Count</b><text> @("receipt" + P(m.MatchIn.Count)) worth </text><b>@Html.Amount(m.MatchIn.Value, 2)</b>}
        @if (m.MatchIn.Count > 0 && m.MatchOut.Count > 0) {<text> and </text>}
        @if (m.MatchOut.Count > 0) {<b>@m.MatchOut.Count</b><text> @("payment" + P(m.MatchOut.Count)) worth </text><b>@Html.Amount(m.MatchOut.Value, 2)</b>}
        can settle their invoices, oldest first.</p>
      <p class="trk-note">Existing splits and force-closed money stay as they are. Nothing is posted — the vouchers already were.</p>
    </div>
    <button type="button" class="btn btn-sm btn-primary" id="trkMatch"
            data-party="@m.Party" data-side="@m.Side"
            data-label="Match oldest first">Match oldest first</button>
  </div>
  }

  <p class="trk-count"><span id="feedCount">@m.Pager.Total @("item" + P(m.Pager.Total))</span>@if (m.Drafts > 0) {<text> · @m.Drafts unapproved @("voucher" + P(m.Drafts)) not shown</text>}</p>

      @if (m.Rows.Count > 0)
      {
      <div class="trk-empty" id="feedNoMatch" hidden>
        <strong>No match in these results</strong>
        <p>Nothing here matches that text. Clear the box to see all
          @m.Rows.Count again, or press Apply to search every voucher.</p>
      </div>
      <div class="trk-feed">
        @foreach (var r in m.Rows)
        {
        string state = r.State;
        <article class="trk-item @(r.Flow == "payment" ? "is-payment" : "")"
                 data-line="@r.LineId" data-party="@r.PartyName"
                 data-search="@Search(r)">
          <div class="trk-item-main">
            <div class="trk-item-top">
              <span class="trk-flow @(r.Flow == "receipt" ? "in" : "out")">
                @(r.Flow == "receipt" ? "Receipt" : "Payment")
              </span>
              @if (!r.VoucherNumber.StartsWith(r.VoucherType, StringComparison.Ordinal))
              {
              <span class="trk-vtype">@r.VoucherType</span>
              }
              <a href="/accounting/vouchers/@r.VoucherId" class="trk-vno">@r.VoucherNumber</a>
              <span class="trk-state trk-state-@state"
                    title="@(state == "forced" ? "Closed without an invoice: " + r.ForcedReason : state == "review" ? "This voucher was edited after it was assigned: " + Html.Amount(r.OverAssigned, 2) + " more is assigned than it now carries" : null)">
                @stateWord[state]
              </span>
            </div>
            <span class="trk-party" title="@r.PartyName">@r.PartyName</span>
            @if (state == "review")
            {
            <div class="trk-meta" style="color:var(--danger);font-weight:700;">
              This voucher was edited after it was assigned:
              @Html.Amount(r.Assigned, 2) is assigned but it now carries
              only @Html.Amount(r.Amount, 2). Re-assign it.
            </div>
            }
            <div class="trk-meta">
              @r.Date.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)@if (r.CashAccount.Length > 0) {<text> &middot; @r.CashAccount</text>}@if (r.Description.Length > 0) {<text> &middot; @r.Description</text>}
            </div>
          </div>
          <div class="trk-amount-col">
            <div class="trk-amount">@Html.Amount(r.Amount, 2)</div>
            <div class="trk-amount-sub">@(r.Flow == "receipt" ? "received" : "paid")</div>
            @if (r.Assigned > 0 || r.Forced > 0 || state == "review")
            {
            <div class="trk-bar"><i style="width:@((r.Progress < 100 ? r.Progress : 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"></i></div>
            <div class="trk-progress-legend">
              <span>@(r.Forced != 0 ? "On invoices" : "Assigned")
                <b>@Html.Amount(r.ToInvoices, 2)</b></span>
              @if (r.Forced != 0)
              {
              <span title="@r.ForcedReason">No invoice <b>@Html.Amount(r.Forced, 2)</b></span>
              }
              @if (r.Unassigned > 0)
              {
              <span>Left <b>@Html.Amount(r.Unassigned, 2)</b></span>
              }
            </div>
            }
          </div>
          <div class="trk-item-actions">
            @if (m.CanAssign)
            {
            @if (!r.IsLedger)
            {
            <button type="button" class="btn btn-sm btn-primary trk-assign-btn" data-line="@r.LineId">
              @(state == "unassigned" ? "Assign" : "Adjust")
            </button>
            }
            @if (r.Forced != 0)
            {
            <button type="button" class="btn btn-sm btn-outline trk-release-btn" data-line="@r.LineId">
              Reopen
            </button>
            }
            else if (r.Unassigned > 0)
            {
            <button type="button" class="btn btn-sm @(r.IsLedger ? "btn-primary" : "btn-outline") trk-force-btn"
                    data-line="@r.LineId" data-amount="@TrackingRules.PyFloat(r.Unassigned)"
                    title="@(r.IsLedger ? "This ledger carries no invoices — close the money with a reason" : "For money with no invoice to match — an advance, a rounding difference, something never invoiced")">
              No invoice
            </button>
            }
            }
            <a href="/invoicing/tracking/assign/@r.LineId" class="trk-rowbtn">Open</a>
          </div>
        </article>
        }
      </div>
      <partial name="_Pager" model="@m.Pager" />
      }
      else
      {
      <div class="trk-empty">
        <span class="trk-empty-icon">&#9878;</span>
        <strong>Nothing to match here</strong>
        <p>No approved receipt or payment fits these filters. Receipts and
          payments appear once their CRV / BRV / CPV / BPV / JV is approved and
          the line hits a customer or supplier account.
          @if (m.Drafts > 0) {<text>There @(m.Drafts == 1 ? "is" : "are") @m.Drafts unapproved @("voucher" + P(m.Drafts)) waiting.</text>}</p>
      </div>
      }
</div>

@if (m.CanAssign)
{
<div class="trk-scrim" id="trkScrim"></div>
<aside class="trk-drawer" id="trkDrawer" role="dialog" aria-modal="true" aria-labelledby="trkDrawerTitle">
  <div class="trk-drawer-head">
    <div>
      <h2 id="trkDrawerTitle">Assign to invoices</h2>
      <p id="trkDrawerSub">&nbsp;</p>
    </div>
    <button type="button" class="trk-drawer-close" id="trkDrawerClose" aria-label="Close">&times;</button>
  </div>
  <div class="trk-err" id="trkErr" role="alert"></div>
  <div class="trk-drawer-body" id="trkDrawerBody">
    <div class="trk-loading">Loading…</div>
  </div>
  <div class="trk-drawer-foot">
    <div class="trk-remaining" id="trkRemaining">
      <div class="lbl">Left to assign</div>
      <div class="val" id="trkRemainingVal">0.00</div>
    </div>
    <div class="trk-savebar" style="margin-top:12px;">
      <button type="button" class="btn btn-primary" id="trkSave">Save assignment</button>
      <button type="button" class="btn btn-outline" id="trkAuto">Auto-assign oldest first</button>
    </div>
  </div>
</aside>

<div class="trk-scrim" id="trkForceScrim"></div>
<aside class="trk-drawer trk-drawer-sm" id="trkForce" role="dialog" aria-modal="true" aria-labelledby="trkForceTitle">
  <div class="trk-drawer-head">
    <div>
      <h2 id="trkForceTitle">Close without an invoice</h2>
      <p id="trkForceSub">&nbsp;</p>
    </div>
    <button type="button" class="trk-drawer-close" id="trkForceClose" aria-label="Close">&times;</button>
  </div>
  <div class="trk-err" id="trkForceErr" role="alert"></div>
  <div class="trk-drawer-body">
    <p class="trk-sub" style="margin-bottom:14px;">
      Use this for money with no invoice to match — a customer advance, a
      rounding difference, or something that was never invoiced. It records the
      decision against the receipt. Nothing is posted and no invoice changes.
    </p>
    <div class="trk-field" style="margin-bottom:12px;">
      <label class="trk-lbl" for="trkForceAmt">Amount to close</label>
      <input type="number" step="0.01" min="0.01" id="trkForceAmt" class="trk-input">
    </div>
    <div class="trk-field">
      <label class="trk-lbl" for="trkForceReason">Reason (required)</label>
      <input type="text" id="trkForceReason" class="trk-input" maxlength="300"
             placeholder="e.g. advance against future orders">
    </div>
  </div>
  <div class="trk-drawer-foot">
    <div class="trk-savebar" style="margin-top:0;">
      <button type="button" class="btn btn-primary" id="trkForceSave">Close as not applicable</button>
    </div>
  </div>
</aside>
}

@section Scripts {
<script>
(function () {
  try {
    var y = sessionStorage.getItem('trkFeedY');
    if (y !== null) { sessionStorage.removeItem('trkFeedY'); window.scrollTo(0, parseInt(y, 10) || 0); }
  } catch (e) {}
})();
// Live search over the rows already on screen. It narrows what the other
// filters returned rather than re-querying, so results move as you type;
// Enter/Apply still runs the server-side search across every voucher, which
// can bring back rows this page never had.
(function () {
  var form = document.getElementById('feedFilters');
  var feed = document.querySelector('.trk-feed');
  if (!form || !feed) return;
  var input = form.querySelector('input[name="q"]');
  if (!input) return;
  var items = Array.prototype.slice.call(feed.querySelectorAll('.trk-item'));
  var countEl = document.getElementById('feedCount');
  if (countEl) countEl.dataset.all = countEl.textContent;
  var noMatch = document.getElementById('feedNoMatch');
  var total = items.length;

  function apply() {
    var term = input.value.trim().toLowerCase();
    var shown = 0;
    items.forEach(function (el) {
      var hit = !term ||
        (el.getAttribute('data-search') || '').indexOf(term) !== -1;
      el.hidden = !hit;
      if (hit) shown++;
    });
    if (countEl) {
      // With nothing typed the server's count — of every page — stands.
      countEl.textContent = !term ? countEl.dataset.all
        : shown + ' item' + (shown === 1 ? '' : 's') +
          (shown !== total ? ' of ' + total + ' on this page' : '');
    }
    if (noMatch) noMatch.hidden = shown !== 0;
    feed.hidden = shown === 0;
  }

  input.addEventListener('input', apply);
  input.addEventListener('search', apply);   // the "x" in a type=search box
  apply();
})();
</script>
@if (m.CanAssign)
{
<script>
(function () {
  var scrim = document.getElementById('trkScrim');
  var drawer = document.getElementById('trkDrawer');
  var body = document.getElementById('trkDrawerBody');
  var sub = document.getElementById('trkDrawerSub');
  var err = document.getElementById('trkErr');
  var remainBox = document.getElementById('trkRemaining');
  var remainVal = document.getElementById('trkRemainingVal');
  var saveBtn = document.getElementById('trkSave');
  var autoBtn = document.getElementById('trkAuto');
  var current = null;          // the feed row being assigned
  var fmt = window.formatAmount || function (v) { return (+v || 0).toFixed(2); };

  function open() {
    scrim.classList.add('show');
    drawer.classList.add('show');
    document.body.style.overflow = 'hidden';
  }
  function close() {
    scrim.classList.remove('show');
    drawer.classList.remove('show');
    document.body.style.overflow = '';
    current = null;
  }
  function showError(msg) {
    err.textContent = msg || '';
    err.classList.toggle('show', !!msg);
  }
  // After a save the page reloads; come back to the same place in the list.
  function reloadHere() {
    try { sessionStorage.setItem('trkFeedY', String(window.scrollY)); } catch (e) {}
    window.location.reload();
  }

  // The capacity check the server enforces, mirrored live so the user sees the
  // refusal before submitting rather than after.
  function recalc() {
    if (!current) return;
    var used = 0;
    body.querySelectorAll('input.trk-amt').forEach(function (input) {
      var row = input.closest('tr');
      var on = row.querySelector('input.trk-pick').checked;
      row.classList.toggle('picked', on);
      input.disabled = !on;
      if (on) used += parseFloat(input.value) || 0;
    });
    var left = Math.round((capacity() - used) * 100) / 100;
    remainVal.textContent = fmt(left, 2);
    remainBox.classList.toggle('over', left < -0.001);
    saveBtn.disabled = left < -0.001;
    saveBtn.style.opacity = left < -0.001 ? '.6' : '';
  }

  function render(data) {
    current = data.row;
    var r = data.row;
    var word = r.flow === 'receipt' ? 'Receipt from' : 'Payment to';
    sub.textContent = word + ' ' + r.party_name + ' · ' + r.voucher_type +
                      ' ' + r.voucher_number + ' · ' + fmt(r.amount, 2);
    var docWord = r.doc_type === 'SI' ? 'sales' : 'purchase';
    var html = '';
    if (!data.invoices.length) {
      html += '<div class="trk-drawer-block"><div class="pad trk-empty" style="padding:26px 14px;">' +
              '<strong>No open ' + docWord + ' invoice</strong><p>This party has no approved ' +
              docWord + ' invoice with a balance. If the money is an advance or was never ' +
              'invoiced, close it with a reason; otherwise it waits here for the invoice.</p>' +
              (r.unassigned > 0 ? '<button type="button" class="btn btn-outline" id="trkDrawerForce">' +
               'Close without an invoice</button>' : '') + '</div></div>';
    } else {
      html += '<div class="trk-drawer-block"><h3>Open ' + docWord + ' invoices — oldest first</h3>' +
              '<div class="trk-table-wrap"><table class="trk-alloc-table"><thead><tr>' +
              '<th style="width:38px;"></th><th>Invoice</th><th>Due</th>' +
              '<th style="text-align:right;">Outstanding</th><th style="text-align:right;">Assign</th>' +
              '</tr></thead><tbody>';
      data.invoices.forEach(function (inv) {
        var picked = inv.assigned_here > 0;
        var age = inv.overdue_days > 0
          ? '<span class="trk-age ' + (inv.overdue_days > 30 ? 'hot' : 'warm') + '">' +
            inv.overdue_days + 'd late</span>'
          : '<span class="trk-age">' + (inv.due_str || '—') + '</span>';
        html += '<tr class="' + (picked ? 'picked' : '') + '">' +
          '<td data-label="Pick"><input type="checkbox" class="trk-pick" ' + (picked ? 'checked' : '') + '></td>' +
          '<td data-label="Invoice"><b>' + inv.number + '</b><div style="color:var(--muted);font-size:11px;">' +
            'Total ' + fmt(inv.total, 2) + ' · settled ' + fmt(inv.settled, 2) + '</div></td>' +
          '<td data-label="Due">' + age + '</td>' +
          '<td data-label="Outstanding" style="text-align:right;font-variant-numeric:tabular-nums;">' +
            fmt(inv.outstanding, 2) + '</td>' +
          '<td data-label="Assign" style="text-align:right;">' +
            '<input type="number" step="0.01" min="0" class="trk-amt" data-doc="' + inv.id +
            '" data-max="' + inv.assignable + '" value="' +
            (picked ? inv.assigned_here.toFixed(2) : '') + '"></td>' +
          '</tr>';
      });
      html += '</tbody></table></div></div>';
    }
    body.innerHTML = html;
    body.querySelectorAll('input.trk-amt').forEach(function (el) {
      el.addEventListener('input', recalc);
    });
    body.querySelectorAll('input.trk-pick').forEach(function (cb) {
      cb.addEventListener('change', function () { fillOnPick(cb); recalc(); });
    });
    var df = document.getElementById('trkDrawerForce');
    if (df) df.addEventListener('click', function () {
      var line = r.line_id, amt = r.unassigned, party = r.party_name;
      close();
      fOpen(line, amt, party);
    });
    recalc();
  }

  // Ticking an invoice offers what is still loose — never more than the
  // invoice owes or the money has left — instead of the invoice's whole
  // balance, which overshot the receipt the moment a second one was ticked.
  function fillOnPick(cb) {
    var input = cb.closest('tr').querySelector('input.trk-amt');
    if (!cb.checked) { input.value = ''; return; }
    if (parseFloat(input.value) > 0) return;
    var used = 0;
    body.querySelectorAll('input.trk-amt').forEach(function (other) {
      if (other !== input && other.closest('tr').querySelector('input.trk-pick').checked) {
        used += parseFloat(other.value) || 0;
      }
    });
    var take = Math.max(0, Math.min(capacity() - used, parseFloat(input.dataset.max) || 0));
    input.value = (Math.round(take * 100) / 100).toFixed(2);
  }

  // What the invoices can share: the money less any part force-closed.
  function capacity() {
    return current ? Math.round((current.amount - (current.forced || 0)) * 100) / 100 : 0;
  }

  function load(lineId) {
    showError('');
    body.innerHTML = '<div class="trk-loading">Loading…</div>';
    sub.textContent = ' ';
    open();
    fetch('/invoicing/tracking/api/feed-item/0'.replace(/0$/, lineId))
      .then(function (res) { return res.json(); })
      .then(function (data) {
        if (!data.ok) { showError(data.error || 'Could not load this payment.'); return; }
        data.row.line_id = lineId;
        render(data);
      })
      .catch(function () { showError('Could not load this payment. Check your connection.'); });
  }

  document.querySelectorAll('.trk-assign-btn').forEach(function (btn) {
    btn.addEventListener('click', function () { load(btn.dataset.line); });
  });
  document.getElementById('trkDrawerClose').addEventListener('click', close);
  scrim.addEventListener('click', close);
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && drawer.classList.contains('show')) close();
  });

  autoBtn.addEventListener('click', function () {
    if (!current) return;
    // Fill oldest first up to what is left, exactly as the server's proposal does.
    var left = capacity();
    body.querySelectorAll('input.trk-amt').forEach(function (input) {
      var pick = input.closest('tr').querySelector('input.trk-pick');
      var max = parseFloat(input.dataset.max) || 0;
      var take = Math.min(left, max);
      take = Math.round(take * 100) / 100;
      pick.checked = take > 0;
      input.value = take > 0 ? take.toFixed(2) : '0.00';
      left = Math.round((left - take) * 100) / 100;
    });
    recalc();
  });

  saveBtn.addEventListener('click', function () {
    if (!current) return;
    var entries = [];
    body.querySelectorAll('input.trk-amt').forEach(function (input) {
      var on = input.closest('tr').querySelector('input.trk-pick').checked;
      var amount = on ? (parseFloat(input.value) || 0) : 0;
      // A zero for a row that already carried an amount is how the server is
      // told to drop that part of the split, so unpicked rows are sent too.
      entries.push({ doc_id: parseInt(input.dataset.doc, 10), amount: amount });
    });
    if (!entries.length) { showError('There is no invoice to assign this to.'); return; }
    showError('');
    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving…';
    fetch('/invoicing/tracking/api/assign/0'.replace(/0$/, current.line_id), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ entries: entries })
    }).then(function (res) { return res.json(); })
      .then(function (data) {
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save assignment';
        if (!data.ok) { showError(data.error || 'The assignment was refused.'); return; }
        reloadHere();
      })
      .catch(function () {
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save assignment';
        showError('Could not save. Check your connection and try again.');
      });
  });

  // ── Close without an invoice ──────────────────────────────────────────────
  var fScrim = document.getElementById('trkForceScrim');
  var fPanel = document.getElementById('trkForce');
  var fAmt = document.getElementById('trkForceAmt');
  var fReason = document.getElementById('trkForceReason');
  var fErr = document.getElementById('trkForceErr');
  var fSave = document.getElementById('trkForceSave');
  var fSub = document.getElementById('trkForceSub');
  var forceLine = null;

  function fShowError(msg) {
    fErr.textContent = msg || '';
    fErr.classList.toggle('show', !!msg);
  }
  function fClose() {
    fPanel.classList.remove('show');
    fScrim.classList.remove('show');
    forceLine = null;
  }
  function fOpen(lineId, amount, party) {
    forceLine = lineId;
    fAmt.value = amount;
    fAmt.max = amount;
    fReason.value = '';
    fShowError('');
    fSub.textContent = party + ' · up to ' + amount + ' unassigned';
    fPanel.classList.add('show');
    fScrim.classList.add('show');
    fReason.focus();
  }

  document.querySelectorAll('.trk-force-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var item = btn.closest('.trk-item');
      fOpen(btn.dataset.line, btn.dataset.amount, item ? item.dataset.party : '');
    });
  });
  document.getElementById('trkForceClose').addEventListener('click', fClose);
  fScrim.addEventListener('click', fClose);

  fSave.addEventListener('click', function () {
    if (!forceLine) return;
    var reason = fReason.value.trim();
    if (!reason) { fShowError('Give a reason for closing this without an invoice.'); return; }
    fShowError('');
    fSave.disabled = true;
    fSave.textContent = 'Saving…';
    fetch('/invoicing/tracking/api/force-close/0'.replace(/0$/, forceLine), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ amount: parseFloat(fAmt.value) || 0, reason: reason })
    }).then(function (res) { return res.json(); })
      .then(function (data) {
        fSave.disabled = false;
        fSave.textContent = 'Close as not applicable';
        if (!data.ok) { fShowError(data.error || 'That was refused.'); return; }
        reloadHere();
      })
      .catch(function () {
        fSave.disabled = false;
        fSave.textContent = 'Close as not applicable';
        fShowError('Could not save. Check your connection and try again.');
      });
  });

  document.querySelectorAll('.trk-release-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      btn.disabled = true;
      fetch('/invoicing/tracking/api/release-force/0'.replace(/0$/, btn.dataset.line),
            { method: 'POST', headers: { 'Content-Type': 'application/json' } })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (!data.ok) {
            btn.disabled = false;
            btn.textContent = data.error || 'Refused';
            btn.title = data.error || '';
            return;
          }
          reloadHere();
        })
        .catch(function () { btn.disabled = false; });
    });
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && fPanel.classList.contains('show')) fClose();
  });

  // ── Match oldest first ───────────────────────────────────────────────────
  var matchBtn = document.getElementById('trkMatch');
  if (matchBtn) {
    var armed = null;
    matchBtn.addEventListener('click', function () {
      if (!matchBtn.classList.contains('is-armed')) {
        matchBtn.classList.add('is-armed');
        matchBtn.textContent = 'Press again to match';
        armed = setTimeout(function () {
          matchBtn.classList.remove('is-armed');
          matchBtn.textContent = matchBtn.dataset.label;
        }, 4000);
        return;
      }
      clearTimeout(armed);
      matchBtn.classList.remove('is-armed');
      matchBtn.disabled = true;
      matchBtn.textContent = 'Matching…';
      fetch('/invoicing/tracking/api/auto-match', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ party: matchBtn.dataset.party, side: matchBtn.dataset.side })
      }).then(function (res) { return res.json(); })
        .then(function (data) {
          var bar = document.getElementById('trkMatchBar');
          if (!data.ok) {
            matchBtn.disabled = false;
            matchBtn.textContent = matchBtn.dataset.label;
            if (bar) bar.querySelector('.trk-note').textContent = data.error || 'That was refused.';
            return;
          }
          if (bar) {
            bar.classList.add('is-done');
            bar.querySelector('div').innerHTML = '<p></p>';
            bar.querySelector('p').textContent = data.message;
          }
          setTimeout(reloadHere, 900);
        })
        .catch(function () {
          matchBtn.disabled = false;
          matchBtn.textContent = matchBtn.dataset.label;
        });
    });
  }

  // ── Clear broken assignments ──────────────────────────────────────────────
  var clearBtn = document.getElementById('trkClearStale');
  if (clearBtn) {
    clearBtn.addEventListener('click', function () {
      clearBtn.disabled = true;
      clearBtn.textContent = 'Clearing…';
      fetch('/invoicing/tracking/api/clear-stale',
            { method: 'POST', headers: { 'Content-Type': 'application/json' } })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (!data.ok) {
            clearBtn.disabled = false;
            clearBtn.textContent = 'Clear all';
            return;
          }
          window.location.reload();
        })
        .catch(function () {
          clearBtn.disabled = false;
          clearBtn.textContent = 'Clear all';
        });
    });
  }
})();
</script>
}
}
