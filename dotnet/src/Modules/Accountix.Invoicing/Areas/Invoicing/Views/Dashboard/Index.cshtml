@model Accountix.Invoicing.Models.DashboardModel
@{
    ViewData["Title"] = "Invoicing Dashboard";
    ViewData["Heading"] = "Invoicing Dashboard";
    var p = Model.Perf;
    var c = Model.Chart;
    var gp = c.Series[2];
    string? nf = Context.Access()?.Profile?.NumberFormat ?? "en";
    string A(double v) => Py.Amount(v, 0, nf);
    string R(double v) => Py.Repr(v);
    string Clamp(double margin) { double a = Math.Max(margin, 0); return a > 100 ? "100" : (margin < 0 ? "0" : Py.Repr(a)); }
}
@section Head {
<style>
/* â”€â”€ Performance â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
   The dashboard is one thing: how the business is doing. It used to be a
   settlement strip plus nine document-count tiles above the fold; those were
   removed, along with the queries feeding them, so the first screen answers a
   question instead of listing inventory.

   The component language follows DESIGN.md â€” white surfaces on a neutral
   ground, hairline borders, small muted labels over large ink values, and
   colour only where it means something. Palette tokens live in
   static/css/ui.css; nothing here hardcodes one except the pre-v2 fallback.

   SERIES COLOUR â€” EMPHASIS, NOT A CATEGORICAL SET
   Three saturated hues would be three things shouting. Revenue is ink,
   purchases is the muted grey AND dashed, and the single accent goes to gross
   profit â€” the number the chart exists to answer. Identity therefore comes
   from three separate channels (lightness, dash pattern, chroma), so the
   chart survives greyscale printing and colour-vision deficiency alike, which
   no three-hue set does. Measured all-pairs against both surfaces: worst CVD
   separation Î”E 8.4 light / 12.7 dark (target >= 8), worst normal-vision Î”E
   15.3 / 17.3 (floor 15), every series >= 3:1 on its surface. Re-measure
   before changing any of these values. */
.perf{margin-bottom:4px}
[data-ui="v2"] .perf{
  --s-rev:var(--v2-ink); --s-pur:var(--v2-muted); --s-gp:var(--v2-accent);
}
/* Fallback for the pre-v2 shell, where the tokens above are undefined. */
.perf{--s-rev:var(--v2-ink);--s-pur:var(--v2-muted);--s-gp:var(--v2-accent)}

.perf-head{display:flex;align-items:flex-start;justify-content:space-between;
  gap:16px;flex-wrap:wrap;margin-bottom:16px}
.perf-title{margin:0;font-size:21px;font-weight:600;letter-spacing:-.02em;
  color:var(--text);line-height:1.2}
.perf-sub{margin:5px 0 0;font-size:12px;color:var(--muted);display:flex;
  align-items:center;gap:6px;flex-wrap:wrap}
/* The accent tick is the reference's small marker before a provenance line:
   it says "this number came from somewhere" without spending a sentence. */
.perf-tick-dot{width:5px;height:5px;border-radius:50%;background:var(--s-gp);
  flex:none}
.perf-filters{display:flex;gap:7px;align-items:center;flex-wrap:wrap}
.perf-sel{padding:6px 27px 6px 11px;font-size:12px;border:1px solid var(--border);
  border-radius:8px;background:var(--card);color:var(--text);font-family:inherit;
  font-weight:500;cursor:pointer;appearance:none;
  background-image:linear-gradient(45deg,transparent 50%,var(--muted) 50%),
                   linear-gradient(135deg,var(--muted) 50%,transparent 50%);
  background-position:calc(100% - 14px) calc(50% + 1px),calc(100% - 9px) calc(50% + 1px);
  background-size:5px 5px,5px 5px;background-repeat:no-repeat}
.perf-sel:hover{background-color:var(--bg-top)}

/* â”€â”€ Stat tiles â”€â”€ */
.perf-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(215px,1fr));
  gap:12px;margin-bottom:12px}
.perf-kpi{padding:16px 18px 15px;border:1px solid var(--border-soft);
  border-radius:11px;background:var(--card);display:flex;flex-direction:column}
.perf-kpi-label{font-size:12px;color:var(--muted);font-weight:400;
  display:flex;align-items:center;gap:7px}
.perf-key{width:10px;height:2px;border-radius:1px;flex:none}
.perf-key.dashed{background-image:linear-gradient(90deg,currentColor 55%,transparent 55%);
  background-size:4px 2px}
.perf-kpi-value{margin-top:7px;font-size:29px;font-weight:600;color:var(--text);
  letter-spacing:-.025em;font-variant-numeric:tabular-nums;line-height:1.1}
.perf-kpi-delta{margin-top:9px;font-size:12px;font-weight:500;
  display:flex;align-items:center;gap:5px;font-variant-numeric:tabular-nums}
/* Up is the accent, down is the olive warn tone â€” not red. A softer month is
   information, not an error, and a dashboard that shouts at every dip stops
   being read. */
.perf-kpi-delta.up{color:var(--success)}
.perf-kpi-delta.down{color:var(--warning)}
.perf-kpi-delta.flat{color:var(--light)}
.perf-bar{margin-top:11px;height:3px;border-radius:2px;background:var(--surface-variant);
  overflow:hidden}
.perf-bar span{display:block;height:100%;background:var(--text);border-radius:2px}
.perf-kpi-foot{margin-top:auto;padding-top:10px;font-size:11.5px;color:var(--light);
  line-height:1.45}

/* â”€â”€ Chart â”€â”€ */
.perf-chart{border:1px solid var(--border-soft);border-radius:11px;
  background:var(--card);padding:16px 18px 12px}
.perf-chart-head{display:flex;align-items:baseline;justify-content:space-between;
  gap:14px;flex-wrap:wrap;margin-bottom:4px}
.perf-chart-h{margin:0;font-size:13.5px;font-weight:600;color:var(--text)}
.perf-cap{font-size:11.5px;color:var(--light)}
.perf-legend{display:flex;gap:16px;flex-wrap:wrap;margin:10px 0 6px}
.perf-leg{display:flex;align-items:center;gap:7px;font-size:11.5px;color:var(--muted)}
.perf-leg b{color:var(--text);font-weight:600;font-variant-numeric:tabular-nums}
.perf-plot{position:relative}
.perf-svg{display:block;width:100%;height:auto;overflow:visible}
.perf-grid{stroke:var(--border-soft);stroke-width:1;vector-effect:non-scaling-stroke}
.perf-zero{stroke:var(--border);stroke-width:1;vector-effect:non-scaling-stroke}
.perf-tick{fill:var(--light);font-size:10px;font-variant-numeric:tabular-nums}
.perf-xlab{fill:var(--light);font-size:10px}
.perf-line{fill:none;stroke-width:2;stroke-linejoin:round;stroke-linecap:round;
  vector-effect:non-scaling-stroke}
/* Purchases is the context series: thinner, dashed, muted. The dash is the
   second identity channel, so the pair still reads with colour removed. */
.perf-line[data-s="pur"]{stroke-width:1.5;stroke-dasharray:4 3}
.perf-pt{stroke:var(--card);stroke-width:1.5;vector-effect:non-scaling-stroke}
.perf-endlab{fill:var(--text);font-size:10.5px;font-weight:600;
  font-variant-numeric:tabular-nums}
.perf-cross{stroke:var(--muted);stroke-width:1;vector-effect:non-scaling-stroke;
  opacity:0;pointer-events:none}
.perf-hit{fill:transparent;cursor:crosshair}
.perf-hover-dot{stroke:var(--card);stroke-width:2;opacity:0;pointer-events:none;
  vector-effect:non-scaling-stroke}
.perf-tip{position:absolute;top:0;left:0;min-width:162px;padding:9px 11px;
  border-radius:10px;background:var(--card);border:1px solid var(--border);
  box-shadow:var(--shadow-lg);font-size:11.5px;pointer-events:none;opacity:0;
  transition:opacity .1s;z-index:5}
.perf-tip.on{opacity:1}
.perf-tip-m{font-weight:600;color:var(--text);margin-bottom:6px;font-size:11.5px}
.perf-tip-r{display:flex;align-items:center;gap:8px;margin-top:4px}
.perf-tip-r .k{width:10px;height:2px;border-radius:1px;flex:none}
.perf-tip-r .n{color:var(--muted);flex:1}
.perf-tip-r .v{color:var(--text);font-weight:600;font-variant-numeric:tabular-nums}

/* The table is the chart's accessible twin, not a fallback: it carries every
   value for a reader who cannot separate the lines. */
.perf-table-wrap{margin-top:6px}
.perf-table-wrap summary{cursor:pointer;font-size:11.5px;color:var(--muted);padding:6px 0}
.perf-table{width:100%;border-collapse:collapse;font-size:11.5px;margin-top:4px}
.perf-table th,.perf-table td{padding:5px 8px;text-align:right;
  border-top:1px solid var(--border-soft);font-variant-numeric:tabular-nums}
.perf-table th:first-child,.perf-table td:first-child{text-align:left}
.perf-table th{color:var(--muted);font-weight:500}
.perf-table td{color:var(--text)}
@@media(max-width:560px){
  .perf-title{font-size:18px}
  .perf-kpi-value{font-size:25px}
  .perf-legend{gap:12px}
}
</style>
}
<section class="perf">
  <div class="perf-head">
    <div>
      <h2 class="perf-title">Performance</h2>
      <p class="perf-sub">
        <span class="perf-tick-dot"></span>
        @p.Year &middot; approved invoices, net of tax and of returns
        &middot; gross profit carries no operating costs
      </p>
    </div>
    @* GET, so a filtered dashboard is a shareable URL that survives a refresh. *@
    <form class="perf-filters" method="get" action="/invoicing/" id="perf-filters">
      <select class="perf-sel" name="label" id="perf-label" aria-label="Filter by project label" onchange="this.form.submit()">
        <option value="">All labels</option>
        @foreach (var l in Model.Labels)
        {
        <!option value="@l.Id" @(Model.SelLabel == l.Id ? "selected" : "")>@l.Name@(l.IsActive == true ? "" : " (archived)")</!option>
        }
      </select>
      <select class="perf-sel" name="year" id="perf-year" aria-label="Filter by year" onchange="this.form.submit()">
        @if (Model.Years.Count > 0)
        {
          foreach (var y in Model.Years)
          {
        <!option value="@y" @(Model.SelYear == y ? "selected" : "")>@y</!option>
          }
        }
        else
        {
        <option value="@Model.SelYear" selected>@Model.SelYear</option>
        }
      </select>
    </form>
  </div>

  <div class="perf-kpis">
    @foreach (var sr in c.Series)
    {
    double? d = p.Deltas[sr.Key];
    <div class="perf-kpi" data-kpi="@sr.Key">
      <div class="perf-kpi-label">
        <span class="perf-key @(sr.Var == "pur" ? "dashed" : "")" style="background:var(--s-@(sr.Var));color:var(--s-@(sr.Var));"></span>
        @sr.Label
      </div>
      <div class="perf-kpi-value">@A(p.Totals.Of(sr.Key))</div>
      <div class="perf-kpi-delta @(d is null ? "flat" : (d >= 0 ? "up" : "down"))">
        @if (d is double dv)
        {
        <span aria-hidden="true">@Html.Raw(dv >= 0 ? "&#8599;" : "&#8600;")</span>
        <span>@(dv >= 0 ? "+" : "")@Py.Fixed(dv, 1)%</span>
        <span style="color:var(--light);font-weight:400;">vs @p.PrevYear</span>
        }
        else
        {
        <span>No @p.PrevYear comparison</span>
        }
      </div>
      @if (sr.Key == "gross" && p.Totals.Margin is double margin)
      {
      @* The bar is the margin, clamped: a margin over 100% is not drawable and
         a negative one has no bar to draw. *@
      <div class="perf-bar"><span style="width:@(Clamp(margin))%;"></span></div>
      <div class="perf-kpi-foot">@Py.Fixed(margin, 1)% margin on @A(p.Totals.Revenue) revenue</div>
      }
      else if (sr.Key == "revenue")
      {
      <div class="perf-kpi-foot">Approved sales invoices, less approved credit notes</div>
      }
      else
      {
      <div class="perf-kpi-foot">Approved purchase invoices, less approved debit notes</div>
      }
    </div>
    }
  </div>

  <div class="perf-chart">
    <div class="perf-chart-head">
      <h3 class="perf-chart-h">Monthly trend, @p.Year</h3>
      <span class="perf-cap">Gross profit is the accented line. Purchases is dashed.</span>
    </div>
    <div class="perf-legend">
      @foreach (var sr in c.Series)
      {
      <span class="perf-leg">
        <span class="perf-key @(sr.Var == "pur" ? "dashed" : "")" style="background:var(--s-@(sr.Var));color:var(--s-@(sr.Var));"></span>
        @sr.Label <b>@A(p.Totals.Of(sr.Key))</b>
      </span>
      }
    </div>

    <div class="perf-plot">
      <svg class="perf-svg" id="perf-svg" viewBox="0 0 @R(c.ViewW) @R(c.ViewH)"
           role="img" aria-label="Monthly revenue, purchases and gross profit for @p.Year">
        @foreach (var t in c.Ticks)
        {
        <line class="perf-grid" x1="@R(c.PadL)" y1="@R(t.Y)" x2="@R(c.PlotR)" y2="@R(t.Y)"/>
        @Html.Raw($"<text class=\"perf-tick\" x=\"{R(c.PadL - 8)}\" y=\"{R(t.Y + 3)}\" text-anchor=\"end\">{A(t.V)}</text>")
        }
        @if (c.ZeroY != c.PlotB)
        {
        <line class="perf-zero" x1="@R(c.PadL)" y1="@R(c.ZeroY)" x2="@R(c.PlotR)" y2="@R(c.ZeroY)"/>
        }
        @foreach (var col in c.Cols)
        {
        @Html.Raw($"<text class=\"perf-xlab\" x=\"{R(col.X)}\" y=\"{R(c.ViewH - 8)}\" text-anchor=\"middle\">{col.Name}</text>")
        }

        @foreach (var sr in c.Series)
        {
        <polyline class="perf-line" data-s="@sr.Var" points="@sr.Points" style="stroke:var(--s-@(sr.Var))"/>
        }
        @* Point markers ride the two solid series only. *@
        @foreach (var sr in c.Series.Where(s => s.Var != "pur"))
        {
          foreach (var dot in sr.Dots)
          {
        <circle class="perf-pt" cx="@R(dot.X)" cy="@R(dot.Y)" r="2.6" style="fill:var(--s-@(sr.Var))"/>
          }
        }

        @* One direct label, on the series the chart is about. *@
        <text class="perf-endlab" x="@R(gp.Last.X - 6)" y="@R(gp.Last.Y - 9)" text-anchor="end">@A(p.Months[11].Gross)</text>

        @foreach (var sr in c.Series)
        {
        <circle class="perf-hover-dot" data-s="@sr.Key" cx="0" cy="0" r="4" style="fill:var(--s-@(sr.Var))"/>
        }
        <line class="perf-cross" id="perf-cross" x1="0" y1="@R(c.PadT)" x2="0" y2="@R(c.PlotB)"/>
        @foreach (var col in c.Cols)
        {
        <rect class="perf-hit" data-i="@col.I" x="@R(col.X - c.Band / 2)" y="@R(c.PadT)"
              width="@R(c.Band)" height="@R(c.PlotH)"/>
        }
      </svg>
      <div class="perf-tip" id="perf-tip" role="status" aria-live="polite"></div>
    </div>

    <details class="perf-table-wrap">
      <summary>Show the numbers</summary>
      <table class="perf-table">
        <thead><tr><th>Month</th>@foreach (var sr in c.Series) {<th>@sr.Label</th>}</tr></thead>
        <tbody>
          @foreach (var m in p.Months)
          {
          <tr><td>@m.Name</td>@foreach (var sr in c.Series) {<td>@A(m.Of(sr.Key))</td>}</tr>
          }
        </tbody>
        <tfoot><tr><th>Total</th>@foreach (var sr in c.Series) {<th>@A(p.Totals.Of(sr.Key))</th>}</tr></tfoot>
      </table>
    </details>
  </div>
</section>
@section Scripts {
<script id="perf-data" type="application/json">@Html.Raw(Model.ChartJson)</script>
<script>
/* Crosshair + tooltip for the performance chart. An SVG chart that cannot be
   interrogated point-by-point makes the reader estimate values off gridlines,
   so the hover layer is part of the chart rather than an enhancement.
   Everything it needs is in the JSON block above â€” no refetch, no library. */
(function () {
  var svg = document.getElementById("perf-svg");
  var tip = document.getElementById("perf-tip");
  var cross = document.getElementById("perf-cross");
  var raw = document.getElementById("perf-data");
  if (!svg || !tip || !cross || !raw) return;

  var data = JSON.parse(raw.textContent);
  var dots = {};
  svg.querySelectorAll(".perf-hover-dot").forEach(function (d) {
    dots[d.getAttribute("data-s")] = d;
  });

  function show(i) {
    var col = data.cols[i];
    if (!col) return;
    cross.setAttribute("x1", col.x);
    cross.setAttribute("x2", col.x);
    cross.style.opacity = "1";

    var rows = "";
    data.series.forEach(function (s) {
      var pt = s.dots[i];
      var d = dots[s.key];
      if (d) {
        d.setAttribute("cx", pt.x);
        d.setAttribute("cy", pt.y);
        d.style.opacity = "1";
      }
      rows += '<div class="perf-tip-r"><span class="k" style="background:var(--s-'
        + s.var + ')"></span><span class="n">' + s.label
        + '</span><span class="v">' + pt.text + "</span></div>";
    });
    tip.innerHTML = '<div class="perf-tip-m">' + col.name + " " + data.year
      + "</div>" + rows;
    tip.classList.add("on");

    /* The SVG scales to its container, so a viewBox x has to be converted to
       CSS pixels before it can position an HTML tooltip. */
    var box = svg.getBoundingClientRect();
    var scale = box.width / data.view_w;
    var left = col.x * scale + 14;
    if (left + tip.offsetWidth > box.width) left = col.x * scale - tip.offsetWidth - 14;
    tip.style.left = Math.max(0, left) + "px";
    tip.style.top = "6px";
  }

  function hide() {
    cross.style.opacity = "0";
    tip.classList.remove("on");
    Object.keys(dots).forEach(function (k) { dots[k].style.opacity = "0"; });
  }

  svg.querySelectorAll(".perf-hit").forEach(function (r) {
    var i = +r.getAttribute("data-i");
    r.addEventListener("mouseenter", function () { show(i); });
    r.addEventListener("touchstart", function (e) { show(i); e.preventDefault(); },
                       { passive: false });
  });
  svg.addEventListener("mouseleave", hide);
})();
</script>
}
