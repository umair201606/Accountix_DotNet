@model Accountix.Platform.Controllers.AuthController.SignupModel
@{ Layout = null; }
<!doctype html>
<html lang="en" data-ui="v2">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%232B7263'/><text x='16' y='22' font-size='18' font-family='Arial' font-weight='bold' text-anchor='middle' fill='white'>A</text></svg>">
<title>Request Access — Accountix ERP</title>
<partial name="_V2Head" />
<partial name="_Antiforgery" />
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: Inter, "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
    background: var(--v2-ground);
    color: var(--v2-body);
    font-size: 13px;
    line-height: 1.5;
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 24px;
    -webkit-font-smoothing: antialiased;
  }
  a { text-decoration: none; }

  .shell { width: 100%; max-width: 480px; }

  .brand { display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 24px; }
  .brand-mark {
    width: 36px; height: 36px; border-radius: 9px;
    background: var(--v2-ink); color: var(--v2-ground);
    display: grid; place-items: center;
    font-size: 16px; font-weight: 600;
  }
  .brand-name { color: var(--v2-ink); font-size: 16px; font-weight: 600; letter-spacing: -.02em; }

  /* (0,2,0): ui.css styles .card at the same specificity, so a plain .card
     here would lose its padding and radius to it (§2). */
  .shell .card { background: var(--v2-surface); border: 1px solid var(--v2-line);
                 border-radius: 12px; box-shadow: none; overflow: hidden;
                 padding: 0; margin: 0; }
  .card-head { padding: 24px 28px 0; }
  .card-tag {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 3px 9px; border-radius: 6px;
    background: var(--v2-accent-soft); color: var(--v2-accent-ink);
    font-size: 11.5px; font-weight: 500;
  }
  .card-title { margin-top: 12px; font-size: 21px; line-height: 1.3; font-weight: 600;
                color: var(--v2-ink); letter-spacing: -.02em; }
  .card-desc { margin-top: 6px; color: var(--v2-muted); font-size: 12.5px; line-height: 1.55; }

  .flash { margin: 0 28px; padding: 10px 12px; border-radius: 8px; font-size: 12.5px;
           font-weight: 400; display: flex; align-items: center; gap: 8px; }
  .flash.error, .flash.danger { background: var(--v2-neg-bg); color: var(--v2-neg); }
  .flash.success { background: var(--v2-pos-bg); color: var(--v2-pos); }
  .flash.info { background: var(--v2-accent-soft); color: var(--v2-accent-ink); }

  form { padding: 20px 28px 28px; }
  .field { margin-bottom: 14px; }
  .field label { display: block; margin-bottom: 5px; font-size: 12px; font-weight: 500;
                 color: var(--v2-muted); }
  .field input, .field textarea {
    width: 100%; padding: 10px 12px; font: inherit; font-size: 13px;
    border: 1px solid var(--v2-line-2); border-radius: 8px;
    background: var(--v2-surface); color: var(--v2-ink); outline: none;
    transition: border-color .15s ease;
  }
  .field textarea { resize: vertical; min-height: 60px; }
  .field input::placeholder, .field textarea::placeholder { color: var(--v2-faint); }
  .field input:focus, .field textarea:focus { border-color: var(--v2-accent); }
  .field .hint { font-size: 11.5px; color: var(--v2-faint); margin-top: 4px; }
  .field .error-msg { font-size: 11.5px; color: var(--v2-neg); margin-top: 4px; display: none; }
  .field input.input-error { border-color: var(--v2-neg); }

  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

  /* The one filled button on the page: the committing action (§5). */
  .submit-btn {
    width: 100%; padding: 11px 20px; border: 1px solid var(--v2-ink); border-radius: 8px;
    background: var(--v2-ink); color: var(--v2-ground);
    font: inherit; font-size: 13.5px; font-weight: 500; cursor: pointer;
    transition: background .15s ease; margin-top: 4px;
  }
  .submit-btn:hover { background: var(--v2-ink-2); }
  .submit-btn:disabled { opacity: .6; cursor: not-allowed; }

  .success-state { padding: 28px; text-align: center; }
  .success-icon {
    width: 52px; height: 52px; border-radius: 50%;
    background: var(--v2-pos-bg); color: var(--v2-pos);
    display: grid; place-items: center; font-size: 22px; margin: 0 auto 14px;
  }
  .success-state h3 { font-size: 16px; font-weight: 600; color: var(--v2-ink); }
  .success-state p { margin-top: 6px; color: var(--v2-muted); font-size: 12.5px; }

  .foot {
    padding: 14px 28px; background: var(--v2-hover);
    border-top: 1px solid var(--v2-line);
    font-size: 12.5px; color: var(--v2-muted);
    display: flex; justify-content: space-between; align-items: center;
    gap: 12px; flex-wrap: wrap;
  }
  .foot a { font-weight: 500; color: var(--v2-accent); }
  .foot a:hover { text-decoration: underline; }

  @@media (max-width: 480px) {
    body { padding: 16px; }
    .card-head, form, .foot { padding-left: 20px; padding-right: 20px; }
    .flash { margin: 0 20px; }
    .field-row { grid-template-columns: 1fr; }
    .brand-name { font-size: 15px; }
    .card-title { font-size: 18px; }
  }
</style>
</head>
<body>
<partial name="_ThemeToggle" view-data="@(new ViewDataDictionary(ViewData) { ["ThemeFloat"] = true })" />

<div class="shell">
  <div class="brand">
    <span class="brand-mark">A</span>
    <span class="brand-name">Accountix ERP</span>
  </div>

  <div class="card">
    <div class="card-head">
      <span class="card-tag">Get started</span>
      <h1 class="card-title">Request platform access</h1>
      <p class="card-desc">Submit your details and a platform operator will review your request. You'll be able to sign in once approved.</p>
    </div>

    <partial name="_Flash" />

    @if (Model.Submitted) {
    <div class="success-state">
      <div class="success-icon">&#10003;</div>
      <h3>Request submitted</h3>
      <p>Your access request has been received. A platform operator will review it shortly. You can sign in once approved.</p>
    </div>
    } else {
    <form method="POST" asp-antiforgery="true" action="/signup" id="signupForm" novalidate>
      <div class="field-row">
        <div class="field">
          <label for="full_name">Full name *</label>
          <input type="text" id="full_name" name="full_name" required autocomplete="name"
                 placeholder="Your full name" value="@Model.Get("full_name")">
        </div>
        <div class="field">
          <label for="email">Email *</label>
          <input type="email" id="email" name="email" required autocomplete="email"
                 placeholder="you@@example.com" value="@Model.Get("email")">
          <p class="error-msg" id="email-error">This email is already registered or has a pending request.</p>
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="password">Password *</label>
          <input type="password" id="password" name="password" required minlength="8" autocomplete="new-password"
                 placeholder="At least 8 characters">
        </div>
        <div class="field">
          <label for="phone">Phone</label>
          <input type="tel" id="phone" name="phone" autocomplete="tel"
                 placeholder="+92 300 1234567" value="@Model.Get("phone")">
          <p class="error-msg" id="phone-error">This phone number is already in use.</p>
        </div>
      </div>
      <div class="field">
        <label for="company_name">Company name</label>
        <input type="text" id="company_name" name="company_name" autocomplete="organization"
               placeholder="Optional — the company you work for" value="@Model.Get("company_name")">
      </div>
      <div class="field">
        <label for="notes">Notes</label>
        <textarea id="notes" name="notes" rows="2"
                  placeholder="Optional — anything the operator should know">@Model.Get("notes")</textarea>
      </div>
      <button type="submit" class="submit-btn" id="submitBtn">Submit request</button>
    </form>
    }

    <div class="foot">
      <a href="/auth/login">&larr; Back to sign in</a>
      <a href="/">Home</a>
    </div>
  </div>
</div>

<script>
(function () {
  var form = document.getElementById('signupForm');
  if (!form) return;

  var emailInput = document.getElementById('email');
  var phoneInput = document.getElementById('phone');
  var emailError = document.getElementById('email-error');
  var phoneError = document.getElementById('phone-error');
  var submitBtn = document.getElementById('submitBtn');
  var checkTimeout = null;

  function showError(el, msgEl, show) {
    el.classList.toggle('input-error', show);
    msgEl.style.display = show ? 'block' : 'none';
  }

  function validateField(field, errorEl, type) {
    var value = field.value.trim();
    if (!value && type === 'phone') { showError(field, errorEl, false); return; }
    if (!value) return;

    clearTimeout(checkTimeout);
    checkTimeout = setTimeout(function () {
      var url = type === 'email'
        ? '/signup/check-email?email=' + encodeURIComponent(value)
        : '/signup/check-phone?phone=' + encodeURIComponent(value);
      fetch(url).then(function (r) { return r.json(); }).then(function (data) {
        showError(field, errorEl, data.exists);
      });
    }, 300);
  }

  emailInput.addEventListener('blur', function () {
    validateField(emailInput, emailError, 'email');
  });
  emailInput.addEventListener('input', function () {
    showError(emailInput, emailError, false);
  });
  phoneInput.addEventListener('blur', function () {
    validateField(phoneInput, phoneError, 'phone');
  });
  phoneInput.addEventListener('input', function () {
    showError(phoneInput, phoneError, false);
  });

  form.addEventListener('submit', function (e) {
    if (emailInput.classList.contains('input-error') || phoneInput.classList.contains('input-error')) {
      e.preventDefault();
    }
  });
})();
</script>

<script src="/static/js/theme.js"></script>
</body>
</html>
