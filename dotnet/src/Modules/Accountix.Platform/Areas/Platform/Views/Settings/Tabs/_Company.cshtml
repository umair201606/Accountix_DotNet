@model SettingsController.SettingsPage
@{ var ci = (CompanyInfo)Model.TabModel!; }
<div class="set-card">
  <h3>Company Profile</h3>
  <p class="hint">Appears on invoice, voucher and financial-report letterheads.</p>
  <form method="POST" asp-antiforgery="true" action="/settings/company">
    <div class="fgrid">
      <div class="fgroup">
        <label class="lbl">Company Name</label>
        <input type="text" name="company_name" class="inp" value="@J.Or(ci.CompanyName, "")">
      </div>
      <div class="fgroup">
        <label class="lbl">Logo URL</label>
        <input type="text" name="logo_url" class="inp" value="@J.Or(ci.LogoUrl, "")" placeholder="https://...">
      </div>
      <div class="fgroup">
        <label class="lbl">Phone</label>
        <input type="text" name="phone" class="inp" value="@J.Or(ci.Phone, "")">
      </div>
      <div class="fgroup">
        <label class="lbl">Email</label>
        <input type="email" name="email" class="inp" value="@J.Or(ci.Email, "")">
      </div>
      <div class="fgroup">
        <label class="lbl">Website</label>
        <input type="text" name="website" class="inp" value="@J.Or(ci.Website, "")">
      </div>
      <div class="fgroup">
        <label class="lbl">Tax ID / NTN</label>
        <input type="text" name="tax_id" class="inp" value="@J.Or(ci.TaxId, "")">
      </div>
      <div class="fgroup">
        <label class="lbl">Registration Number</label>
        <input type="text" name="registration_number" class="inp" value="@J.Or(ci.RegistrationNumber, "")">
      </div>
      <div class="fgroup">
        <label class="lbl">City</label>
        <input type="text" name="city" class="inp" value="@J.Or(ci.City, "")">
      </div>
      <div class="fgroup">
        <label class="lbl">State / Province</label>
        <input type="text" name="state" class="inp" value="@J.Or(ci.State, "")">
      </div>
      <div class="fgroup">
        <label class="lbl">Country</label>
        <input type="text" name="country" class="inp" value="@J.Or(ci.Country, "Pakistan")">
      </div>
    </div>
    <div class="fgroup">
      <label class="lbl">Address</label>
      <textarea name="address" class="inp" rows="2">@J.Or(ci.Address, "")</textarea>
    </div>

    <div style="border-top:1px solid var(--line);margin:16px 0 14px;padding-top:14px;">
      <div style="font-size:11px;font-weight:700;color:var(--muted);margin-bottom:10px;">Bank Details</div>
      <div style="font-size:11.5px;color:var(--muted);margin:-4px 0 10px;">Printed beside the totals on a sales invoice, so a customer knows where to send payment.</div>
      <div class="fgrid">
        <div class="fgroup">
          <label class="lbl">Bank Name</label>
          <input type="text" name="bank_name" class="inp" value="@J.Or(ci.BankName, "")">
        </div>
        <div class="fgroup">
          <label class="lbl">Account Title</label>
          <input type="text" name="bank_account_title" class="inp" value="@J.Or(ci.BankAccountTitle, "")">
        </div>
        <div class="fgroup">
          <label class="lbl">Account Number / IBAN</label>
          <input type="text" name="bank_account_number" class="inp" value="@J.Or(ci.BankAccountNumber, "")">
        </div>
      </div>
    </div>

    <div style="border-top:1px solid var(--line);margin:16px 0 14px;padding-top:14px;">
      <div style="font-size:11px;font-weight:700;color:var(--muted);margin-bottom:10px;">Locale &amp; Fiscal Year</div>
      <div class="fgrid">
        <div class="fgroup">
          <label class="lbl">Currency Code</label>
          <input type="text" name="currency" class="inp" value="@J.Or(ci.Currency, "PKR")">
        </div>
        <div class="fgroup">
          <label class="lbl">Currency Symbol</label>
          <input type="text" name="currency_symbol" class="inp" value="@J.Or(ci.CurrencySymbol, "Rs.")">
        </div>
        <div class="fgroup">
          <label class="lbl">Fiscal Year Starts</label>
          <select name="fiscal_year_start_month" class="sel">
            @for (int i = 0; i < SettingsController.Months.Length; i++) {
            <option value="@(i + 1)" selected="@(ci.FiscalYearStartMonth == i + 1)">@SettingsController.Months[i]</option>
            }
          </select>
        </div>
        <div class="fgroup">
          <label class="lbl">Date Format</label>
          <select name="date_format" class="sel">
            @foreach (var (f, lbl) in new[] { ("Y-m-d", "2026-07-17"), ("d/m/Y", "17/07/2026"), ("m/d/Y", "07/17/2026"), ("d-M-Y", "17-Jul-2026") }) {
            <option value="@f" selected="@(ci.DateFormat == f)">@lbl (@f)</option>
            }
          </select>
        </div>
        <div class="fgroup">
          <label class="lbl">Timezone</label>
          <input type="text" name="timezone" class="inp" value="@J.Or(ci.Timezone, "Asia/Karachi")">
        </div>
      </div>
    </div>

    <div class="set-actions">
      <button type="submit" class="btn btn-p">Save Company Profile</button>
    </div>
  </form>
</div>
