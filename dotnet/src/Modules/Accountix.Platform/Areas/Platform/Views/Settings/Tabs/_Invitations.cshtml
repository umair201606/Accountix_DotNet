@model SettingsController.SettingsPage
@{ var t = (IReadOnlyList<(CompanyInvitation Inv, string? Company, string Role)>)Model.TabModel!; }
<div class="set-card">
  <h3>Invitations</h3>
  <p class="hint">Companies have invited you to join as a member. Accepting switches your active company to theirs.</p>

  @if (t.Count > 0) {
  <div class="tbl-scroll">
    <table class="stbl inv-tbl">
      <thead>
        <tr><th>Company</th><th>Role</th><th>Invited</th><th></th></tr>
      </thead>
      <tbody>
        @foreach (var (inv, cname, role) in t) {
        <tr>
          <td class="m-cell-user">
            <div class="r-name">@if (cname is not null) {@cname} else {@Html.Raw("&mdash;")}</div>
            <div class="r-email">@inv.Email</div>
          </td>
          <td data-label="Role"><span class="pill pill-off">@ViewHelpers.Title(role)</span></td>
          <td data-label="Invited">@if (inv.CreatedAt is DateTime ca) {@ca.ToString("yyyy-MM-dd")} else {@Html.Raw("&mdash;")}</td>
          <td data-label="Actions">
            <div class="m-acts">
              <form method="POST" asp-antiforgery="true" action="/settings/invitations/@inv.Id/accept" style="display:inline;" onsubmit="return confirm('Join ' + @System.Text.Json.JsonSerializer.Serialize(cname) + ' as a member?');">
                <button type="submit" class="btn btn-sm btn-primary">Accept</button>
              </form>
              <form method="POST" asp-antiforgery="true" action="/settings/invitations/@inv.Id/decline" style="display:inline;">
                <button type="submit" class="btn btn-sm btn-outline">Decline</button>
              </form>
            </div>
          </td>
        </tr>
        }
      </tbody>
    </table>
  </div>
  } else {
  <p style="color:var(--muted);font-size:13px;padding:8px 0;">You have no pending invitations.</p>
  }
</div>
<style>
  .m-acts { display: flex; flex-wrap: wrap; gap: 6px; }
  .m-acts .btn { font-size: 11px; padding: 5px 10px; }
  @@media (max-width: 768px) {
    .inv-tbl, .inv-tbl thead, .inv-tbl tbody, .inv-tbl tr, .inv-tbl th, .inv-tbl td { display: block; }
    .inv-tbl thead { display: none; }
    .inv-tbl tr { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 12px; margin-bottom: 10px; }
    .inv-tbl td { border: none !important; padding: 3px 0 !important; }
    .inv-tbl td[data-label]:before { content: attr(data-label) ": "; font-weight: 700; font-size: 10.5px; color: var(--muted); display: inline; margin-right: 4px; }
    .m-cell-user { margin-bottom: 6px; }
    .m-cell-user:before { display: none !important; }
    .m-acts { margin-top: 8px; }
  }
</style>
