@model SettingsModel
@{
    ViewData["Title"] = "Executive Report Settings";
    ViewData["Heading"] = "Executive Report Settings";
    // accounts|groupby('type'): sorted by type (stable), assets and liabilities only.
    var sections = Model.Accounts.Where(a => a.Type is "asset" or "liability")
        .GroupBy(a => a.Type).OrderBy(g => g.Key, StringComparer.Ordinal).ToList();
    var rows = Model.Accounts.Where(a => a.Type is "asset" or "liability")
        .Select(a => new { id = a.Id, name = a.Name, code = a.Code, type = a.Type, level = a.Level, pid = a.ParentId, kids = a.HasChildren });
    string rowsJson = System.Text.Json.JsonSerializer.Serialize(rows);
}
@section Head {
<partial name="_Style" />
}
<div class="exr @(Model.CanEdit ? "" : "is-ro")">

  <p class="exr-count" style="margin-bottom:14px;">
    Tick accounts on the left and they appear on the right the moment you do.
    Mark <strong>Sub-accounts</strong> on a parent to tell the reports to read
    everything beneath it too. The right pane lists the level-5 accounts that
    show up in the receivable and payable pages &mdash; nothing else.
  </p>

  <form method="POST">
    <div class="exr-picker">

      @* Left pane: the whole chart *@
      <section class="exr-pane" aria-label="All accounts">
        <div class="exr-pane-head">
          <span class="exr-pane-title">All accounts</span>
          <span class="exr-pane-sub" id="exrLeftCount">0 picked</span>
        </div>
        <div class="exr-pane-scroll">
          <div class="exr-search-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <input type="search" id="exrSearchLeft" class="exr-search" placeholder="Search accounts or codes" autocomplete="off" aria-label="Search all accounts">
          </div>
          <div class="exr-tree">
            @foreach (var group in sections)
            {
                var list = group.ToList();
            <section class="exr-section" data-type="@group.Key">
              <button type="button" class="exr-section-head" aria-expanded="true" data-total="@list.Count">
                <span class="exr-section-name">@ViewHelpers.Title(group.Key)</span>
                <span class="exr-section-count" data-total="@list.Count">@list.Count(a => a.Selected) of @list.Count selected</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </button>
              @foreach (var a in list)
              {
              <div class="exr-node @(a.Selected ? "is-on" : "") @(a.Selected ? "is-picked" : "") @(a.HasChildren ? "" : "is-leaf")"
                   data-id="@a.Id" data-lvl="@a.Level"
                   style="--lvl:@(a.Level - 1);">
                @if (a.HasChildren)
                {
                <button type="button" class="exr-caret" aria-expanded="true"
                        aria-label="Collapse @a.Name">&#9660;</button>
                }
                else
                {
                <span class="exr-caret is-void" aria-hidden="true"></span>
                }
                <label class="exr-node-check" for="acct@(a.Id)">
                  <input type="checkbox" name="account" value="@a.Id"
                         id="acct@(a.Id)" checked="@a.Selected"
                         disabled="@(!Model.CanEdit)">
                  <span class="exr-checkbox" aria-hidden="true"></span>
                  <span class="exr-node-name">@a.Name</span>
                </label>
                <span class="exr-node-sub">@a.Code &middot; level @a.Level</span>
                @if (a.HasChildren)
                {
                <label class="exr-deep @(a.Selected ? "" : "is-off")" for="deep@(a.Id)">
                  <input type="checkbox" name="deep" value="@a.Id"
                         id="deep@(a.Id)" checked="@(a.Selected && a.IncludeChildren)"
                         disabled="@(!Model.CanEdit)">
                  <span class="exr-switch" aria-hidden="true"></span>
                  <span class="exr-deep-label">Sub-accounts</span>
                </label>
                }
              </div>
              }
            </section>
            }
            @if (sections.Count == 0)
            {
            <div class="exr-empty">
              <strong>No chart of accounts yet</strong>
              <p>Set up the chart of accounts first; these reports read balances
                from it.</p>
            </div>
            }
          </div>
        </div>
      </section>

      @* Right pane: live scope preview *@
      <section class="exr-pane" aria-label="Accounts in scope">
        <div class="exr-pane-head">
          <span class="exr-pane-title">In scope</span>
          <span class="exr-pane-sub" id="exrRightCount">0 accounts</span>
        </div>
        <div class="exr-pane-scroll">
          <div class="exr-search-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <input type="search" id="exrSearchRight" class="exr-search" placeholder="Filter selection" autocomplete="off" aria-label="Filter selected accounts">
          </div>
          <div class="exr-pick" id="exrPickList" aria-live="polite">
            <div class="exr-pick-empty">
              <strong>Nothing at level 5</strong>
              Tick a parent with <strong>Sub-accounts</strong>, or pick a
              level-5 account directly.
            </div>
          </div>
        </div>
      </section>

    </div>

    @if (Model.CanEdit && Model.Accounts.Count > 0)
    {
    <div class="exr-savebar">
      <span class="exr-save-note" id="exrSaveNote">Nothing in scope yet — the
        receivable and payable pages will both be empty.</span>
      <button type="submit" class="btn btn-primary">Save selection</button>
    </div>
    }
  </form>
</div>

<script>
(function () {
  var ROWS = @Html.Raw(rowsJson);
  var byId = {}, kids = {};
  ROWS.forEach(function (r) {
    byId[r.id] = r;
    if (r.pid) (kids[r.pid] = kids[r.pid] || []).push(r.id);
  });

  var leftIn = document.getElementById('exrSearchLeft');
  var rightIn = document.getElementById('exrSearchRight');
  var pickList = document.getElementById('exrPickList');
  var rightCount = document.getElementById('exrRightCount');
  var leftCount = document.getElementById('exrLeftCount');
  var saveNote = document.getElementById('exrSaveNote');

  var esc = function (s) {
    return String(s).replace(/[&<>"']/g, function (c) {
      return {'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[c];
    });
  };
  var descOf = function (id) {
    var out = [], st = [id];
    while (st.length) {
      var n = st.pop();
      (kids[n] || []).forEach(function (c) { out.push(c); st.push(c); });
    }
    return out;
  };
  var pickedOf = function (name) {
    var out = [];
    document.querySelectorAll('.exr-node input[name="' + name + '"]:checked')
      .forEach(function (i) { out.push(+i.value); });
    return out;
  };

  function effective() {
    var deep = {}, eff = {};
    pickedOf('deep').forEach(function (i) { deep[i] = 1; });
    pickedOf('account').forEach(function (id) {
      eff[id] = 0;
      var r = byId[id];
      if (r && r.kids && deep[id]) {
        descOf(id).forEach(function (c) { if (!(c in eff)) eff[c] = id; });
      }
    });
    return eff;
  }

  function renderRight() {
    var picked = pickedOf('account');
    var eff = effective();
    var lvl5 = [], k;
    for (k in eff) {
      var r = byId[k];
      if (r && r.level === 5) lvl5.push(r);
    }
    rightCount.textContent = lvl5.length + (lvl5.length === 1 ? ' account' : ' accounts');
    if (saveNote) {
      saveNote.textContent = lvl5.length
        ? lvl5.length + ' level-5 account' + (lvl5.length === 1 ? '' : 's') +
          ' in scope for the receivable and payable pages.'
        : (picked.length
          ? 'Nothing at level 5 — tick a parent with Sub-accounts, or pick a level-5 account directly.'
          : 'Nothing in scope yet — the receivable and payable pages will both be empty.');
    }
    var term = rightIn.value.trim().toLowerCase();
    var groups = {}, order = [];
    lvl5.forEach(function (r) {
      if (term && r.name.toLowerCase().indexOf(term) === -1 &&
          r.code.toLowerCase().indexOf(term) === -1) return;
      if (!groups[r.type]) { groups[r.type] = []; order.push(r.type); }
      groups[r.type].push(r);
    });
    var html = '';
    if (!order.length) {
      html = '<div class="exr-pick-empty"><strong>' +
        (lvl5.length ? 'No matches for &ldquo;' + esc(term) + '&rdquo;' : 'Nothing at level 5') +
        '</strong>' + (lvl5.length
          ? 'Try another name or code, or clear the filter.'
          : 'Tick a parent with <strong>Sub-accounts</strong>, or pick a level-5 account directly.') + '</div>';
    }
    order.forEach(function (t) {
      var g = groups[t];
      html += '<div class="exr-pick-type">' + esc(t) +
        ' <span class="exr-pick-type-n">' + g.length + '</span></div>';
      g.forEach(function (r) {
        html += '<div class="exr-pick-row">' +
          '<span class="exr-pick-name" title="' + esc(r.name) + '">' + esc(r.name) + '</span>' +
          '<span class="exr-pick-code">' + esc(r.code) + '</span>' +
          '</div>';
      });
    });
    pickList.innerHTML = html;
  }

  function computeMatches(term) {
    var selfM = {}, hasD = {};
    ROWS.forEach(function (r) {
      selfM[r.id] = !term ||
        r.name.toLowerCase().indexOf(term) !== -1 ||
        r.code.toLowerCase().indexOf(term) !== -1;
    });
    for (var i = ROWS.length - 1; i >= 0; i--) {
      var r = ROWS[i], d = false;
      (kids[r.id] || []).forEach(function (c) { if (hasD[c]) d = true; });
      hasD[r.id] = selfM[r.id] || d;
    }
    return {selfM: selfM, hasD: hasD};
  }

  function applyLeft() {
    var term = leftIn.value.trim().toLowerCase();
    var m = computeMatches(term);
    var sections = document.querySelectorAll('.exr-section');
    sections.forEach(function (sec) {
      var nodes = sec.querySelectorAll('.exr-node');
      var num = 0;
      var openStack = [];
      nodes.forEach(function (n) {
        var id = +n.dataset.id, show;
        if (term) {
          show = m.hasD[id];
          n.classList.toggle('exr-ghost', show && !m.selfM[id]);
        } else {
          while (openStack.length && openStack[openStack.length - 1] >= +n.dataset.lvl) {
            openStack.pop();
          }
          show = openStack.length === 0 && !sec.classList.contains('is-close');
          if (show && n.querySelector('.exr-caret') &&
              n.querySelector('.exr-caret').getAttribute('aria-expanded') === 'false') {
            openStack.push(+n.dataset.lvl);
          }
        }
        n.classList.toggle('exr-is-hidden', !show);
        if (show) num++;
      });
      sec.classList.toggle('exr-is-hidden', num === 0);
      if (term) sec.classList.remove('is-close');
    });
  }

  function counts() {
    var picked = pickedOf('account');
    leftCount.textContent = picked.length + (picked.length === 1 ? ' picked' : ' picked');
    document.querySelectorAll('.exr-section').forEach(function (sec) {
      var total = +sec.querySelector('.exr-section-head').dataset.total;
      var sel = 0;
      sec.querySelectorAll('input[name="account"]:checked').forEach(function () { sel++; });
      sec.querySelector('.exr-section-count').textContent =
        sel + ' of ' + total + ' selected';
    });
  }

  function syncRow(node) {
    var box = node.querySelector('input[name="account"]');
    var picked = box.checked;
    node.classList.toggle('is-on', picked);
    node.classList.toggle('is-picked', picked);
    var deep = node.querySelector('.exr-deep');
    if (deep) {
      var dp = deep.querySelector('input');
      if (picked) dp.checked = true;
      else dp.checked = false;
      deep.classList.toggle('is-off', !picked);
    }
  }

  document.querySelector('.exr-tree').addEventListener('change', function (e) {
    var t = e.target;
    var node = t.closest('.exr-node');
    if (!node) return;
    if (t.name === 'account') syncRow(node);
    counts(); applyLeft(); renderRight();
  });

  document.querySelector('.exr-tree').addEventListener('click', function (e) {
    var caret = e.target.closest('.exr-caret');
    if (caret && !caret.classList.contains('is-void')) {
      var open = caret.getAttribute('aria-expanded') === 'true';
      caret.setAttribute('aria-expanded', open ? 'false' : 'true');
      caret.setAttribute('aria-label', (open ? 'Expand ' : 'Collapse ') + 'account');
      applyLeft();
      return;
    }
    var head = e.target.closest('.exr-section-head');
    if (head) {
      var sec = head.closest('.exr-section');
      var closed = sec.classList.toggle('is-close');
      head.setAttribute('aria-expanded', closed ? 'false' : 'true');
      applyLeft();
    }
  });

  leftIn.addEventListener('input', applyLeft);
  rightIn.addEventListener('input', renderRight);

  document.querySelectorAll('.exr-caret[aria-expanded]').forEach(function (c) {
    if (!c.classList.contains('is-void') && +c.closest('.exr-node').dataset.lvl >= 4) {
      c.setAttribute('aria-expanded', 'false');
      c.setAttribute('aria-label', 'Expand account');
    }
  });

  counts(); applyLeft(); renderRight();
})();
</script>
