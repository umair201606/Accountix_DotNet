@model Accountix.Inventory.Controllers.ProductListModel
@using Accountix.Inventory.Services
@{
    ViewData["Title"] = "Products";
    ViewData["Heading"] = "Products";
}
<div class="page-header">
  <div style="display:flex;gap:8px;flex-wrap:wrap;">
    <a href="/inventory/products/create" class="btn btn-primary">+ New Product</a>
    <a href="/inventory/products/template" class="btn btn-outline btn-sm">Download Template</a>
    <form method="POST" action="/inventory/products/upload-excel" enctype="multipart/form-data" style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;max-width:100%;">
      <input type="file" name="file" accept=".xlsx" required class="form-control" style="width:auto;padding:4px 8px;font-size:12px;">
      <button type="submit" class="btn btn-outline btn-sm">Import Excel</button>
    </form>
  </div>
</div>
<div class="card">
  <div class="card-body" style="padding-bottom:8px;">
    <form method="GET" class="search-form">
      <input type="text" name="q" class="form-control focus-ring" placeholder="Search by name or SKU..." value="@Model.Q" style="width:300px;max-width:100%;display:inline-block;">
      <select name="category_id" class="form-control focus-ring" style="width:200px;max-width:100%;display:inline-block;">
        <option value="">All Categories</option>
        @foreach (var c in Model.Categories)
        {
        <option value="@c.Id" selected="@(Model.CategoryId == c.Id.ToString())">@c.Name</option>
        }
      </select>
      <button type="submit" class="btn btn-outline">Search</button>
    </form>
  </div>
  <div class="table-responsive">
    <table class="table">
      <thead><tr><th>SKU</th><th>Name</th><th>Category</th><th>Stock</th><th>Reorder</th><th>Price</th><th>Status</th><th>Actions</th></tr></thead>
      <tbody>
        @foreach (var p in Model.Products)
        {
          bool low = (p.CurrentStock ?? 0) <= (p.ReorderLevel ?? 0) && (p.ReorderLevel ?? 0) > 0;
        <tr class="@(p.IsActive == true ? "" : "inactive-row")">
          <td><strong>@p.Sku</strong></td>
          <td>@p.Name</td>
          <td>@(p.CategoryId is int cid && Model.CategoryNames.TryGetValue(cid, out var cname) ? cname : "-")</td>
          <td>
            <span class="badge @(low ? "badge-danger" : "badge-success")">
              @MasterData.Qty(p.CurrentStock)
            </span>
          </td>
          <td>@(p.ReorderLevel?.ToString() ?? "None")</td>
          <td>@Html.Amount(p.UnitPrice, 0)</td>
          <td><span class="badge @(p.IsActive == true ? "badge-success" : "badge-secondary")">@(p.IsActive == true ? "Active" : "Inactive")</span></td>
          <td class="actions">
            <a href="/inventory/products/edit/@p.Id" class="btn btn-sm btn-outline">Edit</a>
            <a href="/inventory/products/adjust-stock/@p.Id" class="btn btn-sm btn-outline">Stock</a>
            <a href="/inventory/vouchers/product-ledger?product_id=@p.Id" class="btn btn-sm btn-link" style="color:var(--accent);">Ledger</a>
            <form method="POST" action="/inventory/products/delete/@p.Id" style="display:inline;" onsubmit="return confirm('Delete this product?')"><button type="submit" class="btn btn-sm btn-danger">Delete</button></form>
          </td>
        </tr>
        }
        @if (Model.Products.Count == 0)
        {
        <tr><td colspan="8" class="empty">No products</td></tr>
        }
      </tbody>
    </table>
  </div>
</div>
