@using Accountix.Inventory.Services
@model Accountix.Inventory.Services.InventoryReports.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Heading"] = "Dashboard";
}
<div class="page-fade">
  <!-- Stats -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon" style="background:var(--accent-light);color:var(--accent);">P</div>
      <div class="stat-body">
        <div class="stat-value">@Model.TotalProducts</div>
        <div class="stat-label">Products</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:var(--accent-light);color:var(--accent);">C</div>
      <div class="stat-body">
        <div class="stat-value">@Model.TotalCategories</div>
        <div class="stat-label">Categories</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:var(--warning-light);color:var(--warning);">$</div>
      <div class="stat-body">
        <div class="stat-value">@Html.Amount(Model.TotalStockValue, 0)</div>
        <div class="stat-label">Stock Value</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:var(--danger-light);color:var(--danger);">!</div>
      <div class="stat-body">
        <div class="stat-value @(Model.LowStock > 0 ? "text-danger" : "")">@Model.LowStock</div>
        <div class="stat-label">Low Stock</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:var(--warning-light);color:var(--warning);">V</div>
      <div class="stat-body">
        <div class="stat-value">@Model.PendingVouchers</div>
        <div class="stat-label">Pending Vouchers</div>
      </div>
    </div>
  </div>

  <!-- Alerts -->
  <div class="alert-grid">
    @if (Model.LowStock > 0)
    {
    <div class="alert-card alert-danger">
      <strong>@Model.LowStock</strong> product@(Model.LowStock != 1 ? "s" : "") below reorder level &mdash; <a href="/inventory/reports/low-stock">Report</a>
    </div>
    }
    @if (Model.PendingVouchers > 0)
    {
    <div class="alert-card alert-warning">
      <strong>@Model.PendingVouchers</strong> unapproved voucher@(Model.PendingVouchers != 1 ? "s" : "") pending approval &mdash; <a href="/inventory/vouchers/consumption/list">View</a>
    </div>
    }
  </div>

  <div class="row" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:20px;margin-top:20px;">
    <!-- Recent Products -->
    <div class="card">
      <div class="card-header"><h3>Recent Products</h3></div>
      <div class="card-body" style="padding:0;">
        <table class="table">
          <thead><tr><th>SKU</th><th>Name</th><th>Stock</th><th>Price</th></tr></thead>
          <tbody>
            @foreach (var p in Model.RecentProducts)
            {
            <tr>
              <td>@p.Sku</td>
              <td>@p.Name</td>
              <td><span class="badge @((p.CurrentStock ?? 0) <= (p.ReorderLevel ?? 0) ? "badge-danger" : "badge-success")">@PyText.Qty(p.CurrentStock)</span></td>
              <td>@Html.Amount(p.UnitPrice, 0)</td>
            </tr>
            }
            @if (Model.RecentProducts.Count == 0)
            {
            <tr><td colspan="4" class="empty">No products yet</td></tr>
            }
          </tbody>
        </table>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="card">
      <div class="card-header"><h3>Quick Actions</h3></div>
      <div class="card-body">
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,130px),1fr));gap:8px;">
          <a href="/inventory/products/create" class="btn btn-primary" style="text-align:center;">+ Product</a>
          <a href="/inventory/stock/" class="btn btn-outline" style="text-align:center;">Stock Movements</a>
          <a href="/inventory/vouchers/adjustment" class="btn btn-outline" style="text-align:center;">+ Adjustment</a>
          <a href="/inventory/vouchers/consumption" class="btn btn-outline" style="text-align:center;">+ Consumption</a>
          <a href="/inventory/vouchers/scrap" class="btn btn-outline" style="text-align:center;">+ Scrap</a>
          <a href="/inventory/vouchers/stock-take" class="btn btn-outline" style="text-align:center;">+ Stock Take</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Voucher Stats -->
  <div class="row" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));gap:16px;margin-top:20px;">
    <a href="/inventory/vouchers/consumption/list" class="stat-card" style="text-decoration:none;cursor:pointer;">
      <div class="stat-icon" style="background:var(--accent-light);color:var(--accent);">C</div>
      <div class="stat-body">
        <div class="stat-value">@Model.ConsumptionCount</div>
        <div class="stat-label">Consumptions</div>
      </div>
    </a>
    <a href="/inventory/vouchers/scrap/list" class="stat-card" style="text-decoration:none;cursor:pointer;">
      <div class="stat-icon" style="background:var(--warning-light);color:var(--warning);">S</div>
      <div class="stat-body">
        <div class="stat-value">@Model.ScrapCount</div>
        <div class="stat-label">Scraps</div>
      </div>
    </a>
    <a href="/inventory/vouchers/adjustment/list" class="stat-card" style="text-decoration:none;cursor:pointer;">
      <div class="stat-icon" style="background:var(--accent-light);color:var(--accent);">A</div>
      <div class="stat-body">
        <div class="stat-value">@Model.AdjustmentCount</div>
        <div class="stat-label">Adjustments</div>
      </div>
    </a>
    <a href="/inventory/vouchers/stock-take/list" class="stat-card" style="text-decoration:none;cursor:pointer;">
      <div class="stat-icon" style="background:var(--danger-light);color:var(--danger);">T</div>
      <div class="stat-body">
        <div class="stat-value">@Model.StockTakeCount</div>
        <div class="stat-label">Stock Takes</div>
      </div>
    </a>
  </div>
</div>

<style>
.alert-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; margin: 16px 0; }
.alert-card { padding: 12px 18px; border-radius: 8px; font-size: 14px; font-weight: 500; }
.alert-warning { background: var(--warning-light); color: var(--warning); border: 1px solid var(--warning); }
.alert-info { background: var(--accent-light); color: var(--accent); border: 1px solid var(--accent); }
.alert-danger { background: var(--danger-light); color: var(--danger); border: 1px solid var(--danger); }
.text-danger { color: var(--danger) !important; }
</style>
