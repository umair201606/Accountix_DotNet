@using Accountix.Inventory.Services
@model List<Accountix.Inventory.Services.InventoryReports.LowRow>
@{
    ViewData["Title"] = "Low Stock Alert";
    ViewData["Heading"] = "Low Stock Alert";
}
@section Actions {
@if (Model.Count > 0) { <partial name="_ExportButtons" model='new ExportButtons("excel", "pdf", "csv")' /> }
}
<div class="card">
  <div class="card-header"><strong>Products at or below Reorder Level</strong></div>
  <div class="card-body">
    @if (Model.Count > 0)
    {
    <table class="table">
      <thead><tr><th>SKU</th><th>Product</th><th>Current Stock</th><th>Reorder Level</th><th>Unit</th><th>Status</th></tr></thead>
      <tbody>
        @foreach (var p in Model)
        {
        bool outOfStock = p.CurrentStock == 0;
        <tr>
          <td>@p.Sku</td>
          <td>@p.Name</td>
          <td>@PyText.Qty(p.CurrentStock)</td>
          <td>@(p.ReorderLevel?.ToString() ?? "None")</td>
          <td>@PyText.Str(p.Unit)</td>
          <td><span class="badge @(outOfStock ? "badge-danger" : "badge-warning")">@(outOfStock ? "Out of Stock" : "Low Stock")</span></td>
        </tr>
        }
      </tbody>
    </table>
    }
    else
    {
    <p class="text-muted">All products are adequately stocked.</p>
    }
  </div>
</div>
