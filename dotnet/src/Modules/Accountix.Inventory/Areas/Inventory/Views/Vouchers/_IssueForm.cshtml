@model Accountix.Inventory.Controllers.VoucherFormModel
@using System.Globalization
@*
  vouchers/consumption_form.html and vouchers/scrap_form.html (the same page;
  consumption adds the department and its own wording).
*@
@{
    bool cons = Model.Kind == "consumption";
    string vtype = cons ? "CONS" : "SCRAP";
    string slug = cons ? "consumption" : "scrap";
    string Inv(decimal? d) => (d ?? 0m).ToString(CultureInfo.InvariantCulture);
}
<partial name="_GlEntryButton" model="new GlEntryButton(vtype, Model.Id)" />
<form method="POST" class="voucher-form">
  @if (Model.Approved)
  {
  <div class="vf-locked">Approved and posted@(Model.ApprovedAt is DateTime at ? " on " + at.ToString("dd MMM yyyy", CultureInfo.InvariantCulture) : "") — read only. Unapprove to make changes.</div>
  }
  <fieldset class="vf-fieldset" disabled="@Model.Approved">
  <div class="card">
    <div class="card-body">
      <div class="form-row">
        @if (cons)
        {
        <div class="form-group">
          <label>Department</label>
          <input type="text" name="department" class="form-control" value="@(Model.Department ?? "")" required>
        </div>
        }
        <div class="form-group">
          <label>Reason</label>
          <textarea name="reason" class="form-control" rows="2" required>@(Model.Reason ?? "")</textarea>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Charge To Ledger Account</label>
          <select name="charge_account_id" class="form-control">
            <option value="">@(cons ? "Consumption Expense (default)" : "Scrap / Write-off Expense (default)")</option>
            @foreach (var a in Model.Accounts)
            {
            <option value="@a.Id" selected="@(Model.ChargeAccountId == a.Id)">@a.Code — @a.Name</option>
            }
          </select>
          @if (cons)
          {
          <small style="display:block;margin-top:4px;color:var(--muted);">The consumed value (at automatic historic cost) is transferred from the product's inventory ledger to this account — e.g. an employee's account when charging them for damage.</small>
          }
          else
          {
          <small style="display:block;margin-top:4px;color:var(--muted);">The scrapped value (at automatic historic cost) is charged to this account — e.g. an employee's or insurer's receivable account.</small>
          }
        </div>
      <partial name="_VoucherMeta" model="Model.Meta" />
      </div>
    </div>
  </div>

  <div class="card">
    @if (cons)
    {
    <div class="card-header"><strong>Items</strong> <span class="badge badge-info" style="background:var(--accent);color:var(--card);">Consumption</span></div>
    }
    else
    {
    <div class="card-header"><strong>Items</strong> <span class="badge badge-warning">Scrap</span></div>
    }
    <div class="card-body">
      <div class="vf-table-wrap"><table class="table" id="items-table">
        <thead><tr><th>Product</th><th>Qty</th><th>Unit Cost</th><th>Total</th><th></th></tr></thead>
        <tbody id="items-body">
          @foreach (var item in Model.Items)
          {
          <tr>
            <td><input type="hidden" name="product_id[]" value="@item.ProductId"><input type="text" class="form-control product-auto" value="@item.ProductName" readonly></td>
            <td><input type="number" step="any" name="qty[]" class="form-control" value="@Inv(item.Quantity)"></td>
            <td><input type="text" class="form-control" value="@Inv(item.UnitCost)" readonly></td>
            <td><input type="text" class="form-control" value="@Inv(item.TotalCost)" readonly></td>
            <td><button type="button" class="btn btn-sm btn-danger" onclick="this.closest('tr').remove()">X</button></td>
          </tr>
          }
        </tbody>
      </table></div>
      <button type="button" class="btn btn-outline" onclick="addRow()">+ Add Item</button>
    </div>
  </div>
  </fieldset>
  @if (!Model.Exists)
  {
  <div class="form-actions">
    <button type="submit" class="btn btn-primary" onclick="this.form.status.value='unapproved'">Save as draft</button>
    <button type="submit" class="btn btn-success" onclick="this.form.status.value='approved'">Save &amp; approve</button>
    <a href="/inventory/vouchers/@slug/list" class="btn btn-outline">Cancel</a>
  </div>
  }
  else if (Model.Approved)
  {
  <div class="form-actions">
    <button type="submit" class="btn btn-warning" formnovalidate
            formaction="/inventory/vouchers/@slug/@Model.Id/unapprove"
            onclick="return confirm('Unapprove @Model.Number? Its stock and journal are reversed and later issues re-costed.')">Unapprove</button>
    <a href="/inventory/vouchers/preview/@vtype/@Model.Id" target="_blank" class="btn btn-outline">Print</a>
    <a href="/inventory/vouchers/@slug/list" class="btn btn-outline">Back</a>
  </div>
  }
  else
  {
  <div class="form-actions">
    <button type="submit" class="btn btn-primary" onclick="this.form.status.value='unapproved'">Save</button>
    <button type="submit" class="btn btn-success" onclick="this.form.status.value='approved'">Approve</button>
    <a href="/inventory/vouchers/preview/@vtype/@Model.Id" target="_blank" class="btn btn-outline">Print</a>
    <button type="submit" class="btn btn-danger" formnovalidate
            formaction="/inventory/vouchers/@slug/@Model.Id/delete"
            onclick="return confirm('Delete @Model.Number?')">Delete</button>
    <a href="/inventory/vouchers/@slug/list" class="btn btn-outline">Cancel</a>
  </div>
  }
</form>

<script>
function addRow(data) {
  data = data || {};
  var tr = document.createElement('tr');
  tr.innerHTML = '<td><input type="hidden" name="product_id[]" value="'+(data.id||'')+'">'
    + '<input type="text" class="form-control product-auto" placeholder="@(cons ? "Search product..." : "Search...")" data-id="'+(data.id||'')+'" value="'+(data.name||'')+'"></td>'
    + '<td><input type="number" step="any" name="qty[]" class="form-control" value="'+(data.qty||'')+'"></td>'
    + '<td><input type="text" class="form-control cost-display" readonly value="0"></td>'
    + '<td><input type="text" class="form-control total-display" readonly value="0"></td>'
    + '<td><button type="button" class="btn btn-sm btn-danger" onclick="this.closest(\'tr\').remove()">X</button></td>';
  document.getElementById('items-body').appendChild(tr);
  attachAutocomplete(tr.querySelector('.product-auto'));
}
function attachAutocomplete(el) {
  var timer;
  el.addEventListener('input', function() {
    clearTimeout(timer);
    var val = this.value;
    timer = setTimeout(function() {
      if(val.length < 2) return;
      fetch('/inventory/vouchers/api/products?q='+encodeURIComponent(val))
        .then(r=>r.json()).then(data => {
          if(data.length === 1) { selectProduct(el, data[0]); return; }
          var list = document.createElement('datalist');
          list.id = 'suggest-'+Date.now();
          data.forEach(p => {
            var opt = document.createElement('option');
            opt.value = p.name + ' ('+p.sku+')';
            opt.dataset.id = p.id;
@if (cons)
{
<text>            opt.dataset.stock = p.stock;
</text>
}
            list.appendChild(opt);
          });
          document.body.appendChild(list);
          el.setAttribute('list', list.id);
        });
    }, 300);
  });
  el.addEventListener('change', function() {
    var opt = document.querySelector('option[value="'+this.value+'"]');
    if(opt) selectProduct(this, {id:opt.dataset.id, name:this.value});
  });
}
function selectProduct(el, p) {
  el.value = p.name;
  el.dataset.id = p.id;
  el.closest('tr').querySelector('[name="product_id[]"]').value = p.id;
  fetch('/inventory/vouchers/api/product-stock/'+p.id)
    .then(r=>r.json()).then(d => {
      var tr = el.closest('tr');
      tr.querySelector('.cost-display').value = d.cost;
    });
}
document.addEventListener('DOMContentLoaded', function() {
  var existing = document.querySelectorAll('.product-auto');
  existing.forEach(function(el) { attachAutocomplete(el); });
  if (existing.length === 0) addRow({});
});
document.addEventListener('keydown',function(e){if((e.key==='ArrowUp'||e.key==='ArrowDown')&&e.target.type==='number'){e.preventDefault()}});
</script>
