@model Accountix.Inventory.Controllers.UnitFormModel
@{
    string mode = Model.Unit is null ? "New" : "Edit";
    ViewData["Title"] = $"{mode} Unit";
    ViewData["Heading"] = $"{mode} Unit";
    string exclude = Model.Unit?.Id.ToString() ?? "";
}
@section Head {
<style>
  .field-wrap{position:relative}
  .field-err{font-size:11.5px;color:var(--danger);margin-top:3px;display:none}
  .field-err.show{display:block}
  .field-ok{font-size:11.5px;color:var(--success);margin-top:3px;display:none}
  .field-ok.show{display:block}
  .field-wrap .form-control.err{border-color:var(--danger);background:var(--danger-light)}
  .field-wrap .form-control.ok{border-color:var(--success);background:var(--success-light)}
</style>
}
<div class="card" style="max-width:600px;">
  <form method="POST" class="form">
    <div class="form-group">
      <div class="field-wrap">
        <label>Name *</label>
        <input type="text" name="name" id="fieldName" class="form-control focus-ring" required
               value="@(Model.Name ?? Model.Unit?.Name)" data-exclude="@exclude">
        <div class="field-err" id="nameErr"></div>
        <div class="field-ok" id="nameOk">Name is available</div>
      </div>
    </div>
    <div class="form-group">
      <div class="field-wrap">
        <label>Abbreviation *</label>
        <input type="text" name="abbreviation" id="fieldAbbr" class="form-control focus-ring" required
               value="@(Model.Abbreviation ?? Model.Unit?.Abbreviation)" maxlength="20"
               placeholder="e.g. kg, pcs, m" data-exclude="@exclude">
        <div class="field-err" id="abbrErr"></div>
        <div class="field-ok" id="abbrOk">Abbreviation is available</div>
      </div>
    </div>
    <div class="form-group">
      <label>Explanation</label>
      <textarea name="explanation" class="form-control focus-ring" rows="3"
                placeholder="Optional description of the unit">@((Model.Explanation ?? Model.Unit?.Explanation) is { Length: > 0 } ex ? ex : "")</textarea>
    </div>
    @if (Model.Unit is not null)
    {
    <div class="form-group">
      <label><input type="checkbox" name="is_active" checked="@(Model.Unit.IsActive == true)"> Active</label>
    </div>
    }
    <div class="form-actions">
      <button type="submit" class="btn btn-primary" id="submitBtn">@(Model.Unit is null ? "Create" : "Update")</button>
      <a href="/inventory/units/" class="btn btn-outline">Cancel</a>
    </div>
  </form>
</div>

<script>
(function(){
  var nameInp = document.getElementById('fieldName');
  var abbrInp = document.getElementById('fieldAbbr');
  var nameErr = document.getElementById('nameErr');
  var nameOk = document.getElementById('nameOk');
  var abbrErr = document.getElementById('abbrErr');
  var abbrOk = document.getElementById('abbrOk');

  if (!nameInp || !abbrInp) return;

  function check(field, inp, errEl, okEl) {
    var val = inp.value.trim();
    var exclude = inp.getAttribute('data-exclude') || '';

    errEl.classList.remove('show');
    okEl.classList.remove('show');
    inp.classList.remove('err', 'ok');

    if (!val) return;

    var url = '/inventory/units/check?field=' + encodeURIComponent(field) + '&value=' + encodeURIComponent(val);
    if (exclude) url += '&exclude=' + encodeURIComponent(exclude);

    fetch(url, { credentials: 'same-origin' })
      .then(function(r){
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.json();
      })
      .then(function(d){
        if (d.exists) {
          errEl.textContent = 'This ' + field + ' is already taken.';
          errEl.classList.add('show');
          inp.classList.add('err');
          inp.classList.remove('ok');
        } else {
          okEl.classList.add('show');
          inp.classList.add('ok');
          inp.classList.remove('err');
        }
      })
      .catch(function(e){
        console.warn('Unit check failed:', e);
      });
  }

  var timers = {};
  function debounceCheck(field, inp, errEl, okEl) {
    var key = field;
    clearTimeout(timers[key]);
    timers[key] = setTimeout(function(){ check(field, inp, errEl, okEl); }, 400);
  }

  nameInp.addEventListener('input', function(){ debounceCheck('name', nameInp, nameErr, nameOk); });
  abbrInp.addEventListener('input', function(){ debounceCheck('abbreviation', abbrInp, abbrErr, abbrOk); });

  if (nameInp.value.trim()) check('name', nameInp, nameErr, nameOk);
  if (abbrInp.value.trim()) check('abbreviation', abbrInp, abbrErr, abbrOk);
})();
</script>
