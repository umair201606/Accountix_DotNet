@model List<AssetTransfer>
@{
    ViewData["Title"] = "Inventory to FA Transfers";
    ViewData["Heading"] = "Transfers to Fixed Assets";
}
@section Actions {
<a href="/inventory/transfer-to-fa/create" class="btn btn-primary">+ New Transfer</a>
}
<div class="card">
  <div class="card-body">
    @if (Model.Count > 0)
    {
    <div class="table-responsive">
    <table class="table">
      <thead><tr><th>Voucher #</th><th>Asset</th><th>Amount</th><th>Status</th><th>Created</th><th></th></tr></thead>
      <tbody>
        @foreach (var t in Model)
        {
        <tr>
          <td>@t.VoucherNumber</td>
          <td>@(t.Asset?.Name ?? "N/A")</td>
          <td>@Py.Comma(t.TransferAmount)</td>
          <td><span class="badge @(t.Status == "approved" ? "badge-success" : "badge-warning")">@t.Status</span></td>
          <td>@(t.CreatedAt?.ToString("yyyy-MM-dd") ?? "")</td>
          <td style="white-space:nowrap;">
            @if (t.Status == "approved")
            {
            <form method="POST" style="display:inline;" onsubmit="return confirm('Unapprove and reverse this transfer?')"
                  action="/inventory/transfer-to-fa/@t.Id/unapprove">
              <button type="submit" class="btn btn-sm btn-warning">Unapprove</button>
            </form>
            }
            else
            {
            <a href="/inventory/transfer-to-fa/@t.Id/edit" class="btn btn-sm btn-outline">Open</a>
            <form method="POST" style="display:inline;" onsubmit="return confirm('Delete this transfer?')"
                  action="/inventory/transfer-to-fa/@t.Id/delete">
              <button type="submit" class="btn btn-sm btn-danger">Delete</button>
            </form>
            }
          </td>
        </tr>
        }
      </tbody>
    </table>
    </div>
    }
    else
    {
    <p class="text-muted">No transfers yet. <a href="/inventory/transfer-to-fa/create">Create one</a>.</p>
    }
  </div>
</div>
