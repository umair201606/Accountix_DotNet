@model AssetFormModel
@{
    var asset = Model.Asset;
    string verb = asset is not null ? "Edit" : "New";
    ViewData["Title"] = $"{verb} Asset";
    ViewData["Heading"] = $"{verb} Asset";
    var choices = Model.Choices!;
}
<div class="card" style="max-width:720px;">
  <div class="card-body">
    <form method="POST">
      <div class="form-group">
        <label class="form-label">Asset Name *</label>
        <input type="text" name="name" class="form-control" value="@(asset?.Name ?? "")" required>
      </div>
      <div class="form-group">
        <label class="form-label">Description</label>
        <textarea name="description" class="form-control" rows="3">@(asset?.Description ?? "")</textarea>
      </div>
      <div class="form-row" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
        <div class="form-group">
          <label class="form-label">Category *</label>
          <select name="category_id" id="fa-category" class="form-control" required>
            <option value="">Select category</option>
            @foreach (var c in Model.Categories)
            {
            <option value="@c.Id" data-life="@(c.DefaultUsefulLife is int l && l != 0 ? l.ToString() : "")"
                    data-method="@(c.DefaultDepreciationMethod ?? "")"
                    data-salvage-pct="@Py.Repr(Py.F(c.DefaultSalvageValuePct))"
                    selected="@(asset is not null && asset.CategoryId == c.Id)">@c.Name</option>
            }
          </select>
          @if (asset is null) {<small class="text-muted">Fills in the category's usual life, method and salvage; change them if this asset differs.</small>}
        </div>
        <div class="form-group">
          <label class="form-label">Purchase Date *</label>
          <input type="date" name="purchase_date" class="form-control" value="@(asset is not null ? Py.Date(asset.PurchaseDate) : "")" required>
        </div>
        <div class="form-group">
          <label class="form-label">Purchase Cost *</label>
          <input type="number" step="0.01" min="0.01" name="purchase_cost" id="fa-cost" class="form-control" value="@(asset is not null ? Py.Repr(Py.F(asset.PurchaseCost)) : "")" required>
        </div>
        <div class="form-group">
          <label class="form-label">Useful Life (years) *</label>
          <input type="number" min="1" max="100" name="useful_life" id="fa-life" class="form-control" value="@(asset?.UsefulLife.ToString() ?? "5")" required>
        </div>
        <div class="form-group">
          <label class="form-label">Depreciation Method</label>
          <select name="depreciation_method" id="fa-method" class="form-control">
            <option value="straight_line" selected="@(asset is null || asset.DepreciationMethod == "straight_line")">Straight line</option>
            <option value="declining_balance" selected="@(asset is not null && asset.DepreciationMethod == "declining_balance")">Reducing balance (double-declining, then straight line)</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Salvage Value</label>
          <input type="number" step="0.01" min="0" name="salvage_value" id="fa-salvage" class="form-control" value="@(asset is not null ? Py.Repr(Py.F(asset.SalvageValue)) : "0")">
        </div>
      </div>
      <div class="form-row" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
        <div class="form-group">
          <label class="form-label">Location</label>
          <input type="text" name="location" class="form-control" value="@(asset?.Location ?? "")">
        </div>
        <div class="form-group">
          <label class="form-label">Assigned To</label>
          <input type="text" name="assigned_to" class="form-control" value="@(asset?.AssignedTo ?? "")">
        </div>
        <div class="form-group">
          <label class="form-label">Vendor</label>
          <input type="text" name="vendor" class="form-control" value="@(asset?.Vendor ?? "")">
        </div>
        <div class="form-group">
          <label class="form-label">Serial Number</label>
          <input type="text" name="serial_number" class="form-control" value="@(asset?.SerialNumber ?? "")">
        </div>
        <div class="form-group">
          <label class="form-label">Project label</label>
          <select name="label_id" class="form-control">
            <option value="">— None —</option>
            @foreach (var l in Model.Labels)
            {
            <option value="@l.Id" selected="@(asset is not null && asset.LabelId == l.Id)">@l.Name</option>
            }
          </select>
          <small style="display:block;margin-top:4px;color:var(--muted);">Depreciation of this asset is charged to the label's P&amp;L.</small>
        </div>
      </div>
      <hr><h4>Chart of Accounts Mapping</h4>
      <p class="text-muted" style="font-size:.85rem;">Each list offers only accounts of the right kind: the asset under Property, Plant &amp; Equipment (or Intangibles), accumulated depreciation under its own head, an expense account, and a payable, bank or cash account for what paid for it.</p>
      <div class="form-row" style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;">
        <div class="form-group">
          <label class="form-label">Fixed Asset Account</label>
          <select name="fixed_asset_account_id" class="form-control">
            <option value="">Default (Fixed Assets — General)</option>
            @foreach (var a in choices.Fa)
            {
            <option value="@a.Id" selected="@(asset is not null && asset.FixedAssetAccountId == a.Id)">@a.Code @a.Name</option>
            }
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Accum. Depreciation Account</label>
          <select name="accum_dep_account_id" class="form-control">
            <option value="">Default (this asset's own account)</option>
            @foreach (var a in choices.Accum)
            {
            <option value="@a.Id" selected="@(asset is not null && asset.AccumDepAccountId == a.Id)">@a.Code @a.Name</option>
            }
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Depreciation Expense Account</label>
          <select name="dep_expense_account_id" class="form-control">
            <option value="">Default (Depreciation Expense)</option>
            @foreach (var a in choices.Expense)
            {
            <option value="@a.Id" selected="@(asset is not null && asset.DepExpenseAccountId == a.Id)">@a.Code @a.Name</option>
            }
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Paid From / Credit Account</label>
          <select name="acquisition_credit_account_id" class="form-control">
            <option value="">Default (Trade Creditors — General)</option>
            @foreach (var a in choices.Credit)
            {
            <option value="@a.Id" selected="@(asset is not null && asset.AcquisitionCreditAccountId == a.Id)">@a.Code @a.Name</option>
            }
          </select>
          <small class="text-muted">Credited when the asset is booked to the ledger — a payable, cash or bank account.</small>
        </div>
      </div>
      @if (asset is not null)
      {
      <div class="form-group">
        <label class="form-label">Status</label>
        <div class="form-control" style="background:transparent;">@ViewHelpers.Title(asset.Status)</div>
        <small class="text-muted">Changes only through Dispose / Undo disposal or a transfer, so the ledger moves with it. Changing life, salvage or method re-plans the remaining depreciation from today.</small>
      </div>
      }
      <div class="form-group">
        <label class="form-label">Notes</label>
        <textarea name="notes" class="form-control" rows="2">@(asset?.Notes ?? "")</textarea>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">@(asset is not null ? "Update" : "Create") Asset</button>
        <a href="/fixed-assets/assets/" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
@if (asset is null)
{
<script>
(function () {
  // A category's usual life, method and salvage % (they were stored on the
  // category and never used by the form).
  var cat = document.getElementById('fa-category'), cost = document.getElementById('fa-cost'),
      life = document.getElementById('fa-life'), method = document.getElementById('fa-method'),
      salvage = document.getElementById('fa-salvage'), touched = false;
  if (!cat) return;
  salvage.addEventListener('input', function () { touched = true; });
  function apply() {
    var o = cat.options[cat.selectedIndex];
    if (!o || !o.value) return;
    if (o.dataset.life) life.value = o.dataset.life;
    if (o.dataset.method) method.value = o.dataset.method;
    var pct = parseFloat(o.dataset.salvagePct || '0'), c = parseFloat(cost.value || '0');
    if (!touched) salvage.value = (c > 0 ? (c * pct / 100) : 0).toFixed(2);
  }
  cat.addEventListener('change', apply);
  cost.addEventListener('input', function () { if (!touched) apply(); });
})();
</script>
}
