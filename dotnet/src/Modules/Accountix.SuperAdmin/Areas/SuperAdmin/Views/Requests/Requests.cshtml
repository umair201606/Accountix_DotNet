@model RequestsController.ListModel
@{
    ViewData["Title"] = "Access Requests - Super Admin";
}

<h1 class="sa-page-title">Access Requests</h1>

@if (Model.PendingCount > 0)
{
<div class="sa-stats" style="margin-bottom:24px;">
  <div class="sa-stat" style="border-left: 3px solid var(--warning);">
    <div class="sa-stat-value" style="color:var(--warning);">@Model.PendingCount</div>
    <div class="sa-stat-label">Pending Review</div>
  </div>
  <div class="sa-stat" style="border-left: 3px solid var(--success);">
    <div class="sa-stat-value" style="color:var(--success);">@Model.ApprovedCount</div>
    <div class="sa-stat-label">Approved</div>
  </div>
  <div class="sa-stat" style="border-left: 3px solid var(--danger);">
    <div class="sa-stat-value" style="color:var(--danger);">@Model.BlockedCount</div>
    <div class="sa-stat-label">Blocked</div>
  </div>
</div>
}

@if (Model.Requests.Count > 0)
{
<div class="sa-card">
  <div class="sa-card-header">
    <div>
      <h3 class="sa-card-title">All Requests</h3>
      <p class="sa-card-subtitle">Review, approve or block visitor registration requests. Approving creates the account and lets them sign in.</p>
    </div>
  </div>
  <div class="tbl-wrap">
    <table class="sa-tbl">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Phone</th>
          <th>Company</th>
          <th>Requested</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        @foreach (var r in Model.Requests)
        {
        bool fresh = !r.Seen && r.Status == "pending";
        <tr class="@(fresh ? "sa-row-new" : "")" style="@(fresh ? "background:#fffbe6;" : "")">
          <td><strong>@r.FullName</strong></td>
          <td>@r.Email</td>
          <td>@(string.IsNullOrEmpty(r.Phone) ? "—" : r.Phone)</td>
          <td>@(string.IsNullOrEmpty(r.CompanyName) ? "—" : r.CompanyName)</td>
          <td style="white-space:nowrap;">@r.CreatedAt.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</td>
          <td>
            @switch (r.Status)
            {
              case "pending": <span class="pill pill-warning">pending</span> break;
              case "seen": <span class="pill pill-sa">seen</span> break;
              case "approved": <span class="pill pill-on">approved</span> break;
              case "blocked": <span class="pill pill-danger">blocked</span> break;
              default: <span class="pill pill-off">@r.Status</span> break;
            }
          </td>
          <td>
            @if (r.Status is "pending" or "seen")
            {
            <div style="display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end;">
              <form method="POST" action="/superadmin/requests/@r.Id/approve" asp-antiforgery="true">
                <button type="submit" class="btn btn-sm btn-p">Approve</button>
              </form>
              <form method="POST" action="/superadmin/requests/@r.Id/block" asp-antiforgery="true">
                <button type="submit" class="btn btn-sm btn-danger">Block</button>
              </form>
            </div>
            }
            else if (r.Status == "blocked")
            {
            <form method="POST" action="/superadmin/requests/@r.Id/unblock" asp-antiforgery="true">
              <button type="submit" class="btn btn-sm">Unblock</button>
            </form>
            }
            else if (r.Status == "approved")
            {
            <span style="font-size:12px;color:var(--text-muted);">Account created</span>
            }
          </td>
        </tr>
        @if (!string.IsNullOrEmpty(r.Notes))
        {
        <tr>
          <td colspan="7" style="padding:0 12px 8px;font-size:12px;color:var(--text-secondary);background:#fafbfc;">
            <strong>Note:</strong> @r.Notes
          </td>
        </tr>
        }
        }
      </tbody>
    </table>
  </div>
</div>
}
else
{
<div class="sa-card">
  <div class="empty-state">
    <div class="empty-state-icon" style="font-size:40px;">&#128233;</div>
    <p style="font-weight:600;color:var(--text);margin-bottom:4px;">No requests yet</p>
    <p style="max-width:400px;margin:0 auto;">When visitors request access, their submissions will appear here for review.</p>
  </div>
</div>
}
