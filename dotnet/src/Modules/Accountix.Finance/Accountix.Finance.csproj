<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <RootNamespace>Accountix.Finance</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Report files (IReportExport): ClosedXML (MIT) for Excel, PDFsharp-MigraDoc for PDF.
         PINNED to 6.2.4, the last MIT release: 6.5.0 and later are AGPL-3.0, which would oblige
         publishing the whole app's source to its users. Do not upgrade without a commercial licence. -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="[6.2.4]" />
    <!-- PDFsharp pulls 8.0.1, which has known advisories. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Accountix.Core\Accountix.Core.csproj" />
    <ProjectReference Include="..\..\Accountix.Web.Shared\Accountix.Web.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Accountix.Finance.Tests" />
  </ItemGroup>

</Project>
