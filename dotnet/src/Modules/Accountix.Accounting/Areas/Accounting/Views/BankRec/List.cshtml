@model Accountix.Accounting.Controllers.BankRecListModel
@using System.Globalization
@{
    ViewData["Title"] = "Bank Reconciliation - Accounting";
}
<div class="page-header">
  <div>
    <h1>Bank reconciliation</h1>
    <p class="br-sub">Match the cash book to the bank statement: tick what appears on the statement until the cleared balance equals the statement's closing balance. What is left is the reconciliation statement.</p>
  </div>
</div>

<div class="card" style="margin-bottom:16px;">
  <div class="card-header">New reconciliation</div>
  <form method="POST" action="/accounting/bank-reconciliation/new" class="br-form">
    <label>Account
      <select name="account_id" class="form-control" required>
        <option value="">Choose…</option>
        @foreach (var a in Model.Accounts) { <option value="@a.Id">@a.Code @a.Name</option> }
      </select>
    </label>
    <label>Statement date
      <input type="date" name="statement_date" class="form-control" value="@Model.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" required>
    </label>
    <label>Statement closing balance
      <input type="number" name="statement_balance" class="form-control" step="0.01" required>
    </label>
    <button type="submit" class="btn btn-primary">Start</button>
  </form>
</div>

<div class="card">
  <div class="card-header">Reconciliations</div>
  <div class="table-responsive">
    <table class="table">
      <thead><tr><th>Account</th><th>Statement date</th><th class="r">Statement balance</th><th>Status</th><th></th></tr></thead>
      <tbody>
      @foreach (var r in Model.Recs)
      {
        <tr>
          <td>@r.Account.Code @r.Account.Name</td>
          <td>@r.StatementDate.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)</td>
          <td class="r">@Html.Amount(r.StatementBalance)</td>
          <td><span class="badge badge-@(r.Status == "completed" ? "success" : "warning")">@r.Status</span></td>
          <td class="r"><a href="/accounting/bank-reconciliation/@r.Id" class="btn btn-sm btn-outline">Open</a></td>
        </tr>
      }
      @if (Model.Recs.Count == 0)
      {
        <tr><td colspan="5" class="text-center" style="color:var(--muted);">No reconciliations yet.</td></tr>
      }
      </tbody>
    </table>
  </div>
</div>
<style>
  .br-sub { font-size: 13px; color: var(--muted); margin: 4px 0 0; max-width: 720px; }
  .br-form { display: flex; gap: 10px; flex-wrap: wrap; align-items: flex-end; padding: 12px; }
  .br-form label { display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: var(--muted); }
  .br-form .form-control { min-width: 0; max-width: 100%; }
  .r { text-align: right; white-space: nowrap; }
</style>
