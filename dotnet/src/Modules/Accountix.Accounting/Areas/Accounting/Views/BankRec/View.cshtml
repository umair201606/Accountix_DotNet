@model Accountix.Accounting.Controllers.BankRecViewModel
@using System.Globalization
@{
    var rec = Model.Rec;
    var d = Model.D;
    var inv = CultureInfo.InvariantCulture;
    bool editable = rec.Status == "draft";
    ViewData["Title"] = $"Reconcile {rec.Account.Name} - Accounting";
}
<div class="page-header">
  <div>
    <a href="/accounting/bank-reconciliation" class="br-back">&larr; Bank reconciliation</a>
    <h1>@rec.Account.Code @rec.Account.Name &middot; @rec.StatementDate.ToString("dd MMM yyyy", inv)</h1>
    <span class="badge badge-@(rec.Status == "completed" ? "success" : "warning")">@rec.Status</span>
  </div>
  <div style="display:flex;gap:6px;flex-wrap:wrap;"><partial name="_ExportButtons" model="ExportButtons.Default" /></div>
</div>

<div class="stats-grid br-stats">
  <div class="stat-card"><div class="stat-label">Balance per books</div><div class="stat-value">@Html.Amount(d.Book)</div></div>
  <div class="stat-card"><div class="stat-label">Cleared balance</div><div class="stat-value" id="br-cleared">@Html.Amount(d.Cleared)</div></div>
  <div class="stat-card"><div class="stat-label">Statement balance</div><div class="stat-value">@Html.Amount(d.Statement)</div></div>
  <div class="stat-card"><div class="stat-label">Difference</div><div class="stat-value @(Math.Abs(d.Difference) < 0.005m ? "br-ok" : "br-bad")" id="br-diff">@Html.Amount(d.Difference)</div></div>
</div>

<form method="POST" action="/accounting/bank-reconciliation/@rec.Id/save">
<div class="card">
  <div class="card-header">Transactions to @rec.StatementDate.ToString("dd MMM yyyy", inv) not cleared before</div>
  @if (editable)
  {
  <div class="br-bar">
    <label>Statement closing balance
      <input type="number" step="0.01" name="statement_balance" id="br-statement" class="form-control" value="@d.Statement.ToString("0.00", inv)">
    </label>
    <span class="br-hint">Tick each line that appears on the statement.</span>
  </div>
  }
  <div class="table-responsive">
    <table class="table br-table">
      <thead><tr><th></th><th>Date</th><th>Voucher</th><th>Details</th><th class="r">Receipt</th><th class="r">Payment</th></tr></thead>
      <tbody>
      @foreach (var row in d.Rows)
      {
        var ln = row.Line;
        var je = row.Entry;
        <tr>
          <td><input type="checkbox" name="line_ids[]" value="@ln.Id" class="br-tick"
                     data-net="@((( ln.Debit ?? 0) - (ln.Credit ?? 0)).ToString("0.00", inv))"
                     checked="@d.Mine.Contains(ln.Id)" disabled="@(!editable)" aria-label="Cleared"></td>
          <td>@je.EntryDate.ToString("dd MMM yyyy", inv)</td>
          <td>@je.VoucherNumber</td>
          <td>@(string.IsNullOrEmpty(ln.Description) ? je.Description : ln.Description)</td>
          <td class="r">@((ln.Debit ?? 0) > 0 ? Html.Amount(ln.Debit) : "")</td>
          <td class="r">@((ln.Credit ?? 0) > 0 ? Html.Amount(ln.Credit) : "")</td>
        </tr>
      }
      @if (d.Rows.Count == 0)
      {
        <tr><td colspan="6" class="text-center" style="color:var(--muted);">Nothing to reconcile up to this date.</td></tr>
      }
      </tbody>
    </table>
  </div>
</div>
@if (editable)
{
<div class="br-actions">
  <button type="submit" name="action" value="save" class="btn btn-outline">Save</button>
  <button type="submit" name="action" value="complete" class="btn btn-primary">Complete</button>
</div>
}
</form>

<div class="card" style="margin-top:16px;">
  <div class="card-header">Bank reconciliation statement</div>
  <div class="table-responsive">
    <table class="table br-stmt">
      <tbody>
        <tr><td>Balance as per books</td><td class="r">@Html.Amount(d.Book)</td></tr>
        <tr><td>Add: payments not yet presented</td><td class="r">@Html.Amount(d.Unpresented)</td></tr>
        <tr><td>Less: deposits in transit</td><td class="r">(@Html.Amount(d.InTransit))</td></tr>
        <tr class="br-total"><td>Balance as per bank (books)</td><td class="r">@Html.Amount(d.BankPerBooks)</td></tr>
        <tr><td>Balance as per bank statement</td><td class="r">@Html.Amount(d.Statement)</td></tr>
      </tbody>
    </table>
  </div>
</div>

<div style="display:flex;gap:8px;margin-top:12px;flex-wrap:wrap;">
  @if (rec.Status == "completed")
  {
  <form method="POST" action="/accounting/bank-reconciliation/@rec.Id/reopen"><button class="btn btn-sm btn-outline">Reopen</button></form>
  }
  else
  {
  <form method="POST" action="/accounting/bank-reconciliation/@rec.Id/delete" onsubmit="return confirm('Delete this reconciliation?');"><button class="btn btn-sm btn-danger">Delete</button></form>
  }
</div>

<script>
(function () {
  var before = @d.ClearedBefore.ToString("0.00", inv), st = document.getElementById('br-statement');
  function money(v) { return v.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}); }
  function update() {
    var c = before;
    document.querySelectorAll('.br-tick:checked').forEach(function (b) { c += parseFloat(b.dataset.net); });
    var s = st ? parseFloat(st.value || '0') : @d.Statement.ToString("0.00", inv), diff = s - c;
    document.getElementById('br-cleared').textContent = money(c);
    var el = document.getElementById('br-diff');
    el.textContent = money(diff);
    el.className = 'stat-value ' + (Math.abs(diff) < 0.005 ? 'br-ok' : 'br-bad');
  }
  document.querySelectorAll('.br-tick').forEach(function (b) { b.addEventListener('change', update); });
  if (st) st.addEventListener('input', update);
})();
</script>
<style>
  .br-back { font-size: 13px; color: var(--muted); text-decoration: none; }
  .br-bar { display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap; padding: 10px 12px; }
  .br-bar label { display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: var(--muted); }
  .br-hint { font-size: 12px; color: var(--muted); }
  .br-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 10px; flex-wrap: wrap; }
  .br-ok { color: var(--success, #15803d); }
  .br-bad { color: var(--danger, #b91c1c); }
  .br-table td, .br-table th { white-space: nowrap; }
  .br-stmt .br-total td { font-weight: 600; border-top: 1px solid var(--line, rgba(127,127,127,.3)); }
  .r { text-align: right; white-space: nowrap; }
</style>
