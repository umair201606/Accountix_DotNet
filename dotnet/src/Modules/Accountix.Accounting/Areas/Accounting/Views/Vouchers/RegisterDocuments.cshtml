@model Accountix.Accounting.Controllers.DocumentsModel
@{
    Layout = null;
    string ExcelQuery()
    {
        var q = Context.Request.Query.Where(kv => kv.Key != "fmt").Select(kv => $"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(kv.Value.ToString())}").ToList();
        q.Add("fmt=excel");
        return string.Join("&", q);
    }
}
<!DOCTYPE html>
<html lang="en" data-ui="v2">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bulk Vouchers - @Model.Label</title>
<script>(function(){try{var t=localStorage.getItem("ax-theme");if(t==="dark"||t==="light")document.documentElement.setAttribute("data-theme",t);}catch(e){}})();</script>
<link rel="stylesheet" href="/static/css/app.css">
<link rel="stylesheet" href="/static/css/ui.css">
<style>
<partial name="_VoucherDocStyle" />

.toolbar{max-width:750px;margin:0 auto 20px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;position:relative;z-index:5001}
.toolbar .t{font-size:14px;font-weight:600;color:var(--v2-ink,#161616)}
.toolbar .s{font-size:12px;color:var(--v2-muted,#7c7c7a)}
.toolbar .b{display:flex;gap:8px;flex-wrap:wrap}
.bp:disabled{opacity:.45;cursor:not-allowed}
.doc + .doc{margin-top:28px}
@@media screen{
  .doc{content-visibility:auto;contain-intrinsic-size:auto 1200px}
}
.reg-progress{position:fixed;left:50%;bottom:20px;transform:translateX(-50%);z-index:5000;display:none;width:min(92vw,460px);background:var(--v2-surface,#fff);border:1px solid var(--v2-line-2,#dcdcda);border-radius:14px;padding:14px 16px;box-shadow:0 16px 44px rgba(0,0,0,.22)}
.reg-progress.open{display:block}
.reg-progress-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
.reg-progress-card h3{margin:0 0 3px;color:var(--v2-ink,#161616);font-size:14px}
.reg-progress-card p{margin:0;color:var(--v2-muted,#7c7c7a);font-size:12px;line-height:1.4}
.reg-pct{font-size:18px;font-weight:700;color:var(--v2-ink,#161616);font-variant-numeric:tabular-nums}
.reg-bar{height:8px;border-radius:999px;background:var(--v2-sunk,#f1f5f9);overflow:hidden;margin:10px 0 0}
.reg-bar > div{height:100%;width:0%;border-radius:999px;background:var(--v2-ink,#161616);transition:width .15s ease}
.reg-progress-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:10px;flex-wrap:wrap}
.reg-progress-foot .bx{padding:6px 12px;font-size:12px}
.reg-progress-foot .s{font-size:11.5px;color:var(--v2-muted,#7c7c7a)}
body[data-docs="loading"] #docList{padding-bottom:150px}
@@media (max-width:860px){
  body{padding:12px}
  .reg-progress{bottom:10px;width:calc(100vw - 24px)}
}
@@media print{
  .toolbar,.reg-progress{display:none}
  body{background:#fff}
  .doc + .doc{margin-top:0;page-break-before:always}
}
</style>
</head>
<body>
<div class="toolbar">
  <div>
    <div class="t">Bulk Vouchers (<span id="docCount">@(Model.Docs?.Count ?? 0)</span>)</div>
    <div class="s">@Model.Label</div>
    <div class="s" id="docStatus" aria-live="polite"></div>
  </div>
  <div class="b" id="docActions">
    <button type="button" class="bp" id="printAllBtn" onclick="window.print()"
      @Html.Raw(Model.Docs is { Count: > 0 } ? "" : "disabled title=\"Wait until the vouchers have loaded\"")>Print All</button>
    <a class="bx" href="/accounting/registers/vouchers/export?@ExcelQuery()">Excel</a>
    <a class="bc" href="/accounting/registers/vouchers@(Context.Request.QueryString)">Back to Register</a>
  </div>
</div>
<div id="docList">
@if (Model.Docs is not null)
{
    foreach (var d in Model.Docs)
    {
<div class="doc">
  <partial name="_VoucherDoc" model="d" />
</div>
    }
    if (Model.Docs.Count == 0)
    {
<div class="pa"><p style="text-align:center;color:var(--v2-muted,#7c7c7a)">No vouchers found for this filter.</p></div>
    }
}
</div>

<div class="reg-progress@(Model.Docs is { Count: > 0 } ? "" : " open")" id="regProgress" role="status" aria-live="polite">
  <div class="reg-progress-card">
    <div class="reg-progress-head">
      <div>
        <h3>Loading vouchers…</h3>
        <p id="regProgressNote">Preparing full voucher pages</p>
      </div>
      <div class="reg-pct" id="regPct">0%</div>
    </div>
    <div class="reg-bar"><div id="regBarFill"></div></div>
    <div class="reg-progress-foot">
      <button type="button" class="bx" id="regCancel">Cancel loading</button>
      <span class="s">Back and Excel stay available.</span>
    </div>
  </div>
</div>

<script>
(function(){
  var overlay=document.getElementById('regProgress'),
      fill=document.getElementById('regBarFill'),
      pct=document.getElementById('regPct'),
      note=document.getElementById('regProgressNote'),
      status=document.getElementById('docStatus'),
      list=document.getElementById('docList'),
      count=document.getElementById('docCount'),
      printBtn=document.getElementById('printAllBtn'),
      controller=null, cancelled=false;
  var FIRST_LIMIT=20, CHUNK_LIMIT=100;
  function setProgress(done,total){
    var p=total>0?Math.min(100,Math.round(done/total*100)):0;
    fill.style.width=p+'%';pct.textContent=p+'%';
    note.textContent='Loading vouchers… '+done+' of '+total;
  }
  function setPrintState(loaded){
    printBtn.disabled=loaded<=0;
    printBtn.title=loaded<=0?'No vouchers loaded yet'
      :(cancelled?'Print the vouchers loaded so far':'Print all loaded vouchers');
  }
  function appendDocs(docs){
    if(!docs||!docs.length)return;
    var frag=document.createDocumentFragment();
    docs.forEach(function(html){
      var w=document.createElement('div');w.className='doc';w.innerHTML=html;
      frag.appendChild(w);
    });
    list.appendChild(frag);
  }
  document.getElementById('regCancel').addEventListener('click',function(){
    if(cancelled)return;
    cancelled=true;
    note.textContent='Stopping…';
    if(controller){try{controller.abort();}catch(e){}}
  });
  @if (Model.Docs is not null) { @:return; // server-rendered fallback (view=1, no JS needed)
  }
  var params=new URLSearchParams(window.location.search);
  ['total','limit','offset','full'].forEach(function(k){params.delete(k);});
  controller=new AbortController();
  document.body.setAttribute('data-docs','loading');
  overlay.classList.add('open');setProgress(0,0);setPrintState(0);
  var got=0,total=0,totalParam='',hadError=false;
  (async function(){
    try{
      var offset=0, limit=FIRST_LIMIT;
      while(true){
        if(cancelled)break;
        var url="/accounting/registers/vouchers/data?full=1&"
          +params.toString()+'&limit='+limit+'&offset='+offset+totalParam;
        var resp=await fetch(url,{signal:controller.signal,headers:{'Accept':'application/json'}});
        if(!resp.ok)throw new Error('Server returned '+resp.status);
        var data=await resp.json();
        if(offset===0){
          total=data.total||0;count.textContent=total;list.innerHTML='';
          totalParam='&total='+encodeURIComponent(total);
          if(!total)list.innerHTML='<div class="pa"><p style="text-align:center;color:var(--v2-muted,#7c7c7a)">No vouchers found for this filter.</p></div>';
        }
        appendDocs(data.docs||[]);
        got+=data.rows||0;setProgress(got,total);
        if(!total||(data.rows||0)<limit||got>=total)break;
        offset+=limit;
        limit=CHUNK_LIMIT;
      }
    }catch(e){
      if(!cancelled)hadError=true;
    }finally{
      overlay.classList.remove('open');controller=null;
      if(!hadError&&total>0&&got>=total){
        document.body.setAttribute('data-docs','done');status.textContent='';
      }else if(cancelled){
        document.body.setAttribute('data-docs','cancelled');
        status.textContent='Loading stopped. '+got+' of '+total+' vouchers loaded.';
      }else if(hadError){
        document.body.setAttribute('data-docs','error');
        status.textContent='Could not load all vouchers. '+got+' of '+total+' loaded.';
      }else{
        document.body.setAttribute('data-docs','done');status.textContent='';
      }
      setPrintState(got);
    }
  })();
})();
</script>
</body>
</html>
