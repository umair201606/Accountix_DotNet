  {"who": "emp", "url": "/workplace/kanban?board=BOARD", "content": "<div class=\"page-header\">\n    <h1>Kanban Task Board</h1>\n    <button class=\"btn btn-primary\" id=\"show-board-form\">+ New Board</button>\n</div>\n<div id=\"board-form\" class=\"hidden mb-20\" style=\"max-width:400px;\">\n    <form id=\"create-board-form\" style=\"display:flex;gap:8px;\">\n        <input type=\"text\" id=\"board-title\" class=\"form-control\" placeholder=\"Board title\" required>\n        <button type=\"submit\" class=\"btn btn-primary btn-sm\">Create</button>\n    </form>\n</div>\n\n\n<div class=\"flex gap-10 mb-20\" style=\"flex-wrap:wrap;\">\n    \n    <a href=\"?board=35\" class=\"btn btn-primary btn-sm\">Launch</a>\n    \n</div>\n\n\n<div class=\"kanban-board\" id=\"kanban-board\" data-board=\"35\">\n    \n    <div class=\"kanban-column\" data-status=\"todo\">\n        <div class=\"kanban-col-header\">To Do</div>\n        <div class=\"kanban-cards\" id=\"col-todo\" ondragover=\"event.preventDefault()\" ondrop=\"dropTask(event, 'todo')\"></div>\n    </div>\n    \n    <div class=\"kanban-column\" data-status=\"in_progress\">\n        <div class=\"kanban-col-header\">In Progress</div>\n        <div class=\"kanban-cards\" id=\"col-in_progress\" ondragover=\"event.preventDefault()\" ondrop=\"dropTask(event, 'in_progress')\"></div>\n    </div>\n    \n    <div class=\"kanban-column\" data-status=\"done\">\n        <div class=\"kanban-col-header\">Done</div>\n        <div class=\"kanban-cards\" id=\"col-done\" ondragover=\"event.preventDefault()\" ondrop=\"dropTask(event, 'done')\"></div>\n    </div>\n    \n</div>\n\n<div style=\"margin-top:10px;\">\n    <button class=\"btn btn-sm btn-outline\" id=\"add-task-btn\">+ Add Task</button>\n</div>\n\n\n\n      </div>\n    "},
