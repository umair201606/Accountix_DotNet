  {"who": "admin", "url": "/reports/", "content": "<div class=\"page-header\">\n    <h1>Reports & Analytics</h1>\n</div>\n\n<div class=\"card mb-20\">\n    <div class=\"card-header\">Ad-Hoc Report Builder</div>\n    <div class=\"report-builder\" style=\"padding:16px;\">\n        <div class=\"form-row\">\n            <div class=\"form-group\">\n                <label>Scope</label>\n                <select id=\"report-scope\" class=\"form-control\">\n                    <option value=\"company\">Company-Wide</option>\n                    <option value=\"department\">Department</option>\n                    <option value=\"individual\">Individual Employee</option>\n                </select>\n            </div>\n            <div class=\"form-group hidden\" id=\"dept-group\">\n                <label>Department</label>\n                <select id=\"report-dept\" class=\"form-control\">\n                    \n                    <option value=\"Finance\">Finance</option>\n                    \n                </select>\n            </div>\n            <div class=\"form-group hidden\" id=\"emp-group\">\n                <label>Employee</label>\n                <select id=\"report-emp\" class=\"form-control\">\n                    \n                    <option value=\"USER_mgr\">Bilal Manager</option>\n                    \n                    <option value=\"USER_emp2\">Sana Employee</option>\n                    \n                    <option value=\"USER_emp\">Kamran Employee</option>\n                    \n                </select>\n            </div>\n        </div>\n        <div class=\"form-row\">\n            <div class=\"form-group\"><label>From</label><input type=\"date\" id=\"report-from\" class=\"form-control\"></div>\n            <div class=\"form-group\"><label>To</label><input type=\"date\" id=\"report-to\" class=\"form-control\"></div>\n        </div>\n        <div class=\"form-group\">\n            <label>Columns</label>\n            <div style=\"display:flex;flex-wrap:wrap;gap:8px;\">\n                \n                \n                <label style=\"font-size:13px;display:flex;align-items:center;gap:4px;background:var(--bg-top);padding:4px 8px;border-radius:4px;\">\n                    <input type=\"checkbox\" class=\"col-check\" value=\"employee\" checked> Employee\n                </label>\n                \n                <label style=\"font-size:13px;display:flex;align-items:center;gap:4px;background:var(--bg-top);padding:4px 8px;border-radius:4px;\">\n                    <input type=\"checkbox\" class=\"col-check\" value=\"total_hours\" checked> Total Hours\n                </label>\n                \n                <label style=\"font-size:13px;display:flex;align-items:center;gap:4px;background:var(--bg-top);padding:4px 8px;border-radius:4px;\">\n                    <input type=\"checkbox\" class=\"col-check\" value=\"overtime\" checked> Overtime\n                </label>\n                \n                <label style=\"font-size:13px;display:flex;align-items:center;gap:4px;background:var(--bg-top);padding:4px 8px;border-radius:4px;\">\n                    <input type=\"checkbox\" class=\"col-check\" value=\"leaves\" checked> Leaves\n                </label>\n                \n                <label style=\"font-size:13px;display:flex;align-items:center;gap:4px;background:var(--bg-top);padding:4px 8px;border-radius:4px;\">\n                    <input type=\"checkbox\" class=\"col-check\" value=\"sick_days\" checked> Sick Days\n                </label>\n                \n                <label style=\"font-size:13px;display:flex;align-items:center;gap:4px;background:var(--bg-top);padding:4px 8px;border-radius:4px;\">\n                    <input type=\"checkbox\" class=\"col-check\" value=\"late_days\" checked> Late Days\n                </label>\n                \n                <label style=\"font-size:13px;display:flex;align-items:center;gap:4px;background:var(--bg-top);padding:4px 8px;border-radius:4px;\">\n                    <input type=\"checkbox\" class=\"col-check\" value=\"present_days\" checked> Days Present\n                </label>\n                \n                <label style=\"font-size:13px;display:flex;align-items:center;gap:4px;background:var(--bg-top);padding:4px 8px;border-radius:4px;\">\n                    <input type=\"checkbox\" class=\"col-check\" value=\"pf_balance\" checked> PF Balance\n                </label>\n                \n                <label style=\"font-size:13px;display:flex;align-items:center;gap:4px;background:var(--bg-top);padding:4px 8px;border-radius:4px;\">\n                    <input type=\"checkbox\" class=\"col-check\" value=\"loan_balance\" checked> Loan Balance\n                </label>\n                \n            </div>\n        </div>\n        <button class=\"btn btn-primary\" id=\"run-report\">&#9654; Generate Report</button>\n        <button class=\"btn btn-accent hidden\" id=\"export-excel\">&#128196; Export to Excel</button>\n    </div>\n</div>\n\n<div class=\"card\">\n    <div class=\"card-header\">\n        <span>Results</span>\n        <span id=\"result-count\" style=\"font-size:12px;color:var(--muted);\"></span>\n    </div>\n    <div class=\"table-wrap\" id=\"report-results\">\n        <p style=\"padding:20px;color:var(--muted);text-align:center;\">Run a report to see results</p>\n    </div>\n</div>\n\n<div class=\"grid-3 mt-20\">\n    <div class=\"card\">\n        <div class=\"card-header\">Attendance Report</div>\n        <p style=\"font-size:13px;color:var(--muted);margin-bottom:14px;\">Download a month's attendance records.</p>\n        <form method=\"GET\" action=\"/reports/export-attendance\">\n            <div class=\"form-row\">\n                <div class=\"form-group\"><label>Month</label>\n                    <select name=\"month\" class=\"form-control\">\n                        <option value=\"1\" >Jan</option><option value=\"2\" >Feb</option><option value=\"3\" >Mar</option><option value=\"4\" >Apr</option><option value=\"5\" >May</option><option value=\"6\" >Jun</option><option value=\"7\" >Jul</option><option value=\"8\" >Aug</option><option value=\"9\" >Sep</option><option value=\"10\" selected>Oct</option><option value=\"11\" >Nov</option><option value=\"12\" >Dec</option>\n                    </select>\n                </div>\n                <div class=\"form-group\"><label>Year</label>\n                    <select name=\"year\" class=\"form-control\">\n                        <option value=\"2022\" >2022</option><option value=\"2023\" >2023</option><option value=\"2024\" >2024</option><option value=\"2025\" >2025</option><option value=\"2026\" selected>2026</option><option value=\"2027\" >2027</option>\n                    </select>\n                </div>\n            </div>\n            <div class=\"export-group\">\n                <button type=\"submit\" name=\"format\" value=\"excel\" class=\"btn btn-outline btn-sm\">Excel</button>\n                <button type=\"submit\" name=\"format\" value=\"pdf\" class=\"btn btn-outline btn-sm\">PDF</button>\n                <button type=\"submit\" name=\"format\" value=\"csv\" class=\"btn btn-outline btn-sm\">CSV</button>\n            </div>\n        </form>\n    </div>\n    <div class=\"card\">\n        <div class=\"card-header\">Leave Report</div>\n        <p style=\"font-size:13px;color:var(--muted);margin-bottom:14px;\">Download a year's leave requests.</p>\n        <form method=\"GET\" action=\"/reports/export-leaves\">\n            <div class=\"form-group\"><label>Year</label>\n                <select name=\"year\" class=\"form-control\">\n                    <option value=\"2022\" >2022</option><option value=\"2023\" >2023</option><option value=\"2024\" >2024</option><option value=\"2025\" >2025</option><option value=\"2026\" selected>2026</option><option value=\"2027\" >2027</option>\n                </select>\n            </div>\n            <div class=\"export-group\">\n                <button type=\"submit\" name=\"format\" value=\"excel\" class=\"btn btn-outline btn-sm\">Excel</button>\n                <button type=\"submit\" name=\"format\" value=\"pdf\" class=\"btn btn-outline btn-sm\">PDF</button>\n                <button type=\"submit\" name=\"format\" value=\"csv\" class=\"btn btn-outline btn-sm\">CSV</button>\n            </div>\n        </form>\n    </div>\n    <div class=\"card\">\n        <div class=\"card-header\">Dashboard Analytics</div>\n        <p style=\"font-size:13px;color:var(--muted);margin-bottom:14px;\">View attendance trends and metrics.</p>\n        <a href=\"/dashboard\" class=\"btn btn-outline\">View Dashboard</a>\n    </div>\n</div>\n\n<div class=\"card mt-20\">\n    <div class=\"card-header\">Monthly Attendance Overview</div>\n    <div style=\"height:250px;display:flex;align-items:flex-end;gap:8px;padding:16px 0;\" id=\"chart-container\"></div>\n</div>\n\n      </div>\n    "},
