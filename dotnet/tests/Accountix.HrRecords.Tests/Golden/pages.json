  {"who": "admin", "url": "/communications/", "content": "<div class=\"page-header\">\n    <h1>Communications</h1>\n    <div>\n        <button class=\"btn btn-primary\" id=\"show-send-notif\">Send Notification</button>\n        <button class=\"btn btn-outline\" id=\"show-send-email\">Log Email</button>\n    </div>\n</div>\n\n<div id=\"send-notif-form\" class=\"card hidden mb-20\" style=\"max-width:500px;\">\n    <form method=\"POST\" action=\"/communications/send-notification\">\n        <div class=\"form-group\"><label>Title *</label><input name=\"title\" class=\"form-control\" required></div>\n        <div class=\"form-group\"><label>Message *</label><textarea name=\"message\" class=\"form-control form-textarea\" required></textarea></div>\n        <div class=\"form-group\"><label>Type</label>\n            <select name=\"type\" class=\"form-control\">\n                <option value=\"info\">Info</option>\n                <option value=\"warning\">Warning</option>\n                <option value=\"success\">Success</option>\n                <option value=\"danger\">Alert</option>\n            </select>\n        </div>\n        <div class=\"form-group\"><label>Send To</label>\n            <select name=\"target\" class=\"form-control\" id=\"notif-target\">\n                <option value=\"all\">All Employees</option>\n                <option value=\"role\">By Role</option>\n            </select>\n        </div>\n        <div class=\"form-group hidden\" id=\"role-group\">\n            <label>Role</label>\n            <select name=\"role\" class=\"form-control\">\n                <option value=\"manager\">Managers</option>\n                <option value=\"employee\">Employees</option>\n            </select>\n        </div>\n        <button type=\"submit\" class=\"btn btn-primary\">Send</button>\n    </form>\n</div>\n\n<div id=\"send-email-form\" class=\"card hidden mb-20\" style=\"max-width:500px;\">\n    <form method=\"POST\" action=\"/communications/send-email\">\n   