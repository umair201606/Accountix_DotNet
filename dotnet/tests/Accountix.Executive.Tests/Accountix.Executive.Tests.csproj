<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Finance renders the export files. While Finance is mid-edit and does not compile, build with
       -p:NoFinance=true: the export tests drop out and every other test still builds and runs. -->
  <PropertyGroup Condition="'$(NoFinance)' != 'true'">
    <DefineConstants>$(DefineConstants);WITH_FINANCE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(NoFinance)' != 'true'">
    <ProjectReference Include="..\..\src\Modules\Accountix.Finance\Accountix.Finance.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(NoFinance)' == 'true'">
    <Compile Remove="ExportTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\Accountix.Executive\Accountix.Executive.csproj" />
    <!-- Accounting posts the vouchers of the race tests and the golden company's seed; Inventory its opening stock. -->
    <ProjectReference Include="..\..\src\Modules\Accountix.Accounting\Accountix.Accounting.csproj" />
    <ProjectReference Include="..\..\src\Modules\Accountix.Inventory\Accountix.Inventory.csproj" />
    <ProjectReference Include="..\Accountix.TestSupport\Accountix.TestSupport.csproj" />
    <!-- CompanySetup: the golden tests' own companies are provisioned as the portal provisions one. -->
    <ProjectReference Include="..\..\src\Modules\Accountix.Platform\Accountix.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fixed expectations captured from the Python app (Golden/capture/*.py). -->
    <None Include="Golden\*.json;Golden\*.xlsx;Golden\*.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
